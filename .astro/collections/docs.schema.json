{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "metaTitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "canonical": {
      "type": "string",
      "format": "uri"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string"
    },
    "tldr": {
      "type": "string"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "canonical"
  ]
}