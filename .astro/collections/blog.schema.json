{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "canonical": {
      "type": "string",
      "format": "uri"
    },
    "pubDate": {
      "type": "string"
    },
    "updatedDate": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "readingTime": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "string"
    },
    "draft": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "canonical",
    "pubDate",
    "slug"
  ]
}