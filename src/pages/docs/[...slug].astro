---
/**
 * Docs article dynamic page — /docs/<id>/
 *
 * REPORT-12: Visual refresh — uses canonical DocsLayout with the article
 * hero, TLDR card, prose styling, TOC sidebar, helpful widget, prev/next
 * footer, demo CTA. Content is read verbatim from src/content/docs/*.md
 * (frontmatter + markdown body).
 *
 * Content Preservation Rule:
 *   Markdown bodies in src/content/docs/*.md are never modified by the
 *   page. We only adapt their visual surface.
 */
import { getCollection, render } from 'astro:content';
import * as cheerio from 'cheerio';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const byId = new Map(docs.map((doc) => [doc.id, doc]));

  return docs.map((doc, index) => {
    const prev = index > 0 ? docs[index - 1] : null;
    const next = index < docs.length - 1 ? docs[index + 1] : null;

    return {
      params: { slug: doc.id },
      props: {
        doc,
        relatedDocs: (doc.data.related ?? [])
          .map((id) => byId.get(id))
          .filter((entry): entry is typeof doc => Boolean(entry))
          .map((entry) => ({
            slug: entry.id,
            title: entry.data.title,
            description: entry.data.description,
          })),
        prevDoc: prev && prev.id !== doc.id
          ? { slug: prev.id, title: prev.data.title }
          : null,
        nextDoc: next && next.id !== doc.id
          ? { slug: next.id, title: next.data.title }
          : null,
      },
    };
  });
}

const { doc, relatedDocs, prevDoc, nextDoc } = Astro.props;
const { Content } = await render(doc);
const $ = cheerio.load(doc.body, null, false);
const headings = $('h2, h3').map((_, element) => ({
  depth: Number(element.tagName.slice(1)) as 2 | 3,
  slug: $(element).attr('id') ?? '',
  text: $(element).text().trim().replace(/\s+/g, ' '),
})).get().filter((heading) => heading.slug && heading.text);
---

<DocsLayout
  title={doc.data.title}
  metaTitle={doc.data.metaTitle}
  description={doc.data.description}
  canonical={doc.data.canonical}
  updated={doc.data.updated}
  category={doc.data.category}
  tldr={doc.data.tldr}
  headings={headings}
  relatedDocs={relatedDocs}
  prevDoc={prevDoc}
  nextDoc={nextDoc}
  currentPath={`/docs/${doc.id}/`}
>
  <Content />
</DocsLayout>
