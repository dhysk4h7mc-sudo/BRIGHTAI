---
import { getCollection, render } from 'astro:content';
import * as cheerio from 'cheerio';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const byId = new Map(docs.map((doc) => [doc.id, doc]));

  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: {
      doc,
      relatedDocs: doc.data.related
        .map((id) => byId.get(id))
        .filter((entry): entry is typeof doc => Boolean(entry))
        .map((entry) => ({
          slug: entry.id,
          title: entry.data.title,
          description: entry.data.description,
        })),
    },
  }));
}

const { doc, relatedDocs } = Astro.props;
const { Content } = await render(doc);
const $ = cheerio.load(doc.body, null, false);
const headings = $('h2, h3').map((_, element) => ({
  depth: Number(element.tagName.slice(1)) as 2 | 3,
  slug: $(element).attr('id') ?? '',
  text: $(element).text().trim().replace(/\s+/g, ' '),
})).get().filter((heading) => heading.slug && heading.text);
---

<DocsLayout
  title={doc.data.title}
  metaTitle={doc.data.metaTitle}
  description={doc.data.description}
  canonical={doc.data.canonical}
  updated={doc.data.updated}
  category={doc.data.category}
  tldr={doc.data.tldr}
  headings={headings}
  relatedDocs={relatedDocs}
  currentPath={`/docs/${doc.id}/`}
>
  <Content />
</DocsLayout>
