---
import { getCollection } from 'astro:content';
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const docs = await getCollection('docs');
const title = 'مركز وثائق حوكمة الذكاء الاصطناعي الشامل | Saudi AI Safety OS';
const description = 'مرجع شامل لحوكمة وأمان الذكاء الاصطناعي في السعودية: 27+ وثيقة تغطي PDPL، NCA ECC، إرشادات سدايا، إدارة المخاطر، التدقيق، والتطبيق التقني - دليلك الكامل لتشغيل AI بأمان.';
const canonical = 'https://brightai.site/docs/';

const sections = [
  {
    id: 'solutions',
    title: '🏛️ المحور الأول: وثائق الحلول الأساسية',
    intro: 'الحلول الأساسية التي تشكل نظام Saudi AI Safety OS - من الحوكمة إلى الحماية والتدقيق. كل حل يحل مشكلة محددة في رحلة حوكمة AI.',
    cards: [
      ['ai-governance-platform', 'AI Governance Platform', 'منصة شاملة لتشغيل الحوكمة، تصنيف المخاطر، وربط السياسات بضوابط قابلة للتدقيق. المحور المركزي لإدارة AI.'],
      ['ai-firewall', 'AI Firewall', 'جدار ناري ذكي لحماية البيانات الحساسة وتنقيتها قبل وصولها إلى نماذج الذكاء الاصطناعي. حماية استباقية للبيانات.'],
      ['ai-audit-trail', 'AI Audit Trail', 'سجل تدقيق شامل يوثق كل طلب وقرار وموافقة في نظام مركزي قابل للمراجعة والتصدير. الأساس لإثبات الامتثال.'],
      ['human-approval-layer', 'Human Approval Layer', 'طبقة موافقات بشرية تصعد القرارات الحساسة للمراجعة حسب السياسات ومستوى المخاطر. ضمان الرقابة البشرية.'],
      ['ai-evidence-file', 'AI Evidence File', 'نظام تجميع الأدلة التشغيلية لدعم جاهزية التدقيق والمراجعة الداخلية والخارجية. ملف الأدلة الجاهز.'],
    ],
  },
  {
    id: 'kernel',
    title: '⚙️ المحور الثاني: وثائق BrightAI Kernel التقنية',
    intro: 'دليل تقني شامل للمطورين والمهندسين لتطبيق وتكامل مكونات BrightAI Kernel. من المفهوم إلى الكود الفعلي.',
    cards: [
      ['kernel-chat', 'Kernel Chat - المحادثة الآمنة', 'واجهة محادثة ذكية تحمي بيانات شركتك، تصنف المخاطر، وتوثق كل قرار قبل الوصول للنموذج. نقطة البداية التقنية.'],
      ['kernel-audit-trail', 'Kernel Audit Trail - سجل التدقيق', 'كل طلب، كل قرار، كل موافقة - موثقة بالتفصيل في سجل محمي ضد التعديل والتلاعب. التطبيق التقني لسجل التدقيق.'],
      ['kernel-approvals', 'Kernel Approvals - الموافقات البشرية', 'نظام موافقات ذكي يصعد الطلبات الحساسة للمراجعة البشرية قبل التنفيذ. تطبيق طبقة الموافقات تقنياً.'],
      ['kernel-evidence', 'Kernel Evidence - ملفات الأدلة', 'كل طلب يصير له ملف دليل شامل - جاهز للتصدير والمراجعة والتدقيق الداخلي والخارجي. توليد الأدلة تلقائياً.'],
      ['kernel-stats', 'Kernel Stats - لوحة الإحصائيات', 'تابع مؤشرات استخدام AI، المخاطر، الموافقات، والأقسام في لوحة واحدة واضحة وشاملة. رؤية شاملة للحوكمة.'],
      ['kernel-reports', 'Kernel Reports - التقارير', 'حوّل بيانات الحوكمة إلى تقارير واضحة جاهزة للإدارة العليا والتدقيق والامتثال. من البيانات إلى القرارات.'],
      ['kernel-policies', 'Kernel Policies - محرر السياسات', 'أنشئ وعدّل سياسات AI بشكل بصري واربطها بالضوابط والموافقات والإجراءات. إدارة السياسات بصرياً.'],
      ['kernel-compliance', 'Kernel Compliance - حزم الامتثال', 'تابع حالة الامتثال لـ PDPL وNCA ECC وISO 27001 في لوحة واحدة موحدة. مراقبة الامتثال المستمرة.'],
      ['kernel-connectors', 'Kernel Connectors - الموصلات', 'اربط Kernel بأنظمة العمل ومصادر البيانات بشكل آمن ومنظم وقابل للتدقيق. التكامل مع الأنظمة الموجودة.'],
      ['kernel-scenarios', 'Kernel Scenarios - السيناريوهات', 'اختبر سياسات AI والضوابط بسيناريوهات جاهزة قبل التطبيق الفعلي في البيئة الإنتاجية. اختبر قبل التطبيق.'],
    ],
  },
  {
    id: 'compliance',
    title: '📋 المحور الثالث: أدلة الامتثال والمعايير',
    intro: 'أدلة عملية للمواءمة مع المعايير السعودية والدولية. كل دليل يربط المتطلبات التنظيمية بالتطبيق العملي.',
    cards: [
      ['pdpl-ai-governance', 'PDPL والذكاء الاصطناعي', 'دليل شامل لإدارة الخصوصية والبيانات الشخصية داخل استخدامات الذكاء الاصطناعي وفق نظام حماية البيانات الشخصية السعودي.'],
      ['pdpl-chatgpt-data-protection', 'ChatGPT والبيانات الشخصية في السعودية', 'دليل عملي لاستخدام AI بدون تسريب بيانات شخصية أو حساسة - خطوات تطبيقية واضحة لحماية البيانات.'],
      ['pdpl-ai-complete-guide', 'الدليل الشامل لتطبيق PDPL مع الذكاء الاصطناعي', 'مرجع عميق لتطبيق امتثال PDPL للذكاء الاصطناعي وحماية البيانات الشخصية في AI مع جداول وخطة 90 يوم.'],
      ['nca-ecc-ai-governance', 'NCA ECC وحوكمة AI', 'ضوابط تشغيلية تساعد فرق الأمن السيبراني والتدقيق على المواءمة مع الضوابط الأساسية للأمن السيبراني.'],
      ['nca-ecc-ai-controls-mapping', 'مواءمة استخدام الذكاء الاصطناعي مع NCA ECC', 'جدول تنفيذي يربط مخاطر AI بضوابط Saudi AI Safety OS القابلة للمراجعة أمنيًا - خريطة الامتثال الكاملة.'],
      ['nca-ecc-ai-controls', 'ضوابط الذكاء الاصطناعي وفق NCA ECC', 'سجل تدقيق، تصنيف البيانات، وتفعيل الموافقات البشرية للامتثال الكامل مع الضوابط الأساسية.'],
      ['nca-ecc-ai-guide', 'ضوابط NCA ECC 2-2024 للذكاء الاصطناعي', 'دليل تطبيق عملي يربط NCA ECC AI controls ببوابة AI، الموردين، السحابة، السجلات، ومركز العمليات الأمنية.'],
      ['sdaia-generative-ai-guidelines', 'إرشادات سدايا للذكاء الاصطناعي التوليدي', 'شرح عملي لإرشادات سدايا للاستخدام المسؤول للذكاء الاصطناعي التوليدي مع سياسة يومية وتصنيف استخدامات.'],
    ],
  },
  {
    id: 'implementation',
    title: '🚀 المحور الرابع: أدلة تنفيذية وإدارة المخاطر',
    intro: 'خطوات عملية لتطبيق الحوكمة وإدارة المخاطر وتحقيق الجاهزية للتدقيق. من الاستراتيجية إلى التنفيذ.',
    cards: [
      ['ai-governance-saudi-arabia', 'حوكمة الذكاء الاصطناعي في السعودية', 'دليل تنفيذي شامل لتحويل سياسات AI إلى ضوابط قابلة للتدقيق والمراجعة والتطبيق. نقطة البداية الاستراتيجية.'],
      ['ai-risk-management', 'إدارة مخاطر الذكاء الاصطناعي', 'إطار عملي لتصنيف المخاطر وتشغيل الضوابط والموافقات حسب مستوى الخطورة. من التقييم إلى التخفيف.'],
      ['governance-application', 'تطبيق حوكمة الذكاء الاصطناعي خلال 30 يوم', 'خطة عملية شاملة للشركات السعودية لحصر وتصنيف وحماية استخدامات AI خلال 4 أسابيع. خارطة طريق التنفيذ.'],
      ['ai-audit-readiness', 'جاهزية تدقيق الذكاء الاصطناعي', 'كيف تثبت السيطرة والجاهزية بالأدلة والسجلات - دليل عملي للتحضير للتدقيق الداخلي والخارجي.'],
    ],
  },
  {
    id: 'advanced-kernel',
    title: '🛠️ المحور الخامس: أدلة كيرنل المتقدمة وموارد المطورين',
    intro: 'أدلة تقنية متقدمة وموارد متخصصة للمطورين والمهندسين لتخصيص وإعداد BrightAI Kernel أمنياً وتشغيلياً وثائقياً.',
    cards: [
      ['kernel-api-client', 'عميل الـ API لكيرنل', 'كيفية التكامل برمجياً مع واجهات برمجة تطبيقات كيرنل وإجراء طلبات آمنة.'],
      ['kernel-audit-evidence', 'أدلة تدقيق الكيرنل', 'تفاصيل هيكل أدلة الامتثال والتحقق الفني من نزاهة السجلات.'],
      ['kernel-nvidia-proxy', 'بروكسي نفيديا لكيرنل', 'إعداد وإدارة بروكسي NVIDIA لتنقية المدخلات والمخرجات على مستوى العتاد.'],
      ['kernel-accessibility-mobile', 'سهولة الوصول للهاتف', 'تحسين توافق واجهات كيرنل مع معايير الوصول على الهواتف والأجهزة المحمولة.'],
      ['kernel-production-vs-demo', 'الإنتاجي مقابل التجريبي', 'الفروقات الإعدادية بين بيئة التطوير التجريبية وبيئة التشغيل الإنتاجية.'],
      ['kernel-changelog-template', 'نموذج سجل التغييرات', 'هيكل تتبع وتوثيق تحديثات كيرنل والامتثال التراكمي.'],
      ['kernel-internal-linking', 'دليل الربط الداخلي', 'إرشادات المحافظة على ترابط مكونات النظام والتوثيق لمنع الصفحات اليتيمة.'],
      ['superpowers', 'موارد المطورين الخارقة', 'مجموعة أدوات ومقاييس التطوير السريع وحل المشكلات داخل بيئة BrightAI.'],
    ],
  },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: 'وثائق Saudi AI Safety OS لحوكمة وأمان الذكاء الاصطناعي',
      description: 'مركز وثائق Saudi AI Safety OS لحوكمة وأمان الذكاء الاصطناعي، يشمل وثائق الحلول وأدلة إدارة المخاطر والخصوصية وجاهزية التدقيق.',
      inLanguage: 'ar-SA',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://brightai.site/' },
        { '@type': 'ListItem', position: 2, name: 'الوثائق', item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      itemListElement: docs.map((doc, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: doc.data.title,
        url: doc.data.canonical,
      })),
    },
  ],
};
---

<ArabicLayout
  title={title}
  description={description}
  canonical={canonical}
  hreflang={[{ lang: 'ar-SA', href: canonical }]}
  jsonLd={jsonLd}
  currentPath="/docs/"
>
  <style>
    .docs-index {
      width: min(100% - 2rem, 75rem);
      margin-inline: auto;
      padding-block: var(--space-8) var(--space-20);
    }
    .docs-index__hero {
      max-width: 58rem;
      padding-block: var(--space-8) var(--space-12);
    }
    .docs-index__eyebrow {
      color: var(--brand);
      font-weight: var(--weight-extrabold);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
    }
    .docs-index h1 {
      margin: .75rem 0 1rem;
      color: var(--text);
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: var(--leading-tight);
    }
    .docs-index h2 {
      margin-block: var(--space-12) var(--space-4);
      color: var(--text);
      font-size: clamp(1.4rem, 3vw, 2rem);
      line-height: var(--leading-snug);
    }
    .docs-index h3 {
      color: var(--text);
      font-size: 1.05rem;
      line-height: 1.55;
    }
    .docs-index p, .docs-index li {
      color: var(--text-soft);
      line-height: var(--leading-loose);
    }
    .docs-index a {
      color: var(--brand-hover);
      text-underline-offset: 0.2em;
    }
    .docs-index__intro {
      font-size: var(--text-lg);
      max-width: 52rem;
    }
    .docs-index__panel {
      padding: var(--space-6);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-2xl);
      background: var(--gradient-surface);
    }
    .docs-index__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
      margin-block: var(--space-4);
    }
    .docs-index__card {
      display: block;
      padding: var(--space-5);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      color: inherit;
      text-decoration: none;
      background: var(--gradient-surface);
      transition: border-color var(--duration-normal) var(--ease-out),
                  transform var(--duration-normal) var(--ease-out);
    }
    .docs-index__card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
    }
    .docs-index__card h3 {
      margin-block: 0 var(--space-2);
    }
    .docs-index__card p {
      margin-block: 0 var(--space-2);
      font-size: var(--text-sm);
    }
    .docs-index__cluster {
      margin-block: var(--space-5);
      padding: var(--space-4) var(--space-5);
      border: 1px solid var(--glass-border);
      border-inline-start: 3px solid var(--brand-hover);
      border-radius: var(--radius-xl);
      background: var(--brand-subtle);
    }
    .docs-index__cluster h3 {
      margin-block: 0 var(--space-2);
    }
    .docs-index__cluster p {
      margin: 0;
      font-size: var(--text-sm);
    }
    .docs-index__faq h3 {
      margin-block: var(--space-6) var(--space-2);
    }
    .docs-index__faq p, .docs-index__faq li {
      font-size: var(--text-sm);
    }
    @media (max-width: 900px) {
      .docs-index__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 600px) {
      .docs-index { width: min(100% - 1.25rem, 75rem); }
      .docs-index__grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .docs-index__card { transition: none; }
      .docs-index__card:hover { transform: none; }
    }
  </style>

  <main class="docs-index">
    <div class="article-breadcrumbs">
      <Breadcrumbs crumbs={[{ label: 'الرئيسية', href: '/' }, { label: 'الوثائق' }]} />
    </div>

    <header class="docs-index__hero">
      <p class="docs-index__eyebrow">27 وثيقة عملية</p>
      <h1>وثائق تخدم تطبيقك لحوكمة الذكاء الاصطناعي</h1>
      <p class="docs-index__intro">المرجع العربي الشامل لحوكمة وأمان AI في السعودية — أكثر من ٢٧ وثيقة تغطي الحوكمة، الامتثال، إدارة المخاطر، والتطبيق التقني. من السياسة إلى الكود، كله هنا.</p>
    </header>

    <section class="docs-index__panel">
      <h2>🎯 لماذا مركز الوثائق هذا؟</h2>
      <p>Saudi AI Safety OS يقدم مرجعاً عربياً عملياً لحوكمة الذكاء الاصطناعي في السعودية. هذا المركز يجمع:</p>
      <div class="docs-index__grid">
        <article><h3>📚 تغطية شاملة لكل جوانب حوكمة AI</h3><p>من السياسات إلى التطبيق التقني - 27 وثيقة مترابطة تغطي الحوكمة، الامتثال، المخاطر، التدقيق، والتطبيق</p></article>
        <article><h3>🇸🇦 مصمم للسياق السعودي</h3><p>مواءمة كاملة مع <a href="/docs/pdpl-ai-governance/">PDPL</a>، <a href="/docs/nca-ecc-ai-governance/">NCA ECC</a>، ومتطلبات الجهات التنظيمية السعودية</p></article>
        <article><h3>⚙️ من النظرية إلى التطبيق</h3><p>كل وثيقة تربط المفهوم بالتطبيق العملي - من <a href="/docs/ai-governance-saudi-arabia/">دليل الحوكمة</a> إلى <a href="/docs/kernel-chat/">التطبيق التقني</a></p></article>
      </div>
      <p>الجمهور المستهدف: مدراء المخاطر، مسؤولو الامتثال، فرق الأمن السيبراني، مسؤولو حماية البيانات، المطورون، والمهندسون في الشركات السعودية.</p>
    </section>

    {sections.map((section) => (
      <section aria-labelledby={`docs-${section.id}`}>
        <h2 id={`docs-${section.id}`}>{section.title}</h2>
        <p>{section.intro}</p>
        <div class="docs-index__grid">
          {section.cards.map(([slug, cardTitle, cardDescription]) => (
            <a class="docs-index__card" href={`/docs/${slug}/`}>
              <h3>{cardTitle}</h3>
              <p>{cardDescription}</p>
            </a>
          ))}
        </div>
        {section.id === 'solutions' && <p>الربط الموضوعي: هذه الحلول تعمل معاً كمنظومة متكاملة - <a href="/docs/ai-governance-platform/">المنصة</a> تدير السياسات، <a href="/docs/ai-firewall/">الجدار الناري</a> يحمي البيانات، <a href="/docs/ai-audit-trail/">سجل التدقيق</a> يوثق كل شيء، <a href="/docs/human-approval-layer/">طبقة الموافقات</a> تضمن الرقابة، و<a href="/docs/ai-evidence-file/">ملف الأدلة</a> يجمع كل شيء للتدقيق.</p>}
        {section.id === 'kernel' && <p>مسار التطبيق التقني: ابدأ بـ <a href="/docs/kernel-chat/">Kernel Chat</a> للواجهة، ثم <a href="/docs/kernel-audit-trail/">سجل التدقيق</a> للتوثيق، <a href="/docs/kernel-approvals/">الموافقات</a> للرقابة، <a href="/docs/kernel-policies/">السياسات</a> للإدارة، و<a href="/docs/kernel-compliance/">الامتثال</a> للمراقبة المستمرة.</p>}
        {section.id === 'compliance' && <p>مسار الامتثال: ابدأ بفهم <a href="/docs/pdpl-ai-complete-guide/">متطلبات PDPL العميقة</a> و<a href="/docs/nca-ecc-ai-guide/">NCA ECC 2-2024 للذكاء الاصطناعي</a>، ثم راجع <a href="/docs/sdaia-generative-ai-guidelines/">إرشادات سدايا للاستخدام المسؤول</a>، واستخدم <a href="/docs/nca-ecc-ai-controls-mapping/">خريطة المواءمة</a> لربط المتطلبات بالضوابط.</p>}
        {section.id === 'implementation' && <p>مسار التنفيذ: ابدأ بـ <a href="/docs/ai-governance-saudi-arabia/">فهم الحوكمة</a>، ثم <a href="/docs/ai-risk-management/">صنّف المخاطر</a>، طبّق <a href="/docs/governance-application/">خطة 30 يوم</a>، وحضّر <a href="/docs/ai-audit-readiness/">جاهزية التدقيق</a>.</p>}
        {section.id === 'advanced-kernel' && <p>الربط التقني المتقدم: للتكامل الفني، راجع <a href="/docs/kernel-api-client/">عميل الـ API لكيرنل</a> و <a href="/docs/kernel-nvidia-proxy/">بروكسي نفيديا لكيرنل</a>، وللإدارة والوصول راجع <a href="/docs/kernel-accessibility-mobile/">سهولة الوصول للهاتف</a> و <a href="/docs/superpowers/">أدوات المطورين الخارقة</a>.</p>}
      </section>
    ))}

    <section>
      <h2>🗺️ خريطة المحتوى: كيف ترتبط الوثائق؟</h2>
      <p>الوثائق ليست منفصلة - كل وثيقة تكمل الأخرى في منظومة متكاملة:</p>
      <div class="docs-index__cluster"><h3>المسار الاستراتيجي (للإدارة العليا ومدراء المخاطر)</h3><p><a href="/docs/ai-governance-saudi-arabia/">حوكمة AI في السعودية</a> → <a href="/docs/ai-risk-management/">إدارة المخاطر</a> → <a href="/docs/governance-application/">خطة 30 يوم</a> → <a href="/docs/ai-audit-readiness/">جاهزية التدقيق</a></p></div>
      <div class="docs-index__cluster"><h3>مسار الامتثال (لمسؤولي الامتثال وحماية البيانات)</h3><p><a href="/docs/pdpl-ai-governance/">PDPL والذكاء الاصطناعي</a> → <a href="/docs/nca-ecc-ai-governance/">NCA ECC وحوكمة AI</a> → <a href="/docs/nca-ecc-ai-controls-mapping/">خريطة المواءمة</a> → <a href="/docs/ai-evidence-file/">ملف الأدلة</a></p></div>
      <div class="docs-index__cluster"><h3>المسار التقني (للمطورين والمهندسين)</h3><p><a href="/docs/kernel-chat/">Kernel Chat</a> → <a href="/docs/kernel-audit-trail/">سجل التدقيق</a> → <a href="/docs/kernel-approvals/">الموافقات</a> → <a href="/docs/kernel-policies/">السياسات</a> → <a href="/docs/kernel-compliance/">الامتثال</a></p></div>
      <div class="docs-index__cluster"><h3>المسار التقني المتقدم (للتطوير والتهيئة المتقدمة)</h3><p><a href="/docs/kernel-api-client/">عميل الـ API لكيرنل</a> → <a href="/docs/kernel-audit-evidence/">أدلة تدقيق الكيرنل</a> → <a href="/docs/kernel-nvidia-proxy/">بروكسي نفيديا</a> → <a href="/docs/kernel-production-vs-demo/">البيئة الإنتاجية مقابل الديمو</a></p></div>
      <div class="docs-index__cluster"><h3>مسار الحماية (لفرق الأمن السيبراني)</h3><p><a href="/docs/ai-firewall/">AI Firewall</a> → <a href="/docs/pdpl-chatgpt-data-protection/">حماية البيانات</a> → <a href="/docs/nca-ecc-ai-controls/">ضوابط NCA ECC</a> → <a href="/docs/ai-audit-trail/">سجل التدقيق</a></p></div>
    </section>

    <section class="docs-index__faq">
      <h2>❓ الأسئلة الشائعة</h2>
      <h3>من يستفيد من هذه الوثائق؟</h3>
      <p>مدراء المخاطر، مسؤولو الامتثال، فرق الأمن السيبراني، مسؤولو حماية البيانات، المطورون، والمهندسون في الشركات السعودية التي تستخدم أو تخطط لاستخدام الذكاء الاصطناعي.</p>
      <h3>هل هذه الوثائق بديلة للاستشارة القانونية؟</h3>
      <p>لا. هي أدلة معرفية وتشغيلية تساعد على بناء الضوابط وتجهيز النقاش مع فرق الامتثال والمستشارين القانونيين. يجب دائماً مراجعة المستشار القانوني للتأكد من الامتثال الكامل.</p>
      <h3>من أين أبدأ؟</h3>
      <p>حسب دورك:</p>
      <ul>
        <li>مدير مخاطر/امتثال: <a href="/docs/governance-application/">دليل تطبيق الحوكمة خلال 30 يوم</a></li>
        <li>مسؤول أمن سيبراني: <a href="/docs/nca-ecc-ai-governance/">NCA ECC وحوكمة AI</a></li>
        <li>مسؤول حماية بيانات: <a href="/docs/pdpl-ai-governance/">PDPL والذكاء الاصطناعي</a></li>
        <li>مطور/مهندس: <a href="/docs/kernel-chat/">Kernel Chat</a></li>
      </ul>
      <h3>كيف تختلف هذه الوثائق عن الموارد الأخرى؟</h3>
      <p>هذه الوثائق مصممة خصيصاً للسياق السعودي، مع تغطية شاملة من الاستراتيجية إلى التطبيق التقني، وربط واضح بين المتطلبات التنظيمية والحلول العملية. كل وثيقة تكمل الأخرى في منظومة متكاملة.</p>
      <h3>هل يمكنني تطبيق هذه الحلول بدون فريق تقني كبير؟</h3>
      <p>نعم. الحلول مصممة لتكون قابلة للتطبيق بموارد محدودة، مع أدلة واضحة خطوة بخطوة. يمكن البدء بفريق صغير والتوسع تدريجياً حسب الحاجة.</p>
      <h3>كم يستغرق تطبيق الحوكمة؟</h3>
      <p>حسب <a href="/docs/governance-application/">دليل تطبيق الحوكمة خلال 30 يوم</a>، يمكن بناء إطار حوكمة أساسي خلال 4 أسابيع، مع التحسين المستمر بعد ذلك.</p>
    </section>

