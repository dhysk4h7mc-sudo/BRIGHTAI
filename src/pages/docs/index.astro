---
import { getCollection } from 'astro:content';
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const docs = await getCollection('docs');
const categoryOrder = ['Kernel', 'PDPL', 'NCA', 'SDAIA', 'General'] as const;
const categoryLabels = {
  Kernel: 'Kernel',
  PDPL: 'نظام حماية البيانات الشخصية PDPL',
  NCA: 'ضوابط الهيئة الوطنية للأمن السيبراني NCA',
  SDAIA: 'إرشادات سدايا',
  General: 'الحوكمة والتدقيق وإدارة المخاطر',
};

const grouped = categoryOrder.map((category) => ({
  category,
  label: categoryLabels[category],
  docs: docs
    .filter((doc) => doc.data.category === category)
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ar')),
})).filter((group) => group.docs.length > 0);

const title = 'مركز وثائق حوكمة الذكاء الاصطناعي الشامل | Saudi AI Safety OS';
const description = 'مرجع شامل لحوكمة وأمان الذكاء الاصطناعي في السعودية: 27+ وثيقة تغطي PDPL، NCA ECC، إرشادات سدايا، إدارة المخاطر، التدقيق، والتطبيق التقني - دليلك الكامل لتشغيل AI بأمان.';
const canonical = 'https://brightai.site/docs/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'ar-SA',
    },
    {
      '@type': 'ItemList',
      itemListElement: docs.map((doc, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: doc.data.title,
        url: doc.data.canonical,
      })),
    },
  ],
};
---

<ArabicLayout
  title={title}
  description={description}
  canonical={canonical}
  hreflang={[{ lang: 'ar-SA', href: canonical }]}
  jsonLd={jsonLd}
  currentPath="/docs/"
>
  <style>
    .docs-index {
      width: min(100% - 2rem, 75rem);
      margin-inline: auto;
      padding-block: 2rem 5rem;
    }
    .docs-index__hero {
      max-width: 54rem;
      padding-block: 2rem 3rem;
    }
    .docs-index__eyebrow {
      color: var(--brand, #00d4aa);
      font-weight: 800;
    }
    .docs-index h1 {
      margin: 0.75rem 0 1rem;
      color: var(--fg, #f8fafc);
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: 1.25;
    }
    .docs-index__intro,
    .docs-category__intro {
      color: var(--fg-muted, #a8b3c7);
      line-height: 1.9;
    }
    .docs-category {
      margin-block-start: 3rem;
    }
    .docs-category h2 {
      color: var(--fg, #f8fafc);
      font-size: clamp(1.4rem, 3vw, 2rem);
    }
    .docs-index__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .docs-index__card {
      display: block;
      padding: 1.25rem;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 1rem;
      color: inherit;
      text-decoration: none;
      background: rgba(15, 23, 42, 0.55);
    }
    .docs-index__card h3 {
      margin: 0 0 0.75rem;
      color: var(--fg, #f8fafc);
      font-size: 1.05rem;
      line-height: 1.55;
    }
    .docs-index__card p {
      margin: 0;
      color: var(--fg-muted, #a8b3c7);
      font-size: 0.875rem;
      line-height: 1.75;
    }
    @media (max-width: 900px) {
      .docs-index__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 600px) {
      .docs-index {
        width: min(100% - 1.25rem, 75rem);
      }
      .docs-index__grid {
        grid-template-columns: 1fr;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .docs-index__card {
        transition: none;
      }
    }
  </style>

  <main class="docs-index">
    <Breadcrumbs crumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'الوثائق' },
    ]} />

    <header class="docs-index__hero">
      <p class="docs-index__eyebrow">27 وثيقة عملية</p>
      <h1>وثائق تخدم تطبيقك لحوكمة الذكاء الاصطناعي</h1>
      <p class="docs-index__intro">{description}</p>
    </header>

    {grouped.map((group) => (
      <section class="docs-category" aria-labelledby={`category-${group.category.toLowerCase()}`}>
        <h2 id={`category-${group.category.toLowerCase()}`}>{group.label}</h2>
        <div class="docs-index__grid">
          {group.docs.map((doc) => (
            <a class="docs-index__card" href={`/docs/${doc.id}/`}>
              <h3>{doc.data.title}</h3>
              <p>{doc.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</ArabicLayout>
