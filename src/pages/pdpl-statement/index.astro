---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../data/i18n-pairs';
import { getLegalContent } from '../../data/legal-content';
const route = '/pdpl-statement/';
const canonical = `https://brightai.site${route}`;
const legalContent = getLegalContent('pdpl-statement/index.html');
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
]};
---
<ArabicLayout title="بيان امتثال BrightAI لنظام PDPL السعودي | BrightAI" description="اطلع على بيان امتثال BrightAI لمتطلبات PDPL، وكيف تتعامل المنصة مع حماية البيانات الشخصية ضمن خدمات حوكمة الذكاء الاصطناعي في السعودية، دون تعقيد زائد." canonical={canonical} hreflang={getLegalAlternates(route, 'ar')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)}>
  <style is:global>@import '../../styles/legal-pages.css';</style>
  <div class="legal-page" set:html={legalContent.html} />
</ArabicLayout>
