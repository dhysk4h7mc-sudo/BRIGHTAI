---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../../data/i18n-pairs';
import { getLegalContent } from '../../../data/legal-content';
const route = '/en/terms/';
const canonical = `https://brightai.site${route}`;
const legalContent = getLegalContent('en/terms/index.html');
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
]};
---
<EnglishLayout title="BrightAI Terms of Service for AI Governance | BrightAI" description="Review BrightAI terms for website and service use, including user responsibilities, acceptable use, and protections for AI governance customers in Saudi Arabia." canonical={canonical} hreflang={getLegalAlternates(route, 'en')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)}>
  <style is:global>@import '../../../styles/legal-pages.css';</style>
  <div class="legal-page" set:html={legalContent.html} />
</EnglishLayout>
