---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../../data/i18n-pairs';
import { legal_en_terms } from '../../../data/legal-content-en-inline';
const route = '/en/terms/';
const canonical = `https://brightai.site${route}`;
const legalContent = legal_en_terms;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
]};
---
<EnglishLayout title="BrightAI Terms of Service" description="Review BrightAI terms for website and service use: user responsibilities, acceptable use, and protections for AI governance customers in Saudi Arabia." canonical={canonical} hreflang={getLegalAlternates(route, 'en')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)}>
  <div class="legal-page" set:html={legalContent.html} />
</EnglishLayout>
