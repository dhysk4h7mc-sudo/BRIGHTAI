---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../../data/i18n-pairs';
import { legal_en_pdpl_statement } from '../../../data/legal-content-en-inline';
const route = '/en/pdpl-statement/';
const canonical = `https://brightai.site${route}`;
const legalContent = legal_en_pdpl_statement;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
]};
---
<EnglishLayout title="BrightAI PDPL Compliance Statement for Saudi AI" description="Read BrightAI PDPL compliance statement for responsible AI governance, data protection, and audit-ready controls designed for organizations in Saudi Arabia." canonical={canonical} hreflang={getLegalAlternates(route, 'en')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)}>
  <style is:global>@import '../../../styles/legal-pages.css';</style>
  <div class="legal-page" set:html={legalContent.html} />
</EnglishLayout>
