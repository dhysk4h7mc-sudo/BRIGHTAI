---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../../data/i18n-pairs';
import { getLegalContent } from '../../../data/legal-content';
const route = '/en/data-processing-agreement/';
const canonical = `https://brightai.site${route}`;
const legalContent = getLegalContent('en/data-processing-agreement/index.html');
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
]};
---
<EnglishLayout title="BrightAI Data Processing Agreement for Clients" description="Review BrightAI data processing terms, including roles, safeguards, and contractual commitments for organizations using AI governance services in Saudi Arabia." canonical={canonical} hreflang={getLegalAlternates(route, 'en')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)}>
  <style is:global>@import '../../../styles/legal-pages.css';</style>
  <div class="legal-page" set:html={legalContent.html} />
</EnglishLayout>
