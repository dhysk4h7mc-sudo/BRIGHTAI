---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../../data/i18n-pairs';
import { legal_en_privacy_policy } from '../../../data/legal-content-en-inline';
const route = '/en/privacy-policy/';
const canonical = `https://brightai.site${route}`;
const legalContent = legal_en_privacy_policy;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
]};
---
<EnglishLayout title="BrightAI Privacy Policy | Saudi AI" description="How BrightAI handles personal data, privacy choices, and security commitments for visitors evaluating AI governance services in Saudi Arabia today." canonical={canonical} hreflang={getLegalAlternates(route, 'en')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)}>
  <div class="legal-page" set:html={legalContent.html} />
</EnglishLayout>
