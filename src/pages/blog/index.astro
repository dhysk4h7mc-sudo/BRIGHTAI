---
/**
 * Blog listing page — /blog/
 * Lists all published posts with category filter.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedPosts, getCategories, type BlogCategory } from '../../data/blog';
import { SITE } from '../../data/site';

const allPosts = getPublishedPosts();
const categories = getCategories();

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'المدونة', item: `${SITE.url}/blog/` },
  ],
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'مدونة BrightAI',
  description: 'مقالات وخبرات حول حوكمة الذكاء الاصطناعي في السعودية والامتثال والأنظمة',
  url: `${SITE.url}/blog/`,
  inLanguage: 'ar-SA',
};
---

<ArabicLayout
  title="مدونة BrightAI لحوكمة الذكاء الاصطناعي في السعودية | BrightAI"
  description="22 مقالاً عملياً من BrightAI عن حوكمة الذكاء الاصطناعي، PDPL، NCA ECC، سدايا، ISO 42001، AI Firewall، وسجلات التدقيق للشركات السعودية."
  canonical={`${SITE.url}/blog/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/blog/` }]}
  jsonLd={collectionLd}
  currentPath="/blog/"
>
  <style is:global>
    .blog-listing {
      width: min(100% - 2rem, 72rem);
      margin-inline: auto;
      padding-block: 2rem 5rem;
    }
    .blog-listing__header {
      margin-block-end: 2rem;
      padding-block-end: 2rem;
      border-block-end: 1px solid rgba(148, 163, 184, 0.12);
    }
    .blog-listing__header h1 {
      margin: 0;
      color: var(--fg, #f8fafc);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
    }
    .blog-listing__header p {
      margin: 0.75rem 0 0;
      color: var(--fg-muted, #94a3b8);
      max-width: 52rem;
      line-height: 1.8;
    }
    .blog-listing__count {
      margin: 0.5rem 0 0;
      color: var(--fg-muted, #64748b);
      font-size: 0.8125rem;
    }
    .blog-section {
      margin-block: 3rem;
    }
    .blog-section > h2 {
      color: var(--fg, #f8fafc);
      font-size: clamp(1.4rem, 3vw, 2rem);
      margin-block-end: 0.5rem;
    }
    .blog-section > p {
      color: var(--fg-muted, #94a3b8);
      line-height: 1.8;
    }
    .blog-paths,
    .blog-featured {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .blog-path,
    .blog-featured a {
      display: block;
      padding: 1.25rem;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 8px;
      color: inherit;
      text-decoration: none;
      background: rgba(15, 23, 42, 0.5);
    }
    .blog-path strong,
    .blog-featured h3 {
      display: block;
      margin-block-end: 0.5rem;
      color: var(--fg, #f8fafc);
    }
    .blog-path span,
    .blog-featured p {
      color: var(--fg-muted, #94a3b8);
      line-height: 1.7;
    }
    .blog-topics {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .blog-topics a {
      padding: 0.55rem 0.9rem;
      border: 1px solid rgba(0, 212, 170, 0.3);
      border-radius: 8px;
      color: var(--brand, #00d4aa);
      text-decoration: none;
    }
    .blog-final-cta {
      margin-block-start: 3rem;
      padding: 1.5rem;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 8px;
      background: rgba(15, 23, 42, 0.5);
    }
    .blog-final-cta h2 { color: var(--fg, #f8fafc); }
    .blog-final-cta p { color: var(--fg-muted, #94a3b8); }
    .blog-final-cta a { margin-inline-end: 1rem; color: var(--brand, #00d4aa); }
    .blog-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-block-end: 2rem;
    }
    .blog-filter-btn {
      padding: 0.4rem 1rem;
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 999px;
      background: transparent;
      color: var(--fg-muted, #94a3b8);
      font-size: 0.8125rem;
      cursor: pointer;
      transition: all 0.15s;
      font-family: inherit;
    }
    .blog-filter-btn:hover,
    .blog-filter-btn.is-active {
      border-color: var(--brand, #00d4aa);
      color: var(--brand, #00d4aa);
      background: rgba(0, 212, 170, 0.08);
    }
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
    }
    .blog-card {
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 1rem;
      background: rgba(15, 23, 42, 0.5);
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s, transform 0.15s;
    }
    .blog-card:hover,
    .blog-card:focus-visible {
      border-color: var(--brand, #00d4aa);
      transform: translateY(-2px);
    }
    .blog-card__category {
      color: var(--brand, #00d4aa);
      font-size: 0.75rem;
      font-weight: 800;
      margin-block-end: 0.5rem;
    }
    .blog-card h2 {
      margin: 0;
      color: var(--fg, #f8fafc);
      font-size: 1.1rem;
      line-height: 1.4;
    }
    .blog-card__desc {
      margin: 0.5rem 0 0;
      color: var(--fg-muted, #94a3b8);
      font-size: 0.875rem;
      line-height: 1.7;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .blog-card__meta {
      margin-block-start: 1rem;
      padding-block-start: 0.75rem;
      border-block-start: 1px solid rgba(148, 163, 184, 0.12);
      font-size: 0.75rem;
      color: var(--fg-muted, #64748b);
      display: flex;
      justify-content: space-between;
    }
    .blog-rss-link {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      margin-block-start: 1rem;
      color: var(--brand, #00d4aa);
      font-size: 0.875rem;
      text-decoration: none;
    }
    .blog-rss-link:hover { text-decoration: underline; }
    @media (max-width: 640px) {
      .blog-listing { width: min(100% - 1.25rem, 72rem); }
      .blog-grid { grid-template-columns: 1fr; }
      .blog-paths, .blog-featured { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .blog-card, .blog-filter-btn { transition: none; }
    }
  </style>

  <div class="blog-listing">
    <div class="blog-listing__breadcrumbs">
      <Breadcrumbs crumbs={[
        { label: 'الرئيسية', href: '/' },
        { label: 'المدونة' },
      ]} />
    </div>

    <header class="blog-listing__header">
      <h1>مقالات تخدم قرارك في حوكمة الذكاء الاصطناعي</h1>
      <p>وش تبي تعرف عن حوكمة AI في السعودية؟ مدوّنتنا تجمع أدلة تنفيذية مختصرة — من السياسات إلى التطبيق — تساعدك تتخذ قرار أفضل لشركتك في الحوكمة، حماية البيانات، والامتثال.</p>
      <p class="blog-listing__count">{allPosts.length} مقال</p>
      <a href="/authors/nasser-alabdullah/">ملف المؤلف ومقالاته</a>
      <a href="/blog/feed.xml" class="blog-rss-link" target="_blank" rel="noopener">
        📡 اشترك عبر RSS
      </a>
    </header>

    <section class="blog-section" aria-labelledby="reading-paths">
      <h2 id="reading-paths">ابدأ حسب سؤال فريقك</h2>
      <p>اختر مسار القراءة الأقرب لقرارك الحالي، ثم انتقل للتفاصيل من شبكة المقالات الكاملة.</p>
      <ol class="blog-paths">
        <li><a class="blog-path" href="/blog/what-is-ai-governance-saudi-companies/"><strong>1 تأسيس الحوكمة</strong><span>فهم المفاهيم، المخاطر، والفروق بين governance وsafety وsecurity.</span></a></li>
        <li><a class="blog-path" href="/blog/pdpl-ai-compliance-guide/"><strong>2 الامتثال والبيانات</strong><span>PDPL وNCA ECC وسدايا وISO 42001 بلغة قابلة للتطبيق.</span></a></li>
        <li><a class="blog-path" href="/blog/ai-firewall-why-you-need-it/"><strong>3 سلامة التشغيل</strong><span>AI Firewall وسجلات التدقيق وRed Teaming والاستخدام الخفي للذكاء الاصطناعي.</span></a></li>
      </ol>
    </section>

    <section class="blog-section" aria-labelledby="quick-topics">
      <h2 id="quick-topics">مواضيع سريعة</h2>
      <p>روابط مباشرة لأكثر المواضيع ارتباطاً بقرارات التقنية والمخاطر والامتثال.</p>
      <nav class="blog-topics" aria-label="مواضيع المدونة">
        <a href="/blog/ai-governance-saudi-arabia/">حوكمة AI</a>
        <a href="/blog/pdpl-and-ai-saudi/">PDPL</a>
        <a href="/blog/nca-ecc-ai-controls-guide/">NCA ECC</a>
        <a href="/blog/sdaia-generative-ai-guidelines-practical-compliance/">سدايا</a>
        <a href="/blog/iso-42001-saudi-implementation-guide/">ISO 42001</a>
        <a href="/blog/ai-audit-trail-compliance-path/">Audit Trail</a>
        <a href="/blog/ai-red-teaming-security-testing/">Red Teaming</a>
        <a href="/blog/shadow-ai-discovery-saudi-company/">Shadow AI</a>
      </nav>
    </section>

    <section class="blog-section" aria-labelledby="featured-posts">
      <h2 id="featured-posts">مقالات مختارة</h2>
      <p>أفضل نقطة بداية لو كنت تبني برنامج حوكمة أو تراجع جاهزية استخدام AI داخل المؤسسة.</p>
      <div class="blog-featured">
        <a href="/blog/what-is-ai-governance-saudi-companies/"><strong>مدخل الحوكمة</strong><h3>ما هي حوكمة الذكاء الاصطناعي؟ الدليل الكامل للشركات السعودية</h3><p>ابدأ من هنا إذا تحتاج إطار واضح يربط السياسات، المخاطر، الامتثال، وسجلات التشغيل.</p></a>
        <a href="/blog/pdpl-ai-compliance-guide/"><strong>الامتثال والبيانات</strong><h3>دليل PDPL والذكاء الاصطناعي لمسؤول الامتثال</h3></a>
        <a href="/blog/ai-firewall-why-you-need-it/"><strong>سلامة التشغيل</strong><h3>جدار حماية الذكاء الاصطناعي: ما هو ولماذا تحتاجه</h3></a>
      </div>
    </section>

    <section class="blog-section" aria-labelledby="all-posts">
      <h2 id="all-posts">كل المقالات</h2>
      <p>مجموعة مرتبة من الأدلة والمقالات العملية المنشورة على BrightAI.</p>
    </section>

    <nav class="blog-filters" aria-label="تصفية بالفئة">
      <button class="blog-filter-btn is-active" data-category="all">الكل</button>
      {categories.map(cat => (
        <button class="blog-filter-btn" data-category={cat}>{cat}</button>
      ))}
    </nav>

    <div class="blog-grid" id="blog-grid">
      {allPosts.map(post => (
        <a href={`/blog/${post.slug}/`} class="blog-card" data-category={post.category}>
          <span class="blog-card__category">{post.category}</span>
          <h2>{post.title}</h2>
          <p class="blog-card__desc">{post.description}</p>
          <div class="blog-card__meta">
            <span>{post.pubDate}</span>
            <span>{post.readingTime} دقائق</span>
          </div>
        </a>
      ))}
    </div>

    <section class="blog-final-cta" aria-labelledby="blog-cta">
      <h2 id="blog-cta">تبي تحوّل القراءة لخطة حوكمة قابلة للتنفيذ؟</h2>
      <p>ابدأ بتقييم جاهزية حوكمة الذكاء الاصطناعي أو تواصل مع الفريق لترتيب جلسة تشخيص قصيرة.</p>
      <a href="/assessment/ai-governance-readiness/">تقييم الجاهزية</a>
      <a href="/contact/">تواصل معنا</a>
    </section>
  </div>

  <script>
    // Client-side category filter
    function initBlogFilters() {
      const container = document.querySelector('.blog-filters');
      if (!container || container.hasAttribute('data-filters-initialized')) return;

      const buttons = container.querySelectorAll('.blog-filter-btn');
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = (btn as HTMLElement).dataset.category;
          buttons.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          document.querySelectorAll('.blog-card').forEach(card => {
            const cardCat = (card as HTMLElement).dataset.category;
            (card as HTMLElement).style.display = (cat === 'all' || cardCat === cat) ? '' : 'none';
          });
        });
      });

      container.setAttribute('data-filters-initialized', 'true');
    }

    document.addEventListener('astro:page-load', initBlogFilters);
  </script>
</ArabicLayout>
