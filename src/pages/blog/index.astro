---
/**
 * Blog listing page — /blog/
 * Lists all published posts with category filter.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedPosts, getCategories, type BlogCategory } from '../../data/blog';
import { SITE } from '../../data/site';

const allPosts = getPublishedPosts();
const categories = getCategories();

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'المدونة', item: `${SITE.url}/blog/` },
  ],
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'مدونة BrightAI',
  description: 'مقالات وخبرات حول حوكمة الذكاء الاصطناعي في السعودية والامتثال والأنظمة',
  url: `${SITE.url}/blog/`,
  inLanguage: 'ar-SA',
};
---

<ArabicLayout
  title="مدونة BrightAI | حوكمة الذكاء الاصطناعي في السعودية"
  description="مقالات عملية حول حوكمة الذكاء الاصطناعي، الامتثال، الأمان، والأنظمة السعودية. خبرات مبنية على حالات حقيقية."
  canonical={`${SITE.url}/blog/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/blog/` }]}
  jsonLd={collectionLd}
  currentPath="/blog/"
>
  <style is:global>
    .blog-listing {
      width: min(100% - 2rem, 72rem);
      margin-inline: auto;
      padding-block: 2rem 5rem;
    }
    .blog-listing__header {
      margin-block-end: 2rem;
      padding-block-end: 2rem;
      border-block-end: 1px solid rgba(148, 163, 184, 0.12);
    }
    .blog-listing__header h1 {
      margin: 0;
      color: var(--fg, #f8fafc);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
    }
    .blog-listing__header p {
      margin: 0.75rem 0 0;
      color: var(--fg-muted, #94a3b8);
      max-width: 52rem;
      line-height: 1.8;
    }
    .blog-listing__count {
      margin: 0.5rem 0 0;
      color: var(--fg-muted, #64748b);
      font-size: 0.8125rem;
    }
    .blog-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-block-end: 2rem;
    }
    .blog-filter-btn {
      padding: 0.4rem 1rem;
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 999px;
      background: transparent;
      color: var(--fg-muted, #94a3b8);
      font-size: 0.8125rem;
      cursor: pointer;
      transition: all 0.15s;
      font-family: inherit;
    }
    .blog-filter-btn:hover,
    .blog-filter-btn.is-active {
      border-color: var(--brand, #00d4aa);
      color: var(--brand, #00d4aa);
      background: rgba(0, 212, 170, 0.08);
    }
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
    }
    .blog-card {
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 1rem;
      background: rgba(15, 23, 42, 0.5);
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s, transform 0.15s;
    }
    .blog-card:hover,
    .blog-card:focus-visible {
      border-color: var(--brand, #00d4aa);
      transform: translateY(-2px);
    }
    .blog-card__category {
      color: var(--brand, #00d4aa);
      font-size: 0.75rem;
      font-weight: 800;
      margin-block-end: 0.5rem;
    }
    .blog-card h2 {
      margin: 0;
      color: var(--fg, #f8fafc);
      font-size: 1.1rem;
      line-height: 1.4;
    }
    .blog-card__desc {
      margin: 0.5rem 0 0;
      color: var(--fg-muted, #94a3b8);
      font-size: 0.875rem;
      line-height: 1.7;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .blog-card__meta {
      margin-block-start: 1rem;
      padding-block-start: 0.75rem;
      border-block-start: 1px solid rgba(148, 163, 184, 0.12);
      font-size: 0.75rem;
      color: var(--fg-muted, #64748b);
      display: flex;
      justify-content: space-between;
    }
    .blog-rss-link {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      margin-block-start: 1rem;
      color: var(--brand, #00d4aa);
      font-size: 0.875rem;
      text-decoration: none;
    }
    .blog-rss-link:hover { text-decoration: underline; }
    @media (max-width: 640px) {
      .blog-listing { width: min(100% - 1.25rem, 72rem); }
      .blog-grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .blog-card, .blog-filter-btn { transition: none; }
    }
  </style>

  <div class="blog-listing">
    <div class="blog-listing__breadcrumbs">
      <Breadcrumbs crumbs={[
        { label: 'الرئيسية', href: '/' },
        { label: 'المدونة' },
      ]} />
    </div>

    <header class="blog-listing__header">
      <h1>مدونة BrightAI</h1>
      <p>مقالات عملية حول حوكمة الذكاء الاصطناعي، الامتثال، الأمان، والأنظمة السعودية — مبنية على حالات حقيقية.</p>
      <p class="blog-listing__count">{allPosts.length} مقال</p>
      <a href="/blog/feed.xml" class="blog-rss-link" target="_blank" rel="noopener">
        📡 اشترك عبر RSS
      </a>
    </header>

    <nav class="blog-filters" aria-label="تصفية بالفئة">
      <button class="blog-filter-btn is-active" data-category="all">الكل</button>
      {categories.map(cat => (
        <button class="blog-filter-btn" data-category={cat}>{cat}</button>
      ))}
    </nav>

    <div class="blog-grid" id="blog-grid">
      {allPosts.map(post => (
        <a href={`/blog/${post.slug}/`} class="blog-card" data-category={post.category}>
          <span class="blog-card__category">{post.category}</span>
          <h2>{post.title}</h2>
          <p class="blog-card__desc">{post.description}</p>
          <div class="blog-card__meta">
            <span>{post.pubDate}</span>
            <span>{post.readingTime} دقائق</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <script>
    // Client-side category filter
    document.querySelectorAll('.blog-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.category;
        document.querySelectorAll('.blog-filter-btn').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        document.querySelectorAll('.blog-card').forEach(card => {
          const cardCat = (card as HTMLElement).dataset.category;
          (card as HTMLElement).style.display = (cat === 'all' || cardCat === cat) ? '' : 'none';
        });
      });
    });
  </script>
</ArabicLayout>