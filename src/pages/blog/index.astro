---
/**
 * Blog listing page — /blog/
 * Lists all published posts with category filter.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedPosts, getCategories, type BlogCategory } from '../../data/blog';
import { SITE } from '../../data/site';

const allPosts = getPublishedPosts();
const categories = getCategories();

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'المدونة', item: `${SITE.url}/blog/` },
  ],
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'مدونة BrightAI',
  description: 'مقالات وخبرات حول حوكمة الذكاء الاصطناعي في السعودية والامتثال والأنظمة',
  url: `${SITE.url}/blog/`,
  inLanguage: 'ar-SA',
};
---

<ArabicLayout
  title="مدونة BrightAI لحوكمة الذكاء الاصطناعي في السعودية | BrightAI"
  description="22 مقالاً عملياً من BrightAI عن حوكمة الذكاء الاصطناعي، PDPL، NCA ECC، سدايا، ISO 42001، AI Firewall، وسجلات التدقيق للشركات السعودية."
  canonical={`${SITE.url}/blog/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/blog/` }]}
  jsonLd={collectionLd}
  currentPath="/blog/"
>
  <div class="article-shell article-shell--wide">
    <div class="article-breadcrumbs">
      <Breadcrumbs crumbs={[
        { label: 'الرئيسية', href: '/' },
        { label: 'المدونة' },
      ]} />
    </div>

    <header class="listing-hero">
      <h1>مقالات تخدم قرارك في حوكمة الذكاء الاصطناعي</h1>
      <p class="listing-hero__desc">وش تبي تعرف عن حوكمة AI في السعودية؟ مدوّنتنا تجمع أدلة تنفيذية مختصرة — من السياسات إلى التطبيق — تساعدك تتخذ قرار أفضل لشركتك في الحوكمة، حماية البيانات، والامتثال.</p>
      <p class="blog-listing__count" style="margin-top:var(--space-3);color:var(--text-faint);font-size:var(--text-xs);">{allPosts.length} مقال</p>
      <div style="display:flex;flex-wrap:wrap;gap:var(--space-4);justify-content:center;margin-top:var(--space-4);">
        <a href="/authors/nasser-alabdullah/" style="color:var(--brand-hover);font-size:var(--text-sm);text-decoration:none;">ملف المؤلف ومقالاته</a>
        <a href="/blog/feed.xml" style="color:var(--brand-hover);font-size:var(--text-sm);text-decoration:none;" target="_blank" rel="noopener">
          📡 اشترك عبر RSS
        </a>
      </div>
    </header>

    <section class="blog-section" aria-labelledby="reading-paths">
      <h2 id="reading-paths">ابدأ حسب سؤال فريقك</h2>
      <p>اختر مسار القراءة الأقرب لقرارك الحالي، ثم انتقل للتفاصيل من شبكة المقالات الكاملة.</p>
      <ol class="blog-paths">
        <li><a class="blog-path" href="/blog/what-is-ai-governance-saudi-companies/"><strong>1 تأسيس الحوكمة</strong><span>فهم المفاهيم، المخاطر، والفروق بين governance وsafety وsecurity.</span></a></li>
        <li><a class="blog-path" href="/blog/pdpl-ai-compliance-guide/"><strong>2 الامتثال والبيانات</strong><span>PDPL وNCA ECC وسدايا وISO 42001 بلغة قابلة للتطبيق.</span></a></li>
        <li><a class="blog-path" href="/blog/ai-firewall-why-you-need-it/"><strong>3 سلامة التشغيل</strong><span>AI Firewall وسجلات التدقيق وRed Teaming والاستخدام الخفي للذكاء الاصطناعي.</span></a></li>
      </ol>
    </section>

    <section class="blog-section" aria-labelledby="quick-topics">
      <h2 id="quick-topics">مواضيع سريعة</h2>
      <p>روابط مباشرة لأكثر المواضيع ارتباطاً بقرارات التقنية والمخاطر والامتثال.</p>
      <nav class="blog-topics" aria-label="مواضيع المدونة">
        <a href="/blog/ai-governance-saudi-arabia/">حوكمة AI</a>
        <a href="/blog/pdpl-and-ai-saudi/">PDPL</a>
        <a href="/blog/nca-ecc-ai-controls-guide/">NCA ECC</a>
        <a href="/blog/sdaia-generative-ai-guidelines-practical-compliance/">سدايا</a>
        <a href="/blog/iso-42001-saudi-implementation-guide/">ISO 42001</a>
        <a href="/blog/ai-audit-trail-compliance-path/">Audit Trail</a>
        <a href="/blog/ai-red-teaming-security-testing/">Red Teaming</a>
        <a href="/blog/shadow-ai-discovery-saudi-company/">Shadow AI</a>
      </nav>
    </section>

    <section class="blog-section" aria-labelledby="featured-posts">
      <h2 id="featured-posts">مقالات مختارة</h2>
      <p>أفضل نقطة بداية لو كنت تبني برنامج حوكمة أو تراجع جاهزية استخدام AI داخل المؤسسة.</p>
      <div class="blog-featured">
        <a href="/blog/what-is-ai-governance-saudi-companies/"><strong>مدخل الحوكمة</strong><h3>ما هي حوكمة الذكاء الاصطناعي؟ الدليل الكامل للشركات السعودية</h3><p>ابدأ من هنا إذا تحتاج إطار واضح يربط السياسات، المخاطر، الامتثال، وسجلات التشغيل.</p></a>
        <a href="/blog/pdpl-ai-compliance-guide/"><strong>الامتثال والبيانات</strong><h3>دليل PDPL والذكاء الاصطناعي لمسؤول الامتثال</h3></a>
        <a href="/blog/ai-firewall-why-you-need-it/"><strong>سلامة التشغيل</strong><h3>جدار حماية الذكاء الاصطناعي: ما هو ولماذا تحتاجه</h3></a>
      </div>
    </section>

    <section class="blog-section" aria-labelledby="all-posts">
      <h2 id="all-posts">كل المقالات</h2>
      <p>مجموعة مرتبة من الأدلة والمقالات العملية المنشورة على BrightAI.</p>
    </section>

    <nav class="blog-filters" aria-label="تصفية بالفئة">
      <button class="blog-filter-btn is-active" data-category="all">الكل</button>
      {categories.map(cat => (
        <button class="blog-filter-btn" data-category={cat}>{cat}</button>
      ))}
    </nav>

    <div class="listing-grid" id="blog-grid">
      {allPosts.map(post => (
        <a href={`/blog/${post.slug}/`} class="listing-card blog-card" data-category={post.category}>
          <span class="listing-card__category">{post.category}</span>
          <h2>{post.title}</h2>
          <p class="listing-card__desc">{post.description}</p>
          <div class="listing-card__meta">
            <span>{post.pubDate}</span>
            <span>{post.readingTime} دقائق</span>
          </div>
        </a>
      ))}
    </div>

    <section class="blog-final-cta" aria-labelledby="blog-cta">
      <h2 id="blog-cta">تبي تحوّل القراءة لخطة حوكمة قابلة للتنفيذ؟</h2>
      <p>ابدأ بتقييم جاهزية حوكمة الذكاء الاصطناعي أو تواصل مع الفريق لترتيب جلسة تشخيص قصيرة.</p>
      <div style="display:flex;flex-wrap:wrap;gap:var(--space-4);margin-top:var(--space-4);">
        <a href="/assessment/ai-governance-readiness/" style="color:var(--brand);font-weight:var(--weight-bold);text-decoration:none;">تقييم الجاهزية ←</a>
        <a href="/contact/" style="color:var(--brand);font-weight:var(--weight-bold);text-decoration:none;">تواصل معنا ←</a>
      </div>
    </section>
  </div>

  <script>
    // Client-side category filter
    function initBlogFilters() {
      const container = document.querySelector('.blog-filters');
      if (!container || container.hasAttribute('data-filters-initialized')) return;

      const buttons = container.querySelectorAll('.blog-filter-btn');
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = (btn as HTMLElement).dataset.category;
          buttons.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          document.querySelectorAll('.blog-card').forEach(card => {
            const cardCat = (card as HTMLElement).dataset.category;
            (card as HTMLElement).style.display = (cat === 'all' || cardCat === cat) ? '' : 'none';
          });
        });
      });

      container.setAttribute('data-filters-initialized', 'true');
    }

    document.addEventListener('astro:page-load', initBlogFilters);
  </script>
</ArabicLayout>
