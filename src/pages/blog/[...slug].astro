---
/**
 * Blog article dynamic page — /blog/<slug>/
 * Uses data from src/data/blog.ts + content from src/content/blog/*.md
 *
 * REPORT-12: Passes breadcrumb JSON-LD (chain: الرئيسية → المدونة → article)
 * separately from BlogLayout's Article + Organization schema. The visual
 * breadcrumbs are emitted by the <Breadcrumbs /> component inside BlogLayout.
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import { posts, getRelatedPosts } from '../../data/blog';
import { getCollection } from 'astro:content';
import { SITE } from '../../data/site';
import { getBreadcrumbLd } from '../../data/schema-helpers';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');

  return blogEntries.map(entry => ({
    params: { slug: entry.data.slug || entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = entry.data.slug || entry.id.replace(/\.md$/, '');

const post = posts.find(p => p.slug === slug);

if (!post) {
  return Astro.redirect('/blog/');
}

const relatedPosts = getRelatedPosts(slug);
const body = entry.body || '';

// SCHEMA-ENHANCEMENT (REPORT-23): explicit chain breadcrumb for the article.
const breadcrumbLd = getBreadcrumbLd([
  { name: 'الرئيسية', href: '/' },
  { name: 'المدونة', href: '/blog/' },
  { name: post.title, href: post.canonical },
]);
---

<BlogLayout post={post} body={body} relatedPosts={relatedPosts}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BlogLayout>