---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../data/i18n-pairs';
import { legal_data_processing_agreement } from '../../data/legal-content-inline';
const route = '/data-processing-agreement/';
const canonical = `https://brightai.site${route}`;
const legalContent = legal_data_processing_agreement;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
]};
---
<ArabicLayout title="اتفاقية معالجة البيانات لخدمات BrightAI السحابية" description="راجع اتفاقية معالجة البيانات الخاصة بخدمات BrightAI، بما يشمل أدوار المعالجة، حماية البيانات، والالتزامات التعاقدية المناسبة لعملاء السعودية، بوضوح." canonical={canonical} hreflang={getLegalAlternates(route, 'ar')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)}>
  <style is:global>@import '../../styles/legal-pages.css';</style>
  <div class="legal-page" set:html={legalContent.html} />
</ArabicLayout>
