<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('leadForm') as HTMLFormElement | null;
    const msg = document.getElementById('leadMsg');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        await fetch('/tables/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, created_at: Date.now() }),
        });
      } catch {
        // The legacy endpoint is optional; preserve the original optimistic UX.
      }
      msg?.classList.remove('hidden');
      form.reset();
      window.setTimeout(() => msg?.classList.add('hidden'), 6000);
    }, { once: true });
  });
</script>

