---
/**
 * /kernel/ — Index page
 * Overview + cards for all units + LiveDashboardMockup
 * GSAP allowed here (dynamic import, idle, reduced-motion, CSS fallback)
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import LiveDashboardMockup from '../../components/LiveDashboardMockup.astro';
import { kernelNavItems, getCrossLinks } from '../../data/kernel';

const unit = {
  title: 'منصة حوكمة الذكاء الاصطناعي للمنشآت | BrightAI Kernel',
  description: 'شغّل حوكمة الذكاء الاصطناعي في منشأتك من لوحة مركزية تجمع السياسات والموافقات والأدلة والرقابة، وتمنح فرق العمل رؤية تنفيذية موحدة.',
  canonical: 'https://brightai.site/kernel/',
  h1: 'غرفة تشغيل حوكمة الذكاء الاصطناعي — راقب كل شي من مكان واحد',
  hreflang: [
    { lang: 'ar-SA', href: 'https://brightai.site/kernel/' },
    { lang: 'x-default', href: 'https://brightai.site/kernel/' },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      '@id': 'https://brightai.site/#product',
      name: 'BrightAI Kernel',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Cloud, Hybrid, On-Premise',
      description: 'نواة حوكمة الذكاء الاصطناعي للمنشآت السعودية — تدعم جاهزية الامتثال ولا تُعدّ استشارة قانونية. تشمل AI Firewall وسجل تدقيق غير قابل للتعديل وموافقات بشرية وملفات أدلة وحزم امتثال للوائح السعودية.',
      url: 'https://brightai.site/kernel/',
      provider: { '@id': 'https://brightai.site/#organization' },
      featureList: [
        'AI Firewall — فحص الطلبات ومنع تسريب البيانات',
        'PII Redaction — إخفاء البيانات الشخصية تلقائياً',
        'Audit Trail — سجل تدقيق غير قابل للتعديل',
        'Human Approval Layer — موافقات بشرية للقرارات عالية المخاطر',
        'AI Evidence File — ملفات أدلة PDF موقّعة رقمياً',
        'Risk Scoring — تصنيف مخاطر كل طلب',
        'Compliance Packs — حزم امتثال PDPL وNCA وSFDA وSAMA',
        'Policy Editor — محرر سياسات بدون تعقيد تقني',
        'Enterprise Connectors — ربط آمن مع ERP وCRM وHIS',
        'Statistics Dashboard — مؤشرات تشغيلية ورؤية شاملة'
      ],
      offers: {
        '@type': 'Offer',
        priceCurrency: 'SAR',
        price: 0,
        availability: 'https://schema.org/InStock',
        url: 'https://brightai.site/contact/',
        description: 'تواصل عبر /contact/ للحصول على عرض سعر مخصص لحجم المنشأة'
      }
    },
    {
      '@type': 'Organization',
      '@id': 'https://brightai.site/#organization',
      name: 'BrightAI',
      url: 'https://brightai.site/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://brightai.site/frontend/assets/images/logo.png',
        width: 200,
        height: 55,
        caption: 'شعار BrightAI'
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '6913 المبارك بن فضالة، حي الفيحاء',
        addressLocality: 'الرياض',
        addressRegion: 'منطقة الرياض',
        postalCode: '14254',
        addressCountry: 'SA'
      },
      areaServed: [
        { '@type': 'Country', name: 'المملكة العربية السعودية' },
        { '@type': 'City', name: 'الرياض' },
        { '@type': 'City', name: 'جدة' },
        { '@type': 'City', name: 'الدمام' }
      ],
      contactPoint: [{
        '@type': 'ContactPoint',
        telephone: '+966538229013',
        contactType: 'customer support',
        contactOption: 'WhatsApp',
        url: 'https://wa.me/966538229013',
        areaServed: 'SA',
        availableLanguage: ['Arabic', 'English']
      }],
      sameAs: [
        'https://linkedin.com/company/brightai-site',
        'https://x.com/BrightAISite',
        'https://www.youtube.com/@BrightAiSaudi',
        'https://wa.me/966538229013'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': 'https://brightai.site/#website',
      url: 'https://brightai.site/',
      name: 'BrightAI',
      publisher: { '@id': 'https://brightai.site/#organization' },
      inLanguage: 'ar-SA'
    },
    {
      '@type': 'WebPage',
      '@id': 'https://brightai.site/kernel/#webpage',
      url: 'https://brightai.site/kernel/',
      name: unit.title,
      description: unit.description,
      isPartOf: { '@id': 'https://brightai.site/#website' },
      about: { '@id': 'https://brightai.site/#organization' },
      mainEntity: { '@id': 'https://brightai.site/#product' },
      inLanguage: 'ar-SA'
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://brightai.site/kernel/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'BrightAI', item: 'https://brightai.site/' },
        { '@type': 'ListItem', position: 2, name: 'Kernel', item: 'https://brightai.site/kernel/' }
      ]
    }
  ]
};
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath="/kernel/"
>
  <style>
    .k-hero { margin-bottom: 2rem; }
    .k-hero h1 {
      font-size: clamp(1.5rem, 4vw, 2.25rem);
      font-weight: 800;
      color: var(--fg, #e2e8f0);
      line-height: 1.4;
      margin-bottom: 1rem;
    }
    .k-hero p {
      font-size: 1rem;
      color: var(--fg-muted, #94a3b8);
      line-height: 1.8;
      max-width: 48rem;
    }
    .k-section-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--fg, #e2e8f0);
      margin: 2.5rem 0 1rem;
    }
    .k-section-intro {
      color: var(--fg-muted, #94a3b8);
      line-height: 1.8;
    }
    .k-actions {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .k-action {
      display: block;
      padding: 1rem;
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: 0.5rem;
      color: inherit;
      text-decoration: none;
      background: rgba(255,255,255,0.03);
    }
    .k-action strong { display: block; color: var(--fg, #e2e8f0); margin-bottom: .35rem; }
    .k-action span { color: var(--fg-muted, #94a3b8); font-size: .8125rem; line-height: 1.6; }
    .k-runtime-panel {
      padding: 1rem;
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: 0.5rem;
      background: rgba(255,255,255,0.03);
    }
    .k-doc-links {
      display: flex;
      flex-wrap: wrap;
      gap: .75rem;
    }
    .k-doc-links a { color: var(--brand, #00D4AA); }
    .k-units {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1rem;
    }
    .k-unit-card {
      background: var(--card-bg, rgba(255,255,255,0.03));
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: 0.75rem;
      padding: 1.25rem;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: border-color 0.15s, transform 0.15s;
    }
    .k-unit-card:hover,
    .k-unit-card:focus-visible {
      border-color: var(--brand, #00D4AA);
      transform: translateY(-2px);
    }
    .k-unit-card__icon {
      width: 2.5rem;
      height: 2.5rem;
      color: var(--brand, #00D4AA);
    }
    .k-unit-card__label {
      font-size: 1rem;
      font-weight: 600;
      color: var(--fg, #e2e8f0);
    }
    .k-unit-card__desc {
      font-size: 0.8125rem;
      color: var(--fg-muted, #94a3b8);
      line-height: 1.6;
    }
    .k-unit-card__links {
      display: flex;
      gap: 0.75rem;
      margin-top: auto;
      flex-wrap: wrap;
    }
    .k-unit-card__link {
      font-size: 0.75rem;
      color: var(--brand, #00D4AA);
      text-decoration: none;
    }
    .k-unit-card__link:hover { text-decoration: underline; }

    .k-cross-links {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border, rgba(255,255,255,0.08));
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
    .k-cross-links a {
      display: block;
      padding: 1rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: 0.5rem;
      color: var(--fg-muted, #94a3b8);
      text-decoration: none;
      font-size: 0.8125rem;
      line-height: 1.6;
    }
    .k-cross-links a:hover,
    .k-cross-links a:focus-visible {
      color: var(--brand, #00D4AA);
      border-color: var(--brand, #00D4AA);
    }
    .k-cross-links a strong {
      display: block;
      color: var(--fg, #e2e8f0);
      margin-bottom: 0.25rem;
    }
    .shortcut-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 999;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(8px);
    }
    .shortcut-overlay.open { display: flex; }
    .shortcut-card {
      width: min(100%, 30rem);
      padding: 2rem;
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: 0.75rem;
      background: var(--card-bg, #111827);
      box-shadow: 0 24px 60px rgba(0,0,0,0.4);
    }
    .shortcut-card h3 {
      margin: 0 0 1rem;
      color: var(--fg, #e2e8f0);
      font-size: 1.125rem;
    }
    .shortcut-row {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.5rem 0;
      color: var(--fg-muted, #94a3b8);
      font-size: 0.875rem;
    }
    .shortcut-key {
      padding: 0.125rem 0.5rem;
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: 0.25rem;
      background: rgba(255,255,255,0.05);
      color: var(--fg, #e2e8f0);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.75rem;
    }

    /* GSAP animation targets — fallback visible without JS */
    .gsap-fade { opacity: 1; }
    .gsap-fade[data-gsap-ready] { opacity: 0; }

    @media (prefers-reduced-motion: reduce) {
      .k-unit-card { transition: none; }
      .gsap-fade { opacity: 1 !important; }
    }
    @media (max-width: 760px) {
      .k-actions { grid-template-columns: 1fr; }
    }
  </style>

  <div
    class="shortcut-overlay"
    id="shortcut-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="shortcut-title"
    aria-hidden="true"
  >
    <div class="shortcut-card">
      <h3 id="shortcut-title">اختصارات لوحة المفاتيح</h3>
      <div class="shortcut-row"><span>فتح المحادثة</span><span class="shortcut-key">C</span></div>
      <div class="shortcut-row"><span>الموافقات</span><span class="shortcut-key">A</span></div>
      <div class="shortcut-row"><span>التدقيق</span><span class="shortcut-key">T</span></div>
      <div class="shortcut-row"><span>الإحصائيات</span><span class="shortcut-key">S</span></div>
      <div class="shortcut-row"><span>تحديث البيانات</span><span class="shortcut-key">R</span></div>
      <div class="shortcut-row"><span>إغلاق</span><span class="shortcut-key">Esc</span></div>
    </div>
  </div>

  <!-- Breadcrumb -->
  <nav aria-label="التنقل التفصيلي" style="margin-bottom:1.5rem">
    <ol style="display:flex;gap:0.5rem;list-style:none;padding:0;margin:0;font-size:0.8125rem;color:var(--fg-muted,#94a3b8)">
      <li><a href="/" style="color:var(--fg-muted,#94a3b8);text-decoration:none">الرئيسية</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/kernel/" style="color:var(--brand,#00D4AA);text-decoration:none;font-weight:600">Kernel</a></li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="k-hero">
    <p>BrightAI Kernel Dashboard</p>
    <h1>{unit.h1}</h1>
    <p>
      منصة BrightAI Kernel هي غرفة تشغيل مركزية تمنح فرق الحوكمة والامتثال رؤية تنفيذية موحدة على كل أنشطة الذكاء الاصطناعي في المنشأة. تجمع السياسات والموافقات والأدلة والرقابة في لوحة واحدة، وتدعم جاهزية المؤسسة للمراجعات والتدقيق.
    </p>
  </section>

  <section aria-labelledby="kernel-actions">
    <h2 class="k-section-title" id="kernel-actions">الإجراءات الرئيسية</h2>
    <p class="k-section-intro">ابدأ من مسارات التشغيل الأكثر استخداماً لفريق الحوكمة.</p>
    <div class="k-actions">
      <a class="k-action" href="/kernel/chat/"><strong>تشغيل محادثة آمنة</strong><span>اختبر الطلبات مع فحص PII والمخاطر قبل الإرسال.</span></a>
      <a class="k-action" href="/kernel/approvals/"><strong>مراجعة الموافقات</strong><span>تعامل مع الطلبات العالية الحساسية قبل التنفيذ.</span></a>
      <a class="k-action" href="/kernel/audit/"><strong>فتح سجل التدقيق</strong><span>راجع trace والقرار والهاش المرتبط بكل عملية.</span></a>
      <a class="k-action" href="/kernel/reports/"><strong>إنشاء تقرير</strong><span>تقارير امتثال وتدقيق تنفيذية.</span></a>
      <a class="k-action" href="/kernel/scenarios/"><strong>اختبار سيناريو</strong><span>اختبر استجابة الحوكمة.</span></a>
      <a class="k-action" href="/kernel/compliance/"><strong>مراجعة الامتثال</strong><span>حالة حزم الامتثال والفجوات.</span></a>
    </div>
  </section>

  <!-- Dashboard Metrics -->
  <h2 class="k-section-title">المؤشرات</h2>
  <p class="k-section-intro">قراءة سريعة لحالة الطلبات والمخاطر والبيانات الحساسة. <a href="/kernel/stats/">كل الإحصائيات</a></p>
  <LiveDashboardMockup />

  <section aria-labelledby="risk-map">
    <h2 class="k-section-title" id="risk-map">خريطة المخاطر</h2>
    <p class="k-section-intro">توزيع المخاطر حسب النوع والحساسية.</p>
    <div class="k-runtime-panel" aria-label="خريطة المخاطر">
      يعرض Kernel توزيع الطلبات منخفضة ومتوسطة وعالية المخاطر لتوجيه المراجعة البشرية والسياسات.
    </div>
  </section>

  <section aria-labelledby="latest-traces">
    <h2 class="k-section-title" id="latest-traces">آخر الـ traces</h2>
    <p class="k-section-intro">أحدث قرارات الجدار الأمني والموافقات من سجل Kernel.</p>
    <div class="k-runtime-panel"><a href="/kernel/audit/">فتح السجل الكامل</a></div>
  </section>

  <!-- Unit Cards -->
  <h2 class="k-section-title">وحدات Kernel</h2>
  <div class="k-units">
    {kernelNavItems.map((item, i) => {
      const links = getCrossLinks(item);
      return (
        <a href={item.path} class="k-unit-card gsap-fade" data-gsap-delay={String(i * 60)}>
          <div class="k-unit-card__icon" aria-hidden="true">
            <Fragment set:html={item.iconSvg} />
          </div>
          <div class="k-unit-card__label">{item.label}</div>
          <div class="k-unit-card__desc">{item.shortDescription}</div>
          <div class="k-unit-card__links">
            {links.solutionPath && <a href={links.solutionPath} class="k-unit-card__link" onclick="event.stopPropagation()">الحل ←</a>}
            <a href={links.docPath} class="k-unit-card__link" onclick="event.stopPropagation()">التوثيق ←</a>
          </div>
        </a>
      );
    })}
  </div>

  <section aria-labelledby="kernel-docs">
    <h2 class="k-section-title" id="kernel-docs">وثائق تشغيل Kernel</h2>
    <p class="k-section-intro">أدلة مرجعية تشرح إعداد السياسات والموافقات والسجلات والتقارير لكل فريق مسؤول. <a href="/docs/">كل الوثائق</a></p>
    <p class="k-section-intro">راجع أدلة المحادثة الآمنة، السياسات، الموافقات، سجل التدقيق، الامتثال، الموصلات، الأدلة، التقارير، السيناريوهات، والمؤشرات.</p>
    <nav class="k-doc-links" aria-label="وثائق تشغيل Kernel">
      <a href="/docs/kernel-chat/">المحادثة الآمنة</a>
      <a href="/docs/kernel-policies/">السياسات</a>
      <a href="/docs/kernel-approvals/">الموافقات</a>
      <a href="/docs/kernel-audit-trail/">سجل التدقيق</a>
      <a href="/docs/kernel-compliance/">الامتثال</a>
      <a href="/docs/kernel-connectors/">الموصلات</a>
      <a href="/docs/kernel-evidence/">الأدلة</a>
      <a href="/docs/kernel-reports/">التقارير</a>
      <a href="/docs/kernel-scenarios/">السيناريوهات</a>
      <a href="/docs/kernel-stats/">المؤشرات</a>
    </nav>
  </section>

  <!-- Cross-links to Solutions & Docs -->
  <div class="k-cross-links">
    <a href="/solutions/ai-governance-platform/">
      <strong>حلول الحوكمة</strong>
      تعرّف على حلول BrightAI لإدارة حوكمة الذكاء الاصطناعي
    </a>
    <a href="/docs/kernel-architecture/">
      <strong>توثيق Kernel</strong>
      الدليل التقني لمعمارية Kernel وإعدادها وتشغيلها
    </a>
    <a href="/contact/">
      <strong>احجز استشارة</strong>
      تحدث مع فريق BrightAI عن متطلبات حوكمة الذكاء الاصطناعي
    </a>
  </div>

  <!-- GSAP: dynamic import, idle, reduced-motion, cleanup -->
  <script>
    let gsapCtx: any = null;

    function handleKernelShortcuts(event: KeyboardEvent) {
      const target = event.target as HTMLElement | null;
      if (target?.matches('input, textarea, select, [contenteditable="true"]')) return;

      const overlay = document.getElementById('shortcut-overlay');
      if (event.key === '?' && !event.ctrlKey && !event.metaKey) {
        const isOpen = overlay?.classList.toggle('open') ?? false;
        overlay?.setAttribute('aria-hidden', String(!isOpen));
        return;
      }
      if (event.key === 'Escape') {
        overlay?.classList.remove('open');
        overlay?.setAttribute('aria-hidden', 'true');
        return;
      }
      if (event.ctrlKey || event.metaKey || event.altKey) return;

      const routes: Record<string, string> = {
        c: '/kernel/chat/',
        a: '/kernel/approvals/',
        t: '/kernel/audit/',
        s: '/kernel/stats/',
      };
      const key = event.key.toLowerCase();
      if (routes[key]) window.location.href = routes[key];
      if (key === 'r') window.location.reload();
    }

    function handleShortcutBackdrop(event: MouseEvent) {
      const overlay = document.getElementById('shortcut-overlay');
      if (event.target !== overlay) return;
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
    }

    function initKernelShortcuts() {
      const overlay = document.getElementById('shortcut-overlay');
      overlay?.removeEventListener('click', handleShortcutBackdrop);
      overlay?.addEventListener('click', handleShortcutBackdrop);
      document.removeEventListener('keydown', handleKernelShortcuts);
      document.addEventListener('keydown', handleKernelShortcuts);
    }

    async function initGSAP() {
      const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (mq.matches) return;

      const cards = document.querySelectorAll('.gsap-fade');
      if (!cards.length) return;

      // تحميل المكتبات ديناميكياً لتسريع تحميل الصفحة الأولي
      const { default: gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');

      gsap.registerPlugin(ScrollTrigger);

      // تسجيل مراجع المكتبات عالمياً لضمان عثور سكريبت التنظيف عليها
      const w = window as any;
      w.gsap = gsap;
      w.ScrollTrigger = ScrollTrigger;

      // تدمير السياق القديم إن وجد لمنع التراكم
      if (gsapCtx) {
        gsapCtx.revert();
      }

      // إنشاء سياق جديد للحركات
      gsapCtx = gsap.context(() => {
        cards.forEach((el) => {
          el.setAttribute('data-gsap-ready', '');
          const delay = parseInt((el as HTMLElement).dataset.gsapDelay || '0', 10);
          gsap.fromTo(el,
            { opacity: 0, y: 20 },
            { 
              opacity: 1, 
              y: 0, 
              duration: 0.5, 
              delay: delay / 1000, 
              ease: 'power2.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                toggleActions: 'play none none none'
              }
            }
          );
        });
      });

      ScrollTrigger.refresh();
    }

    // تشغيل التهيئة عند تحميل الصفحة
    document.addEventListener('astro:page-load', () => {
      initGSAP();
      initKernelShortcuts();
    });

    // تنظيف سياقي قبل استبدال الصفحة
    document.addEventListener('astro:before-swap', () => {
      if (gsapCtx) {
        gsapCtx.revert();
        gsapCtx = null;
      }
      document.getElementById('shortcut-overlay')?.removeEventListener('click', handleShortcutBackdrop);
      document.removeEventListener('keydown', handleKernelShortcuts);
    });
  </script>
</KernelLayout>
