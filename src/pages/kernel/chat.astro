---
/**
 * /kernel/chat/ — Secure AI chat with governance controls (REPORTS-14).
 * Uses canonical shell: page-header + KPI strip + chat panel.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelStatusStrip from '../../components/kernel/KernelStatusStrip.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelEmptyState from '../../components/kernel/KernelEmptyState.astro';
import { getKernelUnit } from '../../data/kernel';

const unit = getKernelUnit('chat')!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `BrightAI Kernel - ${unit.label}`,
  url: unit.canonical,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  description: unit.description,
};

const iconChat = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>';
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      <p class="kernel-page-header__subtitle">
        ابدأ محادثة مع الذكاء الاصطناعي تحت ضوابط الحوكمة الكاملة: كشف PII، تقييم المخاطر، تطبيق السياسات، وإنشاء الأدلة تلقائياً.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in">
    <KernelStatusStrip
      kicker="NVIDIA"
      title="Connected · Model loaded"
      dot="ok"
      items={[
        { label: 'الوضع', value: 'Production' },
        { label: 'الـ Provider', value: 'nvidia' },
        { label: 'Model', value: 'minimaxai/minimax-m2.7' },
      ]}
    />

    <article class="kernel-card kernel-card--accent" style="min-block-size: 60vh;">
      <div class="kernel-card__body" data-chat-messages>
        <KernelEmptyState
          title="ابدأ محادثة آمنة"
          message="اكتب سؤالك في الأسفل. كل رسالة تمر عبر فلتر PII، تقييم المخاطر، وفحص السياسات قبل إرسالها للنموذج."
          ctaLabel="جرّب سيناريو جاهز"
          ctaHref="/kernel/scenarios/"
          iconSvg={iconChat}
        />
      </div>
      <footer class="kernel-card__footer">
        <span>اختصار: <kbd>C</kbd> لمحادثة جديدة · <kbd>Enter</kbd> للإرسال · <kbd>Shift+Enter</kbd> لسطر جديد</span>
        <a href="/kernel/scenarios/" class="kernel-card__footer-link">جرّب سيناريو جاهز ←</a>
      </footer>
    </article>
  </div>
</KernelLayout>