---
/**
 * /kernel/audit/ — Audit log + hash chain verification (REPORTS-14).
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelStatusStrip from '../../components/kernel/KernelStatusStrip.astro';
import KernelCard from '../../components/kernel/KernelCard.astro';
import KernelActivityList from '../../components/kernel/KernelActivityList.astro';
import KernelActivityItem from '../../components/kernel/KernelActivityItem.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelSkeleton from '../../components/kernel/KernelSkeleton.astro';
import { getKernelUnit } from '../../data/kernel';

const unit = getKernelUnit('audit')!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `BrightAI Kernel - ${unit.label}`,
  url: unit.canonical,
  applicationCategory: 'BusinessApplication',
  description: unit.description,
};

const iconShield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>';
const iconWarning = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
const iconClock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
const iconCheck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const iconArrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      <p class="kernel-page-header__subtitle">
        سلسلة قرارات الذكاء الاصطناعي مع تحقق hash chain، Trace Timeline للمراحل الست، وفلاتر متقدمة للقسم والمخاطر.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
      <button class="kernel-card__footer-link" type="button" disabled aria-label="نسخ Trace ID">نسخ Trace ID</button>
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in">
    <KernelStatusStrip
      kicker="Hash Chain"
      title="VALID · سلسلة مطابقة بصرياً"
      dot="ok"
      items={[
        { label: 'إجمالي السجلات', value: '12,483' },
        { label: 'آخر سجل', value: 'قبل 12 ثانية' },
      ]}
    />

    <KernelCard
      title="Trace Timeline"
      subtitle="6 مراحل لكل طلب · REQUEST_RECEIVED → EVIDENCE_GENERATED"
      iconSvg={iconShield}
    >
      <div class="kernel-card__body">
        <KernelActivityList>
          <KernelActivityItem
            title="REQUEST_RECEIVED — مستخدم من قسم التسويق، طلب تصدير قائمة 2,400 عميل"
            traceId="AI-2026-10493"
            meta="قبل 3د"
            iconSvg={iconClock}
          />
          <KernelActivityItem
            title="PII_SCANNED — تم كشف 1,847 سجل يحتوي PII (اسم، هاتف، بريد، عنوان)"
            traceId="AI-2026-10493"
            meta="قبل 3د"
            iconSvg={iconWarning}
            tone="warning"
          />
          <KernelActivityItem
            title="RISK_SCORED — درجة المخاطر 87% (حرج) — تجاوز عتبة 70%"
            traceId="AI-2026-10493"
            meta="قبل 3د"
            iconSvg={iconWarning}
            tone="danger"
          />
          <KernelActivityItem
            title="APPROVAL_REQUESTED — طلب موافقة بشرية بسبب درجة المخاطر الحرجة"
            traceId="AI-2026-10493"
            meta="قبل 3د"
            iconSvg={iconClock}
          />
          <KernelActivityItem
            title="MODEL_CALLED — لم يُستدعى النموذج — تم الحظر قبل الإرسال"
            traceId="AI-2026-10493"
            meta="قبل 3د"
            iconSvg={iconCheck}
          />
          <KernelActivityItem
            title="EVIDENCE_GENERATED — تم توليد ملف دليل EVD-2026-10493.pdf"
            traceId="AI-2026-10493"
            meta="قبل 3د"
            iconSvg={iconCheck}
            tone="success"
          />
        </KernelActivityList>
      </div>
      <Fragment slot="footer">
        <footer class="kernel-card__footer">
          <span>Hash: 0xa7c8f2e9...d41b</span>
          <a href="/kernel/evidence/" class="kernel-card__footer-link">افتح ملف الدليل {iconArrow}</a>
        </footer>
      </Fragment>
    </KernelCard>
  </div>
</KernelLayout>