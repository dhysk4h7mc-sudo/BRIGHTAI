---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../data/i18n-pairs';
import { legal_terms } from '../../data/legal-content-inline';
const route = '/terms/';
const canonical = `https://brightai.site${route}`;
const legalContent = legal_terms;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
]};
---
<ArabicLayout title="شروط استخدام BrightAI وخدمات حوكمة AI | BrightAI" description="راجع شروط استخدام موقع وخدمات BrightAI، بما يشمل مسؤوليات المستخدم، حدود الخدمة، ومتطلبات الاستخدام المقبول لحلول حوكمة الذكاء الاصطناعي، دون تعقيد زائد." canonical={canonical} hreflang={getLegalAlternates(route, 'ar')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)}>
  <div class="legal-page" set:html={legalContent.html} />
</ArabicLayout>
