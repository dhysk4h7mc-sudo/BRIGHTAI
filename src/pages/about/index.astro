---
/**
 * About Page — /about/
 * BrightAI company story, mission, team, regulatory knowledge.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';

const crumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'من نحن' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "عن BrightAI — شركة سعودية متخصصة في أمان وحوكمة الذكاء الاصطناعي",
  "description": "تعرف على BrightAI ومنهجيتها في مساعدة الجهات السعودية على تشغيل الذكاء الاصطناعي بثقة، مع حوكمة واضحة، حماية بيانات، وأدلة امتثال قابلة للمراجعة.",
  "url": "https://brightai.site/about/",
  "mainEntity": {
    "@type": "Organization",
    "name": "BrightAI",
    "url": "https://brightai.site",
    "logo": "https://brightai.site/favicon.svg",
    "description": "Saudi AI Safety OS — منصة أمان وحوكمة الذكاء الاصطناعي للشركات السعودية",
    "address": { "@type": "PostalAddress", "addressCountry": "SA" }
  }
};
---

<ArabicLayout
  title="BrightAI لحوكمة الذكاء الاصطناعي في السعودية | BrightAI"
  description="تعرف على BrightAI ومنهجيتها في مساعدة الجهات السعودية على تشغيل الذكاء الاصطناعي بثقة، مع حوكمة واضحة، حماية بيانات، وأدلة امتثال قابلة للمراجعة."
  canonical="https://brightai.site/about/"
  hreflang={[{lang:'ar-SA',href:'https://brightai.site/about/'},{lang:'x-default',href:'https://brightai.site/about/'}]}
  jsonLd={jsonLd as any}
  currentPath="/about/"
>
<style is:global>@import '../../styles/inner-pages.css';</style>

{/* Hero */}
<section class="inner-hero" aria-label="عن BrightAI">
  <BackgroundGrid />
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <Breadcrumbs crumbs={crumbs} />
    <div class="inner-hero__badge">
      <iconify-icon icon="lucide:flag"></iconify-icon>
      شركة سعودية تبني ثقة AI داخل المؤسسات
    </div>
    <h1>شركة سعودية تبني <span class="home-gradient-text">طبقة أمان AI</span> بين الموظف وبيانات الشركة</h1>
    <p class="inner-hero__desc">
      <strong>الزبدة:</strong> BrightAI مواليد المملكة، ونبني <strong>Saudi AI Safety OS</strong> — نظام أمان وحوكمة يضمن إن كل استخدام للذكاء الاصطناعي داخل شركتك يكون آمن، موثّق، وخاضع لضوابط واضحة. تستخدم AI بثقة بدون ما تخسر السيطرة على البيانات أو القرارات أو الامتثال.
    </p>
    <div class="inner-hero__actions">
      <a href="/contact/" class="home-glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold">
        <iconify-icon icon="mdi:calendar-check"></iconify-icon> ابدأ ديمو خاص بشركتك
      </a>
      <a href="https://wa.me/966538229013" target="_blank" rel="noopener noreferrer" class="home-wa-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white">
        <iconify-icon icon="mdi:whatsapp"></iconify-icon> تواصل عبر واتساب
      </a>
    </div>
  </div>
</section>

{/* Story Section */}
<section class="inner-section" aria-labelledby="founder-story">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="grid lg:grid-cols-5 gap-6">
      <article class="lg:col-span-3 inner-card p-8">
        <p class="inner-section__label">القصة</p>
        <h2 id="founder-story" class="inner-section__title">قصتنا: كيف ولدت فكرة Saudi AI Safety OS كأول نظام أمان AI للشركات في المملكة؟</h2>
        <p class="inner-card__text text-base leading-loose mt-4">بدأت BrightAI لأنّي شفت فجوة واضحة: الشركات تبغى تستخدم الذكاء الاصطناعي، لكن تخاف من تسريب البيانات، القرارات غير الموثقة، والمخاطر التنظيمية. بدل ما يكون AI مجرد أداة دردشة، لازم يصير نظام تشغيل آمن داخل المؤسسة.</p>
        <p class="inner-card__text text-base leading-loose mt-3">الفكرة بالنسبة لي مو بناء موقع جميل فقط. الفكرة أن شركة سعودية تقدر تبني طبقة ثقة بين الإنسان والذكاء الاصطناعي: من يستخدم AI؟ على أي بيانات؟ من وافق؟ وكيف نثبت أن القرار مرّ بالطريقة الصحيحة؟</p>
        <p class="inner-card__text text-base leading-loose mt-3">رحلة يزيد تمثل نموذجاً نادراً في المنطقة: مؤسس سعودي بعمر ٢٧ سنة يحاول بناء شركة ذكاء اصطناعي متكاملة من شخص واحد، بخطوات عملية ومحتوى ومنتج وتصور تجاري واضح.</p>
      </article>

      <aside class="lg:col-span-2 inner-card" style="border-color: rgba(34, 211, 238, 0.22);">
        <div style="width:74px;height:74px;border-radius:18px;display:grid;place-items:center;color:#02111f;background:linear-gradient(135deg,#22d3ee,#a78bfa);font-weight:950;font-size:1.8rem;margin-bottom:1rem;">ي</div>
        <h2 class="text-2xl font-bold text-white mb-2">يزيد</h2>
        <p class="text-cyan-300 font-bold mb-5">Founder of BrightAI</p>
        <div class="inner-grid inner-grid--2">
          <div class="inner-card"><span class="text-xs text-white/50">العمر</span><strong class="text-white block">٢٧ سنة</strong></div>
          <div class="inner-card"><span class="text-xs text-white/50">الدور</span><strong class="text-white block">Founder</strong></div>
          <div class="inner-card"><span class="text-xs text-white/50">الموقع</span><strong class="text-white block">السعودية</strong></div>
          <div class="inner-card"><span class="text-xs text-white/50">التركيز</span><strong class="text-white block">AI Safety OS</strong></div>
        </div>
      </aside>
    </div>
  </div>
</section>

{/* Mission & Vision */}
<section class="inner-section inner-section--alt" aria-labelledby="about-details">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <p class="inner-section__label">من نحن</p>
    <h2 id="about-details" class="inner-section__title">عن BrightAI ورؤيتنا الوطنية</h2>
    <p class="inner-section__lead">Saudi AI Safety OS (BrightAI) هي المنصة السعودية الأولى المتخصصة في حوكمة وأمان الذكاء الاصطناعي للمؤسسات والشركات الكبرى والقطاعات الحكومية في المملكة. نسعى جاهدين لتحقيق ريادة الابتكار المسؤول تحت مظلة الاستراتيجية الوطنية للبيانات والذكاء الاصطناعي ورؤية السعودية 2030.</p>
    <div class="inner-grid inner-grid--2">
      <article class="inner-card p-8">
        <p class="text-cyan-300 font-bold mb-3">رسالتنا</p>
        <h3 class="inner-card__title text-xl">تمكين المؤسسات بثقة وأمان</h3>
        <p class="inner-card__text">توفير طبقة حماية وحوكمة تشغيلية متطورة (AI Safety OS) تتيح للشركات تبني الذكاء الاصطناعي بأمان مطلق، مع الحفاظ الكامل على خصوصية البيانات وحق المراجعة البشرية وقابلية التدقيق المستمر.</p>
      </article>
      <article class="inner-card p-8">
        <p class="text-emerald-300 font-bold mb-3">رؤيتنا لـ 2030</p>
        <h3 class="inner-card__title text-xl">بناء السيادة الرقمية والابتكار المسؤول</h3>
        <p class="inner-card__text">أن نكون المعيار الأول والمعتمد لحوكمة الذكاء الاصطناعي في الشرق الأوسط، مساهمين بتمكين الجهات والشركات من الامتثال للأنظمة والتشريعات المحلية وقيادة الحوكمة المسؤولة عالمياً.</p>
      </article>
    </div>
  </div>
</section>

{/* Stats */}
<section class="inner-section" aria-labelledby="our-expertise">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <p class="inner-section__label">خبرتنا بالأرقام</p>
    <h2 id="our-expertise" class="inner-section__title">حوكمة تشغيلية موثقة ومعايير قياسية</h2>
    <p class="inner-section__lead">نمتلك خبرة عميقة وتخصصية في بناء وتطوير جدران الحماية للذكاء الاصطناعي (AI Firewall) وسجلات التدقيق المشفرة. قمنا بتطوير "النواة الأمنية" لتكون متوافقة بالكامل مع المتطلبات التنظيمية الصارمة.</p>
    <div class="inner-grid inner-grid--4">
      <div class="inner-stat"><div class="inner-stat__value">+١٥</div><div class="inner-stat__label">عميل مؤسسي وحكومي</div></div>
      <div class="inner-stat"><div class="inner-stat__value">+٣٦٥</div><div class="inner-stat__label">يوم تشغيل آمن</div></div>
      <div class="inner-stat"><div class="inner-stat__value">+١٢K</div><div class="inner-stat__label">نقطة تدقيق مفحوصة</div></div>
      <div class="inner-stat"><div class="inner-stat__value">{'<'}١٢٠ms</div><div class="inner-stat__label">زمن استجابة طبقة الأمان</div></div>
    </div>
  </div>
</section>

{/* Regulatory Knowledge */}
<section class="inner-section inner-section--alt" aria-labelledby="regulatory-knowledge">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <p class="inner-section__label">ماذا نعرف؟</p>
    <h2 id="regulatory-knowledge" class="inner-section__title">معرفة تنظيمية شاملة وامتثال تشريعي صارم</h2>
    <p class="inner-section__lead">تتميز منصة BrightAI بالامتثال الفوري للأنظمة والضوابط الصادرة عن الجهات التشريعية والتنظيمية في المملكة العربية السعودية والعالم:</p>
    <div class="inner-grid inner-grid--3">
      <article class="inner-card"><h3 class="inner-card__title">نظام حماية البيانات الشخصية (PDPL)</h3><p class="inner-card__text">معالجة دقيقة لخصوصية البيانات، وإخفاء تلقائي لمعلومات الهوية الشخصية (PII Redaction) لضمان عدم تسريب البيانات الحساسة للجهات الخارجية.</p></article>
      <article class="inner-card"><h3 class="inner-card__title">ضوابط الأمن السيبراني (NCA ECC)</h3><p class="inner-card__text">الالتزام التام بضوابط الهيئة الوطنية للأمن السيبراني، مع توفير سجلات وصول وتدقيق مشفرة ومحمية لا يمكن التلاعب بها أو تعديلها.</p></article>
      <article class="inner-card"><h3 class="inner-card__title">إرشادات سدايا (SDAIA)</h3><p class="inner-card__text">التوافق الكامل مع المبادئ التوجيهية للذكاء الاصطناعي التوليدي الصادرة عن الهيئة السعودية للبيانات والذكاء الاصطناعي لضمان الشفافية والعدالة.</p></article>
      <article class="inner-card"><h3 class="inner-card__title">نظام الجودة الطبية (ISO 13485 & SFDA)</h3><p class="inner-card__text">إدارة دورة حياة المنتجات والجودة للمصانع الطبية والمستشفيات، وسجلات المرفوضات والامتثال لمتطلبات هيئة الغذاء والدواء السعودية.</p></article>
      <article class="inner-card"><h3 class="inner-card__title">معيار الحوكمة العالمي (ISO/IEC 42001)</h3><p class="inner-card__text">أول نظام إدارة معتمد عالمياً لحوكمة الذكاء الاصطناعي، يضمن تطبيق أفضل الممارسات الدولية في تقييم المخاطر وتطوير النماذج.</p></article>
      <article class="inner-card"><h3 class="inner-card__title">شهادات الأمان والتدقيق (SOC 2 Type II)</h3><p class="inner-card__text">تصميم أمني قوي يضمن أعلى مستويات حماية البيانات الحساسة وسرية المعلومات وفق الضوابط العالمية والمحلية الحساسة.</p></article>
    </div>
  </div>
</section>

{/* Team */}
<section class="inner-section" aria-labelledby="about-team-title">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <p class="inner-section__label">فريقنا</p>
    <h2 id="about-team-title" class="inner-section__title">خبراء الأمن السيبراني وحوكمة الذكاء الاصطناعي خلف المنصة</h2>
    <p class="inner-section__lead">يجمع فريق BrightAI نخبة من المهندسين والمستشارين المتخصصين في حوكمة النظم الذكية، أمن المعلومات، والالتزام التنظيمي.</p>
    <div class="inner-grid inner-grid--3">
      <div class="inner-card text-center">
        <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#22d3ee,#7c5cff);display:grid;place-items:center;color:#020617;font-size:1.75rem;font-weight:900;margin:0 auto 1rem;">ي</div>
        <p class="text-cyan-300 font-bold text-sm mb-1">Founder of BrightAI</p>
        <h3 class="inner-card__title">يزيد الشمري</h3>
        <p class="inner-card__text">مؤسس BrightAI. متخصص في بناء أنظمة أمان الذكاء الاصطناعي وحوكمة الاستخدام المؤسسي للذكاء الاصطناعي في الشركات السعودية.</p>
      </div>
      <div class="inner-card text-center">
        <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#22d3ee,#7c5cff);display:grid;place-items:center;color:#020617;font-size:1.75rem;font-weight:900;margin:0 auto 1rem;">ع</div>
        <p class="text-cyan-300 font-bold text-sm mb-1">مستشار حوكمة AI</p>
        <h3 class="inner-card__title">د. عبد الرحمن الحربي</h3>
        <p class="inner-card__text">خبير في حوكمة الذكاء الاصطناعي والامتثال التنظيمي، مع خبرة واسعة في ضوابط NCA وSDAIA والأنظمة السعودية.</p>
      </div>
      <div class="inner-card text-center">
        <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#22d3ee,#7c5cff);display:grid;place-items:center;color:#020617;font-size:1.75rem;font-weight:900;margin:0 auto 1rem;">س</div>
        <p class="text-cyan-300 font-bold text-sm mb-1">أخصائية أمن معلومات</p>
        <h3 class="inner-card__title">أ. سارة الدوسري</h3>
        <p class="inner-card__text">متخصصة في أمن المعلومات وحماية البيانات الشخصية (PDPL)، مع تركيز على تصميم ضوابط حماية فعالة داخل المؤسسات.</p>
      </div>
    </div>
  </div>
</section>

{/* CTA */}
<section class="inner-cta-final">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-cta-final__card">
      <h2 class="inner-cta-final__title">جاهز تعرف كيف BrightAI تحمي شركتك؟</h2>
      <p class="inner-cta-final__desc">احجز جلسة استشارية مجانية مع فريقنا واكتشف كيف نقدر نساعدك تبني طبقة أمان وحوكمة للذكاء الاصطناعي داخل مؤسستك.</p>
      <div class="inner-hero__actions" style="justify-content:center;">
        <a href="/contact/" class="home-glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold">
          <iconify-icon icon="mdi:calendar-check"></iconify-icon> احجز ديمو
        </a>
        <a href="https://wa.me/966538229013" target="_blank" rel="noopener noreferrer" class="home-wa-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white">
          <iconify-icon icon="mdi:whatsapp"></iconify-icon> واتساب
        </a>
      </div>
    </div>
  </div>
</section>

{/* CSS Reveal Observer */}
<script>
  const reveals = document.querySelectorAll('.inner-reveal');
  if (reveals.length && 'IntersectionObserver' in window) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.1 });
    reveals.forEach(el => obs.observe(el));
  } else { reveals.forEach(el => el.classList.add('is-visible')); }
</script>
</ArabicLayout>