---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { solutions, getRelatedSolutions, getRelatedSectors } from '../../data/solutions';
import { migratedSolutionPages } from '../../data/migratedSolutionPages';

export function getStaticPaths() {
  return solutions.map(s => ({ params: { slug: s.slug }, props: { solution: s } }));
}
const { solution } = Astro.props;
const migratedPage = migratedSolutionPages[solution.slug];
const migratedHtml = migratedPage?.html.replace(
  /href="https:\/\/wa\.me\/966538229013"\s+target="_blank"\s+rel="noopener noreferrer"(?=[^>]*class="glow-btn)/,
  'href="/contact/"',
);
const relSols = getRelatedSolutions(solution.slug);
const relSectors = getRelatedSectors(solution.slug);

const crumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'الحلول', href: '/solutions/' },
  { label: solution.title.split(' | ')[0] }
];

const jsonLd = {
  "@context":"https://schema.org",
  "@graph":[
    {"@type":"Service","@id":solution.canonical+"#service","name":solution.h1,"description":solution.description,"provider":{"@type":"Organization","name":"BrightAI","url":"https://brightai.site"},"url":solution.canonical,"areaServed":"Saudi Arabia"},
    {"@type":"BreadcrumbList","itemListElement":crumbs.map((c,i)=>({"@type":"ListItem","position":i+1,"name":c.label,"item":c.href?`https://brightai.site${c.href}`:solution.canonical}))},
    {"@type":["Organization","LocalBusiness"],"@id":"https://brightai.site/#organization","name":"BrightAI","url":"https://brightai.site","logo":"https://brightai.site/frontend/assets/images/logo.png","areaServed":"SA","sameAs":["https://twitter.com/BrightAISite","https://linkedin.com/company/brightai-site","https://github.com/brightai-site","https://crunchbase.com/organization/brightai"],"knowsAbout":["AI Governance","AI Safety","PDPL Compliance","NCA ECC Controls","ISO/IEC 42001","حوكمة الذكاء الاصطناعي في السعودية"]},
    ...(solution.content?.faqs ? [{"@type":"FAQPage","mainEntity":solution.content.faqs.map(faq=>({"@type":"Question","name":faq.question,"acceptedAnswer":{"@type":"Answer","text":faq.answer}}))}] : [])
  ]
};
---
<ArabicLayout
  title={migratedPage?.title ?? solution.title}
  description={migratedPage?.description ?? solution.description}
  canonical={migratedPage?.canonical ?? solution.canonical}
  hreflang={migratedPage?.hreflang ?? [{lang:'ar-SA',href:solution.canonical},{lang:'x-default',href:solution.canonical}]}
  jsonLd={(migratedPage?.jsonLd ?? jsonLd) as any}
  currentPath={solution.href}
  ogImage="/frontend/assets/images/og/og-solutions.png"
  ogImageAlt={migratedPage?.title ?? solution.title}
>
<style is:global>@import '../../styles/inner-pages.css';</style>

{migratedPage ? (
  <main class="migrated-legacy-content" set:html={migratedHtml} />
) : (
<>
<section class="inner-hero" aria-label={solution.h1}>
  <BackgroundGrid />
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <Breadcrumbs crumbs={crumbs} />
    <div class="inner-hero__badge"><iconify-icon icon={solution.icon}></iconify-icon> {solution.chip}</div>
    <h1>{solution.h1}</h1>
    {solution.content ? solution.content.lead.map(paragraph => <p class="inner-hero__desc">{paragraph}</p>) : <p class="inner-hero__desc">{solution.description}</p>}
    <div class="inner-hero__actions">
      <a href="/contact/" class="home-glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold"><iconify-icon icon="mdi:calendar-check"></iconify-icon> اطلب عرض توضيحي</a>
      <a href="https://wa.me/966538229013" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white" style="background:linear-gradient(135deg,#25D366,#128C7E)"><iconify-icon icon="mdi:whatsapp"></iconify-icon> تواصل عبر واتساب</a>
    </div>
  </div>
</section>

{solution.content && (
  <>
    {solution.content.sections.map((section, sectionIndex) => (
      <section class:list={['inner-section', { 'inner-section--alt': sectionIndex % 2 === 0 }]} aria-labelledby={`content-${sectionIndex}`}>
        <div class="max-w-7xl mx-auto px-5 lg:px-8">
          <h2 id={`content-${sectionIndex}`} class="inner-section__title">{section.title}</h2>
          {section.intro && <p class="inner-section__lead">{section.intro}</p>}
          {section.cards && (
            <div class="inner-grid inner-grid--3">
              {section.cards.map(card => (
                <article class="inner-card p-6">
                  <h3 class="inner-card__title">{card.title}</h3>
                  {card.subtitle && <p>{card.subtitle}</p>}
                  {card.text && <p class="inner-card__text">{card.text}</p>}
                  {card.items && <ul>{card.items.map(item => <li>{item}</li>)}</ul>}
                </article>
              ))}
            </div>
          )}
          {section.paragraphs?.map(paragraph => <p class="inner-section__lead">{paragraph}</p>)}
          {section.title === 'جاهز ترى كيف تعمل المنصة في بيئتك؟' && <p><a href="https://wa.me/966538229013">اطلب ديمو تنفيذي عبر واتساب</a> · <a href="/contact/">تحدث مع فريق BrightAI</a></p>}
        </div>
      </section>
    ))}
    {solution.content.faqs && (
      <section class="inner-section" aria-labelledby="solution-faqs">
        <div class="max-w-4xl mx-auto px-5 lg:px-8">
          <h2 id="solution-faqs" class="inner-section__title">أسئلة تدور في ذهنك؟</h2>
          <div class="inner-faq">{solution.content.faqs.map(faq => <details><summary>{faq.question}</summary><div class="inner-faq__answer"><p>{faq.answer}</p></div></details>)}</div>
        </div>
      </section>
    )}
  </>
)}

<section class="inner-section inner-section--alt" aria-labelledby="problem">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="problem" class="inner-section__title"><iconify-icon icon="mdi:alert-circle" class="text-red-400"></iconify-icon> المشكلة</h2>
    <p class="inner-section__lead">متى تحتاج هذا الحل؟ {solution.whenNeeded}</p>
    <div class="inner-card p-8">
      <p class="inner-card__text text-base leading-loose">{solution.description} هذا الحل يهمك بشكل خاص لو مؤسستك تتعامل مع بيانات حساسة أو تخضع لضوابط تنظيمية سعودية.</p>
    </div>
  </div>
</section>

<section class="inner-section" aria-labelledby="how-it-works">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="how-it-works" class="inner-section__title"><iconify-icon icon="mdi:cog" class="text-cyan-300"></iconify-icon> كيف يشتغل داخل BrightAI Kernel</h2>
    <div class="inner-grid inner-grid--2">
      <div class="inner-card p-6"><h3 class="inner-card__title"><iconify-icon icon="mdi:check-circle" class="text-emerald-400 ml-2"></iconify-icon>المشكلة اللي يحلها</h3><p class="inner-card__text">{solution.shortDesc}</p></div>
      <div class="inner-card p-6"><h3 class="inner-card__title"><iconify-icon icon="mdi:shield-check" class="text-cyan-300 ml-2"></iconify-icon>ضوابط الامتثال</h3><p class="inner-card__text">يدعم جاهزية ضوابط NCA/SDAIA/SFDA وليس استشارة قانونية. يوفر طبقة تشغيل وتوثيق تساعد فرق الامتثال.</p></div>
    </div>
  </div>
</section>

<section class="inner-section inner-section--alt" aria-labelledby="kernel-integration">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="kernel-integration" class="inner-section__title">التكامل مع Kernel</h2>
    <div class="inner-grid inner-grid--3">
      {relSols.map(s => (
        <a href={s.href} class="inner-card p-6 text-center" style="text-decoration:none;color:inherit">
          <div class="text-3xl mb-3"><iconify-icon icon={s.icon} class="text-cyan-300"></iconify-icon></div>
          <h3 class="inner-card__title text-sm">{s.h1.split('(')[0].trim()}</h3>
          <p class="inner-card__text text-xs mt-2">{s.shortDesc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

{relSectors.length > 0 && (
<section class="inner-section" aria-labelledby="sector-use">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="sector-use" class="inner-section__title">تطبيقات قطاعية</h2>
    <div class="inner-grid inner-grid--2">
      {relSectors.map(sec => (
        <a href={sec.href} class="inner-card p-6" style="text-decoration:none;color:inherit">
          <h3 class="inner-card__title"><iconify-icon icon={sec.icon} class="text-cyan-300 ml-2"></iconify-icon>{sec.h1}</h3>
          <p class="inner-card__text">{sec.shortDesc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
)}

<RelatedLinks relatedSlugs={solution.related} sectorSlugs={relSectors.map(s=>s.slug)} docs={solution.docs} blog={solution.blog} kernel={solution.kernel} />

<section class="inner-cta-final">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-cta-final__card">
      <h2 class="inner-cta-final__title">{solution.content?.finalTitle ?? `ابدأ بـ ${solution.h1.split('(')[0].trim()} الآن`}</h2>
      <p class="inner-cta-final__desc">{solution.content?.finalText ?? 'تواصل معنا للحصول على عرض توضيحي مخصص لقطاعك.'}</p>
      <div class="inner-hero__actions" style="justify-content:center;">
        <a href="/contact/" class="home-glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold"><iconify-icon icon="mdi:calendar-check"></iconify-icon> اطلب عرض توضيحي</a>
        <a href="https://wa.me/966538229013" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white" style="background:linear-gradient(135deg,#25D366,#128C7E)"><iconify-icon icon="mdi:whatsapp"></iconify-icon> تواصل عبر واتساب</a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const reveals = document.querySelectorAll('.inner-reveal');
    if (reveals.length && 'IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } }); }, { threshold: 0.1 });
      reveals.forEach(el => obs.observe(el));
    } else { reveals.forEach(el => el.classList.add('is-visible')); }
  });
</script>
</>
)}
</ArabicLayout>
