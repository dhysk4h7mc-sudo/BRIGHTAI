---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
const crumbs = [{ label: 'الرئيسية', href: '/' }, { label: 'الديموهات' }];

const demoJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "LocalBusiness"],
    "@id": "https://brightai.site/#organization",
    "name": "BrightAI",
    "url": "https://brightai.site",
    "logo": "https://brightai.site/frontend/assets/images/logo.png",
    "areaServed": "SA",
    "sameAs": [
      "https://twitter.com/BrightAISite",
      "https://linkedin.com/company/brightai-site",
      "https://github.com/brightai-site",
      "https://crunchbase.com/organization/brightai"
    ],
    "knowsAbout": [
      "AI Governance","AI Safety","PDPL Compliance","NCA ECC Controls","ISO/IEC 42001","حوكمة الذكاء الاصطناعي في السعودية"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://brightai.site/demo/#webpage",
    "url": "https://brightai.site/demo/",
    "name": "جميع ديموهات BrightAI للذكاء الاصطناعي في السعودية",
    "description": "مركز ديموهات BrightAI: أكثر من 30 ديمو تفاعلي بالعربية للمبيعات، التوظيف، خدمة العملاء، تحليل البيانات، OCR، الرعاية الصحية، التعليم، والمناقصات.",
    "inLanguage": "ar-SA"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://brightai.site/demo/#breadcrumb",
    "itemListElement": [
      {"@type":"ListItem","position":1,"name":"BrightAI","item":"https://brightai.site/"},
      {"@type":"ListItem","position":2,"name":"جميع ديموهات BrightAI للذكاء الاصطناعي في السعودية","item":"https://brightai.site/demo/"}
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://brightai.site/demo/#faq",
    "mainEntity": [
      {"@type":"Question","name":"كم عدد الديموهات المتاحة؟","acceptedAnswer":{"@type":"Answer","text":"حالياً أكثر من ٣٠ ديمو تفاعلي موزعة على ٨ تصنيفات تجارية، وكلها مجانية ومتاحة فوراً."}},
      {"@type":"Question","name":"هل الديموهات مجانية؟","acceptedAnswer":{"@type":"Answer","text":"إيوه، كل الديموهات مجانية بالكامل. تقدر تجرب أي ديمو ببيانات وهمية وتشوف شكل التقرير قبل ما تقرر تطلب نسخة مخصصة."}},
      {"@type":"Question","name":"هل تدعم العربية؟","acceptedAnswer":{"@type":"Answer","text":"أكيد. كل الديموهات مبنية للعربية أولاً، مع دعم كامل للواجهة والمخرجات والنصوص المختلطة عربي-إنجليزي."}},
      {"@type":"Question","name":"وش وضع البيانات؟","acceptedAnswer":{"@type":"Answer","text":"بياناتك تبقى عندك. لا تستخدم إلا بيانات وهمية أو منزوعة الحساسية في النسخة العامة. النسخة المخصصة تنبني بصلاحيات وصول وسجل تدقيق."}},
      {"@type":"Question","name":"وش الفرق بين الديمو والنسخة المخصصة؟","acceptedAnswer":{"@type":"Answer","text":"الديمو يوريك الفكرة بعينات مبسطة، والنسخة المخصصة نضبطها على بيانات شركتك وتتكامل مع أنظمتك."}}
    ]
  }
];
---

<ArabicLayout
  title="جميع ديموهات BrightAI للذكاء الاصطناعي في السعودية"
  description="مركز ديموهات BrightAI: أكثر من 30 ديمو تفاعلي بالعربية للمبيعات، التوظيف، خدمة العملاء، تحليل البيانات، OCR، الرعاية الصحية، التعليم، والمناقصات."
  canonical="https://brightai.site/demo/"
  hreflang={[{lang:'ar-SA',href:'https://brightai.site/demo/'},{lang:'x-default',href:'https://brightai.site/demo/'}]}
  jsonLd={demoJsonLd as any}
  currentPath="/demo/"
>
<style is:global>@import '../../styles/inner-pages.css';</style>

<section class="inner-hero" aria-label="ديموهات BrightAI">
  <BackgroundGrid />
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <Breadcrumbs crumbs={crumbs} />
    <p class="inner-hero__eyebrow">هلا والله، نوّرت 👋</p>
    <h1>جرّب <span class="gradient-text">سيناريوهات AI حقيقية</span> قبل ما تقرر</h1>
    <p class="inner-hero__desc">أكبر مجموعة ديموهات ذكاء اصطناعي تفاعلية بالعربية في السعودية. اختر التصنيف اللي يناسب شغلك، شغّل سيناريو سعودي، وشوف كيف BrightAI يحمي بياناتك — بعدين قرّر.</p>
    <div class="inner-hero__points">
      <span>أكثر من 30 ديمو تفاعلي</span>
      <span>8 تصنيفات تجارية</span>
      <span>واجهة عربية من اليمين لليسار</span>
      <span>بيانات وهمية آمنة — لا تخزين</span>
    </div>
    <div class="inner-hero__actions">
      <a href="/contact/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold"><iconify-icon icon="mdi:calendar-check"></iconify-icon> احجز استشارة مجانية</a>
      <a href="https://wa.me/966538229013?text=%D9%87%D9%84%D8%A7%20%D9%88%D8%A7%D9%84%D9%84%D9%87%D8%8C%20%D8%A3%D8%A8%D8%BA%D9%89%20%D8%A3%D8%AC%D8%B1%D8%A8%20%D8%AF%D9%8A%D9%85%D9%88%D9%87%D8%A7%D8%AA%20Bright%20AI" target="_blank" rel="noopener noreferrer" class="wa-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white"><iconify-icon icon="mdi:whatsapp"></iconify-icon> اطلبها عبر واتساب</a>
    </div>
  </div>
</section>

<!-- تصفح سريع -->
<section class="inner-section" aria-labelledby="quick-browse">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="demo-quick-answer">
      <h2 id="quick-browse">تصفح سريع</h2>
      <dl>
        <div><dt>التصنيفات</dt><dd>٨ تصنيفات تشغيلية</dd></div>
        <div><dt>اللغة</dt><dd>عربية بالكامل</dd></div>
        <div><dt>الهدف</dt><dd>تجربة → قرار → تواصل</dd></div>
      </dl>
    </div>
  </div>
</section>

<!-- تصنيفات الديموهات -->
<section class="inner-section inner-section--alt" aria-labelledby="taxonomy-heading">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="taxonomy-heading" class="inner-section__title">تصنيفات الديموهات</h2>
    <p class="inner-section__lead">اختر التصنيف اللي يناسب قطاعك، أو استعرض الديموهات تحت كل تصنيف مباشرة.</p>
    <div class="inner-grid inner-grid--4">
      <div class="inner-card"><h3 class="inner-card__title">المبيعات والتسويق</h3><p class="inner-card__text">٦ ديموهات: تأهيل العملاء، اكتشاف الفرص، التسويق الذكي، تحليل المنافسين، وتحسين محركات البحث.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">التوظيف والموارد البشرية</h3><p class="inner-card__text">ديموهات: فرز السير الذاتية، تقييم المرشحين، وأتمتة مهام HR.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">خدمة العملاء</h3><p class="inner-card__text">أتمتة تصنيف المحادثات، اقتراح ردود ذكية، وتصعيد التذاكر.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">تحليل البيانات</h3><p class="inner-card__text">٥ ديموهات: تحليل تنفيذي، جودة البيانات، تحليل اجتماعي، وتحليل النصوص.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">OCR والوثائق</h3><p class="inner-card__text">استخراج الحقول من الفواتير والعقود والمستندات بالذكاء الاصطناعي.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">الرعاية الصحية</h3><p class="inner-card__text">إدارة المستشفيات الذكية، الأرشيف الطبي، ومؤشرات الجودة.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">التعليم والتدريب</h3><p class="inner-card__text">منصة تعليمية ذكية للمدارس ومراكز التدريب والجامعات.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">المناقصات والعقود</h3><p class="inner-card__text">تحليل شروط المناقصات، استخراج المخاطر، ونقاط القرار.</p></div>
    </div>
  </div>
</section>

<!-- ديموهات المبيعات والتسويق -->
<section class="inner-section" aria-labelledby="sales-heading">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="sales-heading" class="inner-section__title">ديموهات المبيعات والتسويق</h2>
    <div class="inner-grid inner-grid--3">
      <article class="inner-card"><h3 class="inner-card__title">BrightSales للمبيعات الذكية</h3><p class="inner-card__text">تأهيل الفرص وبناء رسائل متابعة وخطة إغلاق مبيعات.</p><div class="inner-card__footer"><a class="glow-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm" href="/contact/">احجز ديمو مخصص</a></div></article>
      <article class="inner-card"><h3 class="inner-card__title">وكيل اكتشاف الفرص</h3><p class="inner-card__text">اكتشاف فرص تجارية في بيانات السوق والمنافسين.</p><div class="inner-card__footer"><a class="glow-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm" href="/contact/">احجز ديمو مخصص</a></div></article>
      <article class="inner-card"><h3 class="inner-card__title">وكيل تسويق ذكي</h3><p class="inner-card__text">بناء خطط تسويقية وتحليل الجمهور باقتراح حملات.</p><div class="inner-card__footer"><a class="glow-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm" href="/contact/">احجز ديمو مخصص</a></div></article>
      <article class="inner-card"><h3 class="inner-card__title">نظام التسويق الذكي</h3><p class="inner-card__text">أتمتة حملات التسويق وتحليل أداء القنوات.</p><div class="inner-card__footer"><a class="glow-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm" href="/contact/">احجز ديمو مخصص</a></div></article>
      <article class="inner-card"><h3 class="inner-card__title">وكيل تحسين محركات البحث</h3><p class="inner-card__text">تحليل كلمات مفتاحية واستراتيجيات SEO للسعودية.</p><div class="inner-card__footer"><a class="glow-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm" href="/contact/">احجز ديمو مخصص</a></div></article>
      <article class="inner-card"><h3 class="inner-card__title">وكيل تحليل المنافسين</h3><p class="inner-card__text">رصد تحركات المنافسين وتحليل نقاط القوة والضعف.</p><div class="inner-card__footer"><a class="glow-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm" href="/contact/">احجز ديمو مخصص</a></div></article>
    </div>
  </div>
</section>

<!-- ديموهات التوظيف والموارد البشرية -->
<section class="inner-section inner-section--alt" aria-labelledby="hiring-heading">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="hiring-heading" class="inner-section__title">ديموهات التوظيف والموارد البشرية</h2>
    <div class="inner-grid inner-grid--2">
      <article class="inner-card"><h3 class="inner-card__title">نظام التوظيف الذكي</h3><p class="inner-card__text">فرز السير الذاتية، تقييم ملاءمة المرشحين، وبناء قائمة مقابلات عادلة.</p><div class="inner-card__footer"><a class="glow-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm" href="/contact/">احجز ديمو مخصص</a></div></article>
      <article class="inner-card"><h3 class="inner-card__title">أتمتة الموارد البشرية</h3><p class="inner-card__text">أتمتة المهام الإدارية: تقارير، إجازات، وطلبات الموظفين.</p><div class="inner-card__footer"><a class="glow-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm" href="/contact/">احجز ديمو مخصص</a></div></article>
