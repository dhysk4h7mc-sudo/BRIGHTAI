---
/**
 * Hub sub-pages — /hub/<slug>/
 * ai-governance, compliance, solutions, use-cases
 * Reads existing static HTML and wraps in ArabicLayout with CollectionPage JSON-LD.
 */
import fs from 'node:fs';
import path from 'node:path';
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getPublishedPosts } from '../../data/blog';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  const hubPages = [
    {
      slug: 'ai-governance',
      title: 'حوكمة الذكاء الاصطناعي | مركز محتوى BrightAI',
      description: 'الدليل الشامل لحوكمة الذكاء الاصطناعي في المؤسسات السعودية: التعريف، الأنظمة، خطوات التطبيق، وتقييم النضج.',
      tags: ['حوكمة الذكاء الاصطناعي'],
    },
    {
      slug: 'compliance',
      title: 'الامتثال السعودي للذكاء الاصطناعي | مركز محتوى BrightAI',
      description: 'شرح عملي للأنظمة السعودية المطبقة على الذكاء الاصطناعي: PDPL، NCA ECC، SDAIA، ساما، والزكاة.',
      tags: ['امتثال'],
    },
    {
      slug: 'solutions',
      title: 'الحلول التقنية لحوكمة AI | مركز محتوى BrightAI',
      description: 'AI Firewall، سجل التدقيق، الموافقات البشرية، ملف الأدلة — كل حل، متى تحتاجه، وكيف يشتغل.',
      tags: ['حلول'],
    },
    {
      slug: 'use-cases',
      title: 'حالات استخدام AI بالقطاعات السعودية | مركز محتوى BrightAI',
      description: 'كيف يشتغل AI في قطاعك: الصحة، البنوك، الحكومي، التعليم، المشتريات، والموارد البشرية.',
      tags: ['حالات استخدام'],
    },
  ];
  return hubPages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

// Read the existing static HTML file
const htmlPath = path.resolve(`hub/${page.slug}/index.html`);
let mainContent = '<p>محتوى المركز</p>';
try {
  const raw = fs.readFileSync(htmlPath, 'utf-8');
  const mainMatch = raw.match(/<main[^>]*>([\s\S]*?)<\/main>/i);
  if (mainMatch) mainContent = mainMatch[1];
} catch {
  mainContent = '<p>محتوى المركز قيد التحديث</p>';
}

// Get related blog posts by tags
const allPosts = getPublishedPosts();
const relatedPosts = allPosts.filter(post =>
  page.tags.some(tag => post.tags.some(pt => pt.includes(tag) || tag.includes(pt)))
).slice(0, 6);

const canonicalUrl = `${SITE.url}/hub/${page.slug}/`;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: canonicalUrl,
  name: page.title,
  description: page.description,
  inLanguage: 'ar-SA',
  isPartOf: { '@type': 'CollectionPage', url: `${SITE.url}/hub/` },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'مراكز المحتوى', item: `${SITE.url}/hub/` },
    { '@type': 'ListItem', position: 3, name: page.title, item: canonicalUrl },
  ],
};
---

<ArabicLayout
  title={page.title}
  description={page.description}
  canonical={canonicalUrl}
  hreflang={[{ lang: 'ar-SA', href: canonicalUrl }]}
  jsonLd={collectionLd}
  currentPath={`/hub/${page.slug}/`}
>
  <style is:global>
    .gradient-text { background: linear-gradient(135deg,#00d4ff,#7c5cff,#ff5ca7); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .hub-card { background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.01)); border:1px solid rgba(255,255,255,.08); border-radius:1.25rem; padding:2rem; transition: all .35s ease; display:block; color:inherit; text-decoration:none; height:100%; }
    .hub-card:hover { transform: translateY(-8px); border-color: rgba(0,212,255,.4); box-shadow: 0 25px 60px -20px rgba(0,212,255,.3); }
    .hub-icon { width:64px; height:64px; border-radius:1rem; display:flex; align-items:center; justify-content:center; font-size:1.8rem; margin-bottom:1.25rem; }
    .chip { padding:.25rem .75rem; border-radius:999px; font-size:.7rem; font-weight:700; display:inline-block; }
    .glass { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 1rem; backdrop-filter: blur(12px); }
    .section-kicker { color: var(--brand, #00d4aa); font-size: 0.8125rem; font-weight: 800; margin-block-end: 0.5rem; }
    .answer-block { background: rgba(0,212,255,0.04); border: 1px solid rgba(0,212,255,0.12); border-radius: 1rem; padding: 1.5rem; margin-block: 1.5rem; }
    .answer-block p { color: rgba(255,255,255,0.85); line-height: 1.9; }
    .toc a { display:block; padding: 0.4rem 0; color: rgba(255,255,255,0.6); text-decoration:none; font-size:0.875rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .toc a:hover { color: var(--brand, #00d4aa); }
    .anchor-link { color: var(--brand, #00d4aa); text-decoration: underline; }
    .sector-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 1rem; padding: 1.5rem; }
    .freshness { display: inline-flex; align-items: center; gap: 0.375rem; color: var(--brand, #00d4aa); font-size: 0.8125rem; font-weight: 600; }
    .pillar-body p { color: rgba(255,255,255,0.8); line-height: 1.9; }
    .pillar-body h2, .pillar-body h3 { color: #f8fafc; }
    .use-case { padding: 0.75rem; border-radius: 0.75rem; background: rgba(255,255,255,0.03); }
    iconify-icon { display:inline-block; flex-shrink:0; line-height:1; vertical-align:-.125em; }
    .hub-related { margin-block-start: 3rem; padding-block-start: 2rem; border-block-start: 1px solid rgba(255,255,255,0.08); }
    .hub-related h2 { color: #f8fafc; font-size: 1.5rem; margin-block-end: 1rem; }
    .hub-related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
    .hub-related-card { display: block; padding: 1rem; border: 1px solid rgba(255,255,255,0.08); border-radius: 0.75rem; text-decoration: none; color: inherit; transition: border-color 0.15s; }
    .hub-related-card:hover { border-color: var(--brand, #00d4aa); }
    .hub-related-card h3 { color: #f8fafc; font-size: 0.95rem; margin: 0; }
    .hub-related-card p { color: rgba(255,255,255,0.6); font-size: 0.8rem; margin: 0.25rem 0 0; }
    @media (max-width: 768px) {
      .grid.md\:grid-cols-2, .grid.lg\:grid-cols-12 { grid-template-columns: 1fr !important; }
      .grid.md\:grid-cols-3 { grid-template-columns: 1fr !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hub-card { transition: none; }
    }
  </style>
  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js" defer></script>

  <main id="main" class="max-w-7xl mx-auto px-5 lg:px-8 py-12" set:html={mainContent} />

  {relatedPosts.length > 0 && (
    <div class="hub-related max-w-7xl mx-auto px-5 lg:px-8 pb-12">
      <h2>📝 مقالات ذات صلة</h2>
      <div class="hub-related-grid">
        {relatedPosts.map(post => (
          <a href={`/blog/${post.slug}/`} class="hub-related-card">
            <span style="color: var(--brand, #00d4aa); font-size: 0.7rem; font-weight: 800;">{post.category}</span>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </div>
  )}
</ArabicLayout>