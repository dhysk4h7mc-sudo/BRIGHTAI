---
/**
 * Hub index — /hub/
 * Reads the existing static hub/index.html and injects the main content
 * into ArabicLayout with proper SEO/JSON-LD.
 */
import { hub_index } from '../../data/hub-content-inline';

import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { SITE } from '../../data/site';

const mainContent = hub_index.html;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: `${SITE.url}/hub/`,
  name: 'مراكز المحتوى المرجعية | BrightAI',
  description: '٤ مراكز محتوى تغطي حوكمة وأمان الذكاء الاصطناعي في السعودية.',
  inLanguage: 'ar-SA',
  hasPart: [
    { '@type': 'WebPage', url: `${SITE.url}/hub/ai-governance/`, name: 'حوكمة الذكاء الاصطناعي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/compliance/`, name: 'الامتثال السعودي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/solutions/`, name: 'الحلول التقنية' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/use-cases/`, name: 'حالات الاستخدام' },
  ],
};
---

<ArabicLayout
  title="مراكز المحتوى المرجعية | BrightAI"
  description="٤ مراكز محتوى مرجعية تغطي كل ما يخص حوكمة وأمان الذكاء الاصطناعي في السعودية: الحوكمة، الامتثال، الحلول التقنية، وحالات الاستخدام."
  canonical={`${SITE.url}/hub/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/hub/` }]}
  jsonLd={collectionLd}
  currentPath="/hub/"
>
  <style is:global>
    .gradient-text { background: linear-gradient(135deg,#00d4ff,#7c5cff,#ff5ca7); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .hub-card { background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.01)); border:1px solid rgba(255,255,255,.08); border-radius:1.25rem; padding:2rem; transition: all .35s ease; display:block; color:inherit; text-decoration:none; height:100%; }
    .hub-card:hover { transform: translateY(-8px); border-color: rgba(0,212,255,.4); box-shadow: 0 25px 60px -20px rgba(0,212,255,.3); }
    .hub-icon { width:64px; height:64px; border-radius:1rem; display:flex; align-items:center; justify-content:center; font-size:1.8rem; margin-bottom:1.25rem; }
    .chip { padding:.25rem .75rem; border-radius:999px; font-size:.7rem; font-weight:700; display:inline-block; }
    .glass { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 1rem; backdrop-filter: blur(12px); }
    svg.icon { display:inline-block; flex-shrink:0; line-height:1; vertical-align:-.125em; }
    @media (max-width: 768px) {
      .grid.md\:grid-cols-2 { grid-template-columns: 1fr !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hub-card { transition: none; }
    }
  </style>
  <main id="main" class="max-w-7xl mx-auto px-5 lg:px-8 py-12" set:html={mainContent} />
</ArabicLayout>