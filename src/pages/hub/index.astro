---
/**
 * Hub index — /hub/
 * Reads the existing static hub/index.html and injects the main content
 * into ArabicLayout with proper SEO/JSON-LD.
 */
import { hub_index } from '../../data/hub-content-inline';

import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { SITE } from '../../data/site';

const mainContent = hub_index.html;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: `${SITE.url}/hub/`,
  name: 'مراكز المحتوى المرجعية | BrightAI',
  description: '٤ مراكز محتوى تغطي حوكمة وأمان الذكاء الاصطناعي في السعودية.',
  inLanguage: 'ar-SA',
  hasPart: [
    { '@type': 'WebPage', url: `${SITE.url}/hub/ai-governance/`, name: 'حوكمة الذكاء الاصطناعي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/compliance/`, name: 'الامتثال السعودي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/solutions/`, name: 'الحلول التقنية' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/use-cases/`, name: 'حالات الاستخدام' },
  ],
};
---

<ArabicLayout
  title="مراكز المحتوى المرجعية | BrightAI"
  description="٤ مراكز محتوى مرجعية تغطي كل ما يخص حوكمة وأمان الذكاء الاصطناعي في السعودية: الحوكمة، الامتثال، الحلول التقنية، وحالات الاستخدام."
  canonical={`${SITE.url}/hub/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/hub/` }]}
  jsonLd={collectionLd}
  currentPath="/hub/"
>
  <style is:global>
    .gradient-text {
      background: linear-gradient(135deg, var(--brand), var(--brand-hover), #ff5ca7);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hub-card {
      background: var(--gradient-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-2xl);
      padding: var(--space-8);
      transition: border-color var(--duration-normal) var(--ease-out),
                  box-shadow var(--duration-normal) var(--ease-out),
                  transform var(--duration-normal) var(--ease-out);
      display: block;
      color: inherit;
      text-decoration: none;
      height: 100%;
    }
    .hub-card:hover {
      transform: translateY(-4px);
      border-color: var(--border-hover);
      box-shadow: var(--shadow-card-hover);
    }
    .hub-icon {
      width: 64px;
      height: 64px;
      border-radius: var(--radius-xl);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      margin-bottom: var(--space-5);
    }
    .chip {
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-full);
      font-size: var(--text-xs);
      font-weight: var(--weight-bold);
      display: inline-block;
    }
    .glass {
      background: var(--surface-soft);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      backdrop-filter: blur(var(--blur-md));
      -webkit-backdrop-filter: blur(var(--blur-md));
    }
    svg.icon {
      display: inline-block;
      flex-shrink: 0;
      line-height: 1;
      vertical-align: -.125em;
    }
    @media (max-width: 768px) {
      .grid.md\:grid-cols-2 { grid-template-columns: 1fr !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hub-card { transition: none; }
      .hub-card:hover { transform: none; box-shadow: none; }
    }
  </style>
  <main id="main" class="max-w-7xl mx-auto px-5 lg:px-8" style="padding-block: var(--space-8) var(--space-20);" set:html={mainContent} />
</ArabicLayout>