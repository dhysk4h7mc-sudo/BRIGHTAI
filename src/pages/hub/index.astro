---
/**
 * Hub index — /hub/
 * Reads the existing static hub/index.html and injects the main content
 * into ArabicLayout with proper SEO/JSON-LD.
 */
import { hub_index } from '../../data/hub-content-inline';

import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { SITE } from '../../data/site';
import { ORGANIZATION, getBreadcrumbLd } from '../../data/schema-helpers';

const mainContent = hub_index.html;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: `${SITE.url}/hub/`,
  name: 'مراكز محتوى AI | 4 محاور مرجعية',
  description: '4 مراكز محتوى مرجعية من BrightAI: حوكمة AI وامتثال سعودي وحلول تقنية وحالات استخدام. مرجعك الكامل والشامل في مكان واحد للسوق السعودي بأكمله.',
  inLanguage: 'ar-SA',
  hasPart: [
    { '@type': 'WebPage', url: `${SITE.url}/hub/ai-governance/`, name: 'حوكمة الذكاء الاصطناعي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/compliance/`, name: 'الامتثال السعودي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/solutions/`, name: 'الحلول التقنية' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/use-cases/`, name: 'حالات الاستخدام' },
  ],
};

// SCHEMA-ENHANCEMENT (REPORT-23): wrap into @graph with canonical Organization + BreadcrumbList.
const hubJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    collectionLd,
    ORGANIZATION,
    getBreadcrumbLd([
      { name: 'الرئيسية', href: '/' },
      { name: 'مراكز المحتوى', href: '/hub/' },
    ]),
  ],
};
---

<ArabicLayout
  title="مراكز محتوى AI | 4 محاور مرجعية"
  description="4 مراكز محتوى مرجعية من BrightAI: حوكمة AI وامتثال سعودي وحلول تقنية وحالات استخدام. مرجعك الكامل والشامل في مكان واحد للسوق السعودي بأكمله."
  canonical={`${SITE.url}/hub/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/hub/` }]}
  jsonLd={hubJsonLd as any}
  currentPath="/hub/"
>
  <main id="main" class="max-w-7xl mx-auto px-5 lg:px-8" style="padding-block: var(--space-8) var(--space-20);" set:html={mainContent} />
</ArabicLayout>