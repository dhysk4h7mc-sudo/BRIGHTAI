---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getLegalAlternates } from '../../data/i18n-pairs';
import { getLegalContent } from '../../data/legal-content';
const route = '/privacy-cookies/';
const canonical = `https://brightai.site${route}`;
const legalContent = getLegalContent('privacy-cookies/index.html', { start: '<header class="hero-section', end: '<footer' });
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
]};
---
<ArabicLayout title="سياسة الخصوصية وملفات الارتباط السعودية | BrightAI" description="راجع سياسة الخصوصية وملفات الارتباط في BrightAI لمعرفة كيفية جمع البيانات واستخدامها، وخيارات التحكم المتاحة لزوار الموقع والعملاء، مع خطوة تالية واضحة." canonical={canonical} hreflang={getLegalAlternates(route, 'ar')} jsonLd={jsonLd} currentPath={route}>
  <style is:global>@import '../../styles/legal-pages.css';</style>
  <div class="legal-page" set:html={legalContent.html} />
</ArabicLayout>
