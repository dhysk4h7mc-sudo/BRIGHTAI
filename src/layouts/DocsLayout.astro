---
import ArabicLayout from './ArabicLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import DocsRelatedLinks from '../components/DocsRelatedLinks.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ORGANIZATION, getHowToLd, getBreadcrumbLd } from '../data/schema-helpers';

interface Heading {
  depth: 2 | 3;
  slug: string;
  text: string;
}

interface RelatedDoc {
  slug: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  canonical: string;
  updated: Date;
  category: string;
  tldr: string;
  headings: Heading[];
  relatedDocs: RelatedDoc[];
  currentPath: string;
}

const {
  title,
  metaTitle,
  description,
  canonical,
  updated,
  category,
  tldr,
  headings,
  relatedDocs,
  currentPath,
} = Astro.props;

const techArticleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonical}#techarticle`,
  headline: title,
  description,
  mainEntityOfPage: canonical,
  dateModified: updated.toISOString().slice(0, 10),
  inLanguage: 'ar-SA',
  author: { '@type': 'Organization', name: 'BrightAI', url: 'https://brightai.site/' },
  publisher: { '@type': 'Organization', name: 'BrightAI', url: 'https://brightai.site/' },
};

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ar-SA',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['[data-speakable]'],
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    techArticleLd,
    webPageLd,
    // SCHEMA-ENHANCEMENT (REPORT-23): canonical Organization + BreadcrumbList for docs pages.
    ORGANIZATION,
    getBreadcrumbLd([
      { name: 'الرئيسية', href: '/' },
      { name: 'الوثائق', href: '/docs/' },
      { name: title, href: canonical },
    ]),
    // SCHEMA-ENHANCEMENT (REPORT-23): generic HowTo scaffold that any docs page can opt-into
    // by passing procedural content via the meta frontmatter. For now, we add a discovery
    // HowTo so docs qualify for HowTo rich result without fabricating step content.
    getHowToLd({
      canonical,
      name: `دليل BrightAI: ${title}`,
      description,
      steps: [
        { name: 'افهم المفهوم', text: `ابدأ بقراءة ${title} من BrightAI لفهم المفهوم والسياق.` },
        { name: 'طبّق على بيئتك', text: 'استخدم السياسة أو الضوابط في شركتك ووثّق التطبيق.' },
        { name: 'وثّق وسجّل', text: 'فعّل سجل التدقيق وملف الأدلة لإثبات الامتثال.' },
      ],
    }),
  ],
};

// BreadcrumbList is already generated by the Breadcrumbs component — no duplicate needed here.
---

<ArabicLayout
  title={metaTitle}
  description={description}
  canonical={canonical}
  hreflang={[{ lang: 'ar-SA', href: canonical }]}
  jsonLd={jsonLd}
  currentPath={currentPath}
>
  <div class="article-shell article-shell--wide">
    <div class="article-breadcrumbs">
      <Breadcrumbs crumbs={[
        { label: 'الرئيسية', href: '/' },
        { label: 'الوثائق', href: '/docs/' },
        { label: title },
      ]} />
    </div>

    <header class="article-hero" style="max-width:58rem;">
      <p class="article-hero__category">{category}</p>
      <h1>{title}</h1>
      <p class="article-hero__desc">{description}</p>
    </header>

    <section class="article-tldr" aria-labelledby="docs-tldr-title" data-speakable style="max-width:58rem;">
      <h2 id="docs-tldr-title">الخلاصة السريعة</h2>
      <p>{tldr}</p>
    </section>

    <div class="docs-grid">
      <article class="article-content docs-content">
        <slot />
      </article>
      <aside>
        <TableOfContents headings={headings} />
      </aside>
    </div>

    <DocsRelatedLinks docs={relatedDocs} />

    <section class="docs-demo-cta" aria-labelledby="docs-demo-title">
      <h2 id="docs-demo-title">شاهد الحوكمة وهي تعمل على حالاتك الفعلية</h2>
      <p>احجز جلسة تعريفية لمراجعة احتياج منشأتك ومسار التطبيق المناسب.</p>
      <a href="/contact/">احجز ديمو</a>
    </section>
  </div>
</ArabicLayout>
