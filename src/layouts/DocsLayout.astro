---
import ArabicLayout from './ArabicLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import DocsRelatedLinks from '../components/DocsRelatedLinks.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Heading {
  depth: 2 | 3;
  slug: string;
  text: string;
}

interface RelatedDoc {
  slug: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  canonical: string;
  updated: Date;
  category: string;
  tldr: string;
  headings: Heading[];
  relatedDocs: RelatedDoc[];
  currentPath: string;
}

const {
  title,
  metaTitle,
  description,
  canonical,
  updated,
  category,
  tldr,
  headings,
  relatedDocs,
  currentPath,
} = Astro.props;

const techArticleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonical}#techarticle`,
  headline: title,
  description,
  mainEntityOfPage: canonical,
  dateModified: updated.toISOString().slice(0, 10),
  inLanguage: 'ar-SA',
  author: { '@type': 'Organization', name: 'BrightAI', url: 'https://brightai.site/' },
  publisher: { '@type': 'Organization', name: 'BrightAI', url: 'https://brightai.site/' },
};
// BreadcrumbList is already generated by the Breadcrumbs component — no duplicate needed here.
---

<ArabicLayout
  title={metaTitle}
  description={description}
  canonical={canonical}
  hreflang={[{ lang: 'ar-SA', href: canonical }]}
  jsonLd={techArticleLd}
  currentPath={currentPath}
>
  <style is:global>
    .docs-shell {
      width: min(100% - 2rem, 80rem);
      margin-inline: auto;
      padding-block: 2rem 5rem;
    }
    .docs-breadcrumbs {
      margin-block-end: 1.5rem;
    }
    .docs-hero {
      max-width: 58rem;
      padding-block: 1rem 2rem;
    }
    .docs-category,
    .docs-section-label {
      margin: 0 0 0.75rem;
      color: var(--brand, #00d4aa);
      font-size: 0.8125rem;
      font-weight: 800;
      letter-spacing: 0.04em;
    }
    .docs-hero h1 {
      margin: 0;
      color: var(--fg, #f8fafc);
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: 1.25;
    }
    .docs-hero__description {
      margin: 1rem 0 0;
      color: var(--fg-muted, #a8b3c7);
      font-size: 1.0625rem;
      line-height: 1.9;
    }
    .docs-tldr {
      max-width: 58rem;
      margin-block: 0 2rem;
      padding: 1.25rem 1.5rem;
      border: 1px solid color-mix(in srgb, var(--brand, #00d4aa) 35%, transparent);
      border-inline-start: 4px solid var(--brand, #00d4aa);
      border-radius: 1rem;
      background: color-mix(in srgb, var(--brand, #00d4aa) 8%, transparent);
    }
    .docs-tldr h2 {
      margin: 0 0 0.5rem;
      color: var(--fg, #f8fafc);
      font-size: 1.125rem;
    }
    .docs-tldr p {
      margin: 0;
      color: var(--fg-muted, #cbd5e1);
      line-height: 1.9;
      white-space: pre-line;
    }
    .docs-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 3rem;
      align-items: start;
    }
    .docs-content {
      min-width: 0;
      color: var(--fg-muted, #cbd5e1);
      line-height: 1.9;
    }
    .docs-content :where(h2, h3) {
      color: var(--fg, #f8fafc);
      scroll-margin-top: 1.5rem;
    }
    .docs-content h2 {
      margin: 2.75rem 0 1rem;
      font-size: clamp(1.4rem, 3vw, 2rem);
      line-height: 1.4;
    }
    .docs-content h3 {
      margin: 2rem 0 0.75rem;
      font-size: 1.2rem;
      line-height: 1.5;
    }
    .docs-content :where(p, ul, ol, blockquote) {
      max-width: 52rem;
    }
    .docs-content :where(a) {
      color: #67e8f9;
      text-underline-offset: 0.2em;
    }
    .docs-content :where(.card, .note, .callout, .week, .control-card, .scenario-card) {
      margin-block: 1.25rem;
      padding: 1.25rem;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 1rem;
      background: rgba(15, 23, 42, 0.58);
    }
    .docs-content :where(img, svg, video) {
      max-inline-size: 100%;
      block-size: auto;
    }
    .docs-content table {
      width: 100%;
      margin-block: 1.5rem;
      border-collapse: collapse;
    }
    .docs-content :where(th, td) {
      padding: 0.8rem;
      border: 1px solid rgba(148, 163, 184, 0.2);
      text-align: start;
      vertical-align: top;
    }
    .docs-content th {
      color: var(--fg, #f8fafc);
      background: rgba(6, 182, 212, 0.12);
    }
    .docs-toc {
      position: sticky;
      top: 1.5rem;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      padding: 1rem;
      border: 1px solid rgba(148, 163, 184, 0.16);
      border-radius: 1rem;
      background: rgba(8, 14, 28, 0.8);
    }
    .docs-toc__title {
      margin: 0 0 0.75rem;
      color: var(--fg, #f8fafc);
      font-weight: 800;
    }
    .docs-toc__list {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .docs-toc__item a {
      display: block;
      padding-block: 0.4rem;
      color: var(--fg-muted, #a8b3c7);
      font-size: 0.8125rem;
      line-height: 1.55;
      text-decoration: none;
    }
    .docs-toc__item a:hover,
    .docs-toc__item a:focus-visible {
      color: var(--brand, #00d4aa);
    }
    .docs-toc__item--nested {
      padding-inline-start: 1rem;
    }
    .docs-related {
      margin-block-start: 4rem;
      padding-block-start: 2rem;
      border-block-start: 1px solid rgba(148, 163, 184, 0.16);
    }
    .docs-related > h2 {
      color: var(--fg, #f8fafc);
    }
    .docs-related__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .docs-related__card {
      padding: 1.25rem;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 1rem;
      color: inherit;
      text-decoration: none;
      background: rgba(15, 23, 42, 0.5);
    }
    .docs-related__card h3 {
      margin: 0 0 0.5rem;
      color: var(--fg, #f8fafc);
      font-size: 1rem;
    }
    .docs-related__card p {
      margin: 0;
      color: var(--fg-muted, #a8b3c7);
      font-size: 0.875rem;
      line-height: 1.7;
    }
    .docs-demo-cta {
      margin-block-start: 3rem;
      padding: 2rem;
      border-radius: 1.25rem;
      text-align: center;
      background: linear-gradient(135deg, rgba(0, 212, 170, 0.14), rgba(6, 182, 212, 0.08));
    }
    .docs-demo-cta h2 {
      margin: 0;
      color: var(--fg, #f8fafc);
    }
    .docs-demo-cta p {
      margin: 0.75rem auto 1.25rem;
      color: var(--fg-muted, #cbd5e1);
    }
    .docs-demo-cta a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.4rem;
      border-radius: 0.75rem;
      background: var(--brand, #00d4aa);
      color: #061018;
      font-weight: 800;
      text-decoration: none;
    }
    @media (max-width: 900px) {
      .docs-grid {
        grid-template-columns: 1fr;
      }
      .docs-grid > aside {
        order: -1;
      }
      .docs-toc {
        position: static;
        max-height: none;
      }
    }
    @media (max-width: 640px) {
      .docs-shell {
        width: min(100% - 1.25rem, 80rem);
        padding-block-start: 1.25rem;
      }
      .docs-related__grid {
        grid-template-columns: 1fr;
      }
      .docs-content table.docs-table,
      .docs-content .docs-table tbody,
      .docs-content .docs-table tr,
      .docs-content .docs-table td {
        display: block;
        width: 100%;
      }
      .docs-content .docs-table thead {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
      }
      .docs-content .docs-table tr {
        margin-block: 1rem;
        padding: 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 0.9rem;
        background: rgba(15, 23, 42, 0.55);
      }
      .docs-content .docs-table td {
        display: grid;
        grid-template-columns: minmax(6rem, 40%) 1fr;
        gap: 0.75rem;
        border: 0;
        border-block-end: 1px solid rgba(148, 163, 184, 0.14);
      }
      .docs-content .docs-table td:last-child {
        border-block-end: 0;
      }
      .docs-content .docs-table td::before {
        content: attr(data-label);
        color: var(--fg, #f8fafc);
        font-weight: 800;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .docs-toc__item a,
      .docs-related__card,
      .docs-demo-cta a {
        transition: none;
      }
    }
  </style>

  <div class="docs-shell">
    <div class="docs-breadcrumbs">
      <Breadcrumbs crumbs={[
        { label: 'الرئيسية', href: '/' },
        { label: 'الوثائق', href: '/docs/' },
        { label: title },
      ]} />
    </div>

    <header class="docs-hero">
      <p class="docs-category">{category}</p>
      <h1>{title}</h1>
      <p class="docs-hero__description">{description}</p>
    </header>

    <section class="docs-tldr" aria-labelledby="docs-tldr-title" data-speakable>
      <h2 id="docs-tldr-title">الخلاصة السريعة</h2>
      <p>{tldr}</p>
    </section>

    <div class="docs-grid">
      <article class="docs-content">
        <slot />
      </article>
      <aside>
        <TableOfContents headings={headings} />
      </aside>
    </div>

    <DocsRelatedLinks docs={relatedDocs} />

    <section class="docs-demo-cta" aria-labelledby="docs-demo-title">
      <h2 id="docs-demo-title">شاهد الحوكمة وهي تعمل على حالاتك الفعلية</h2>
      <p>احجز جلسة تعريفية لمراجعة احتياج منشأتك ومسار التطبيق المناسب.</p>
      <a href="/contact/">احجز ديمو</a>
    </section>
  </div>
</ArabicLayout>
