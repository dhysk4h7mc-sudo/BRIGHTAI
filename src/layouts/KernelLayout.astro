---
/**
 * KernelLayout — Layout for /kernel/* pages.
 * Wraps BaseLayout (Header + Footer) with a kernel-specific
 * sticky top-nav (desktop) + drawer/bottom-nav (mobile).
 * RTL-aware, touch ≥44px, aria + keyboard nav.
 * Uses V2 design tokens exclusively.
 */
import BaseLayout from './BaseLayout.astro';
import { kernelNavItems } from '../data/kernel';
import type { SEOProps } from '../data/site';

interface Props extends SEOProps {
  currentPath?: string;
}

const { title, description, canonical, hreflang = [], ogImage, jsonLd, currentPath = '/kernel/' } = Astro.props;

const allItems = [
  { path: '/kernel/', label: 'الفهرس' },
  ...kernelNavItems.map(item => ({ path: item.path, label: item.label })),
];
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={title}
  description={description}
  canonical={canonical}
  hreflang={hreflang}
  ogImage={ogImage}
  jsonLd={jsonLd}
  currentPath={currentPath}
>
  <style>
    /* Skip-link */
    .k-skip-link {
      position: absolute;
      top: -100%;
      inset-inline-start: var(--space-2);
      z-index: 100;
      padding: var(--space-3) var(--space-5);
      background: var(--gradient-brand);
      color: var(--text-inverse);
      font-weight: var(--weight-bold);
      font-size: var(--text-sm);
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
      text-decoration: none;
      transition: top var(--duration-fast) var(--ease-out);
    }
    .k-skip-link:focus {
      top: 0;
    }

    /* Focus visibility */
    .k-topnav__link:focus-visible,
    .k-bottomnav__link:focus-visible,
    .k-drawer__link:focus-visible,
    .k-drawer-toggle:focus-visible,
    .k-drawer__close:focus-visible,
    .k-topnav__brand:focus-visible {
      outline: 2px solid var(--brand);
      outline-offset: 2px;
    }

    .k-topnav {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--ink-950);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(var(--blur-md));
      -webkit-backdrop-filter: blur(var(--blur-md));
      padding: 0 var(--space-4);
    }
    .k-topnav__inner {
      max-width: 80rem;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: var(--space-2);
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .k-topnav__inner::-webkit-scrollbar { display: none; }
    .k-topnav__brand {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-weight: var(--weight-bold);
      color: var(--text);
      text-decoration: none;
      white-space: nowrap;
      padding: var(--space-3) 0;
      font-size: var(--text-sm);
    }
    .k-topnav__brand svg { flex-shrink: 0; }
    .k-topnav__links {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      margin-right: auto;
    }
    .k-topnav__link {
      display: inline-flex;
      align-items: center;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-lg);
      font-size: var(--text-xs);
      color: var(--text-soft);
      text-decoration: none;
      white-space: nowrap;
      transition: background var(--duration-fast) var(--ease-out),
                  color var(--duration-fast) var(--ease-out);
      min-height: var(--touch-min);
    }
    .k-topnav__link:hover,
    .k-topnav__link:focus-visible {
      background: var(--surface-soft);
      color: var(--text);
    }
    .k-topnav__link[aria-current="page"] {
      background: var(--brand-subtle);
      color: var(--brand);
      font-weight: var(--weight-semibold);
    }

    /* Mobile bottom nav */
    .k-bottomnav {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 50;
      background: var(--ink-950);
      border-top: 1px solid var(--border);
      padding: var(--space-1) 0;
      padding-bottom: env(safe-area-inset-bottom, var(--space-1));
    }
    .k-bottomnav__list {
      display: flex;
      justify-content: space-around;
      align-items: center;
      list-style: none;
      margin: 0;
      padding: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .k-bottomnav__list::-webkit-scrollbar { display: none; }
    .k-bottomnav__item {
      flex-shrink: 0;
    }
    .k-bottomnav__link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-1-5) var(--space-2);
      color: var(--text-soft);
      text-decoration: none;
      font-size: 0.625rem;
      min-width: 52px;
      min-height: var(--touch-min);
      justify-content: center;
      border-radius: var(--radius-lg);
      transition: color var(--duration-fast) var(--ease-out);
    }
    .k-bottomnav__link[aria-current="page"] {
      color: var(--brand);
    }
    .k-bottomnav__link svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    /* Mobile drawer toggle */
    .k-drawer-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: var(--touch-min);
      height: var(--touch-min);
      background: none;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      color: var(--text);
      cursor: pointer;
    }

    /* Mobile drawer */
    .k-drawer {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 60;
    }
    .k-drawer__backdrop {
      position: absolute;
      inset: 0;
      background: var(--overlay);
    }
    .k-drawer__panel {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(85vw, 320px);
      background: var(--ink-950);
      border-left: 1px solid var(--border);
      padding: var(--space-6) var(--space-4);
      overflow-y: auto;
    }
    .k-drawer__panel h3 {
      color: var(--text);
      font-size: var(--text-base);
      margin-bottom: var(--space-4);
    }
    .k-drawer__link {
      display: block;
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-lg);
      color: var(--text-soft);
      text-decoration: none;
      font-size: var(--text-sm);
      min-height: var(--touch-min);
      transition: background var(--duration-fast) var(--ease-out),
                  color var(--duration-fast) var(--ease-out);
    }
    .k-drawer__link:hover,
    .k-drawer__link:focus-visible {
      background: var(--surface-soft);
      color: var(--text);
    }
    .k-drawer__link[aria-current="page"] {
      background: var(--brand-subtle);
      color: var(--brand);
      font-weight: var(--weight-semibold);
    }
    .k-drawer__close {
      position: absolute;
      top: var(--space-4);
      left: var(--space-4);
      width: var(--touch-min);
      height: var(--touch-min);
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      color: var(--text);
      cursor: pointer;
    }

    /* Content area spacing */
    .k-content {
      max-width: 80rem;
      margin: 0 auto;
      padding: var(--space-6) var(--space-4) var(--space-20);
    }

    @media (max-width: 768px) {
      .k-topnav__links { display: none; }
      .k-drawer-toggle { display: inline-flex; }
      .k-bottomnav { display: block; }
      .k-content { padding-bottom: var(--space-24); }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .k-topnav__link,
      .k-bottomnav__link,
      .k-drawer__link,
      .k-skip-link { transition: none; }
    }
  </style>

  <!-- Skip-link -->
  <a href="#k-content" class="k-skip-link">تخطّى إلى المحتوى</a>

  <!-- Kernel Top Nav -->
  <nav class="k-topnav" aria-label="تنقل Kernel">
    <div class="k-topnav__inner">
      <a href="/kernel/" class="k-topnav__brand" aria-label="BrightAI Kernel">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        <span>Kernel</span>
      </a>

      <div class="k-topnav__links">
        {allItems.map(item => (
          <a
            href={item.path}
            class="k-topnav__link"
            aria-current={currentPath === item.path ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>

      <button
        class="k-drawer-toggle"
        aria-label="فتح قائمة Kernel"
        aria-expanded="false"
        aria-controls="k-drawer"
        data-kernel-drawer-toggle
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div class="k-drawer" id="k-drawer" aria-hidden="true" role="dialog" aria-label="قائمة Kernel">
    <div class="k-drawer__backdrop" data-kernel-drawer-close></div>
    <div class="k-drawer__panel">
      <button class="k-drawer__close" data-kernel-drawer-close aria-label="إغلاق القائمة">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <h3>وحدات Kernel</h3>
      {allItems.map(item => (
        <a
          href={item.path}
          class="k-drawer__link"
          aria-current={currentPath === item.path ? 'page' : undefined}
          data-kernel-drawer-close
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>

  <!-- No-JS drawer fallback -->
  <noscript>
    <style>
      .k-drawer { display: block; position: static; background: var(--ink-950, #040711); border-bottom: 1px solid var(--border); padding: var(--space-4); }
      .k-drawer__backdrop { display: none; }
      .k-drawer__panel { position: static; width: 100%; background: transparent; border: none; padding: 0; }
      .k-drawer__close { display: none; }
      .k-drawer__link { display: block; padding: var(--space-3) var(--space-4); color: var(--text-soft); text-decoration: none; border-radius: var(--radius-lg); }
      .k-drawer__link:hover, .k-drawer__link:focus-visible { background: var(--surface-soft); color: var(--text); }
      .k-drawer__link[aria-current="page"] { background: var(--brand-subtle); color: var(--brand); font-weight: var(--weight-semibold); }
    </style>
    <div class="k-drawer" id="k-drawer-noscript">
      <h3>وحدات Kernel</h3>
      {allItems.map(item => (
        <a href={item.path} class="k-drawer__link" aria-current={currentPath === item.path ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </div>
  </noscript>

  <!-- Main content -->
  <div class="k-content" id="k-content" tabindex="-1">
    <slot />
  </div>

  <!-- Mobile Bottom Nav (5 key items) -->
  <nav class="k-bottomnav" aria-label="تنقل Kernel السريع">
    <ul class="k-bottomnav__list">
      {kernelNavItems.slice(0, 5).map(item => (
        <li class="k-bottomnav__item">
          <a
            href={item.path}
            class="k-bottomnav__link"
            aria-current={currentPath === item.path ? 'page' : undefined}
            aria-label={item.label}
          >
            <Fragment set:html={item.iconSvg} />
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Drawer JS (minimal, no external deps) -->
  <script is:inline>
    // حفظ مرجع دالة ثابت خارج نطاق دالة التهيئة لمنع تراكم المستمعين
    function handleKernelEscapeKey(e) {
      var drawer = document.getElementById('k-drawer');
      if (!drawer) return;
      var toggle = document.querySelector('[data-kernel-drawer-toggle]');
      
      if (e.key === 'Escape' && drawer.getAttribute('aria-hidden') === 'false') {
        drawer.setAttribute('aria-hidden', 'true');
        drawer.style.display = 'none';
        toggle?.setAttribute('aria-expanded', 'false');
        if (toggle instanceof HTMLElement) toggle.focus();
      }
    }

    function initKernelDrawer() {
      var toggle = document.querySelector('[data-kernel-drawer-toggle]');
      var drawer = document.getElementById('k-drawer');
      if (!toggle || !drawer) return;

      function openDrawer() {
        drawer.setAttribute('aria-hidden', 'false');
        drawer.style.display = 'block';
        toggle.setAttribute('aria-expanded', 'true');
        drawer.querySelector('.k-drawer__link')?.focus();
      }

      function closeDrawer() {
        drawer.setAttribute('aria-hidden', 'true');
        drawer.style.display = 'none';
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }

      toggle.addEventListener('click', function() {
        var isOpen = drawer.getAttribute('aria-hidden') === 'false';
        if (isOpen) closeDrawer(); else openDrawer();
      });

      drawer.querySelectorAll('[data-kernel-drawer-close]').forEach(function(el) {
        el.addEventListener('click', closeDrawer);
      });

      // إزالة المستمع القديم وإعادة الإضافة الآمنة بمرجع ثابت
      document.removeEventListener('keydown', handleKernelEscapeKey);
      document.addEventListener('keydown', handleKernelEscapeKey);
    }

    document.addEventListener('astro:page-load', initKernelDrawer);
  </script>
</BaseLayout>