---
/**
 * EnglishLayout — English (LTR) pages layout.
 * Defaults: lang="en", dir="ltr", locale en-SA.
 */
import BaseLayout from './BaseLayout.astro';
import type { SEOProps } from '../data/site';

interface Props extends SEOProps {
  currentPath?: string;
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  jsonLd,
  currentPath = '/',
} = Astro.props;
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={title}
  description={description}
  canonical={canonical}
  hreflang={hreflang}
  ogImage={ogImage}
  jsonLd={jsonLd}
  currentPath={currentPath}
>
  <slot />
</BaseLayout>