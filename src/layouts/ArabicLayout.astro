---
/**
 * ArabicLayout — Arabic (RTL) pages layout.
 * Defaults: lang="ar", dir="rtl", locale ar-SA.
 */
import BaseLayout from './BaseLayout.astro';
import type { SEOProps } from '../data/site';

interface Props extends SEOProps {
  currentPath?: string;
  languageCounterpart?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  ogImageAlt,
  jsonLd,
  currentPath = '/',
  languageCounterpart,
  robots,
} = Astro.props;
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={title}
  description={description}
  canonical={canonical}
  hreflang={hreflang}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  jsonLd={jsonLd}
  currentPath={currentPath}
  languageCounterpart={languageCounterpart}
  robots={robots}
>
  <slot />
</BaseLayout>
