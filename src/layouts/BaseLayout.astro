---
/**
 * BaseLayout — Root layout for all pages.
 * Props: lang, dir, title, description, canonical, hreflang, ogImage, jsonLd
 * Injects: Google tag G-8LLESL207Q, fonts preconnect, all CSS.
 */
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import DottedBackground from '../components/DottedBackground.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE } from '../data/site';
import type { SEOProps } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props extends SEOProps {
  lang?: 'ar' | 'en';
  dir?: 'rtl' | 'ltr';
  currentPath?: string;
  languageCounterpart?: string;
  robots?: string;
}

const {
  lang = 'ar',
  dir = 'rtl',
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  ogImageAlt,
  jsonLd,
  currentPath = '/',
  languageCounterpart,
  robots,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Font preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" />

  <!-- Preload custom brand font -->
  <link rel="preload" href="/frontend/assets/fonts/TheYearofTheCamel-Medium.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <link rel="preload" as="image" href="/logo.png" fetchpriority="high" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- SEO -->
  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    hreflang={hreflang}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    jsonLd={jsonLd}
    locale={lang}
    robots={robots}
  />

  <ClientRouter />

  <!-- Additional production meta tags -->
  <meta name="theme-color" content="#060914" />
  <meta name="format-detection" content="telephone=no" />

  {/* Verification meta — only emit when a real verified value exists */}
  {SITE.bingVerification && (
    <meta name="msvalidate.01" content={SITE.bingVerification} />
  )}
  {SITE.yandexVerification && (
    <meta name="yandex-verification" content={SITE.yandexVerification} />
  )}
  {SITE.googleVerification && (
    <meta name="google-site-verification" content={SITE.googleVerification} />
  )}

  {/* Google tag (gtag.js) — single injection point. Initial pageview on load. */}
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleTagId}`}></script>
  <script is:inline set:html={`
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '${SITE.googleTagId}', {
      page_path: window.location.pathname,
      anonymize_ip: true
    });
  `}></script>

  {/* Microsoft Clarity — only when valid ID exists (not placeholder) */}
  {SITE.clarityId && (
    <script is:inline define:vars={{ clarityId: SITE.clarityId }}>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", clarityId);
    </script>
  )}

  {/* SPA transition pageview — deduplicated via flag to prevent double-fire */}
  <script>
    (function() {
      let firstPageview = true;
      document.addEventListener('astro:page-load', () => {
        if (firstPageview) {
          firstPageview = false;
          return; // initial pageview already sent by gtag config above
        }
        const w = window as any;
        if (w.gtag) {
          w.gtag('event', 'page_view', {
            page_path: window.location.pathname,
            page_title: document.title,
            page_location: window.location.href
          });
        }
      });
    })();
  </script>

  {/* Global scroll-reveal observer — activates .reveal elements anywhere on the page,
      including set:html injected content. Consolidates all reveal logic in one place.
      Respects prefers-reduced-motion and degrades gracefully without IntersectionObserver. */}
  <script>
    (function() {
      function initReveal() {
        const reveals = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!reveals.length) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          reveals.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        if (!('IntersectionObserver' in window)) {
          reveals.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        reveals.forEach((el) => observer.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);
    })();
  </script>

  <!-- Critical inline CSS: brand font-face + heading overrides -->
  <style is:inline>
    @font-face {
      font-family: 'BrightAI Official';
      src: url('/frontend/assets/fonts/TheYearofTheCamel-Medium.woff2') format('woff2'),
           url('/frontend/assets/fonts/TheYearofTheCamel-Medium.otf') format('opentype');
      font-weight: 400 900;
      font-display: swap;
    }
    [dir=rtl] h1, [dir=rtl] h2, [dir=rtl] h3,
    [dir=rtl] h4, [dir=rtl] h5, [dir=rtl] h6,
    html[lang=ar] h1, html[lang=ar] h2, html[lang=ar] h3,
    html[lang=ar] h4, html[lang=ar] h5, html[lang=ar] h6,
    .gradient-text, .chip, .badge, .font-black, .font-bold,
    .feature-title, .section-title, .stat-value, .metric-label,
    .brand-text {
      font-family: 'BrightAI Official', 'IBM Plex Sans Arabic', Arial, sans-serif;
      font-weight: 700;
    }
    /* Production body baseline */
    body { background: #060914; color: #f8fafc; overflow-x: hidden; }
  </style>

  <!-- Styles — V2 Design System Architecture -->
  <!-- Load order: tokens → global → layout → components → page styles → mobile → content-pages → design-system (canonical) -->
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/layout.css';
    @import '../styles/components.css';
    @import '../styles/animations.css';
    @import '../styles/home.css';
    @import '../styles/inner-pages.css';
    @import '../styles/legal-pages.css';
    @import '../styles/mobile.css';
    @import '../styles/content-pages.css';
    @import '../styles/design-system.css';
  </style>

  {/* Unregister old Service Workers and clear caches */}
  <script is:inline>
    (function() {
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
          for (let registration of registrations) {
            registration.unregister().then(function() {
              console.log('Old Service Worker unregistered successfully.');
            });
          }
        }).catch(function(err) {
          console.error('Error unregistering service workers:', err);
        });
      }
      if ('caches' in window) {
        caches.keys().then(function(names) {
          for (let name of names) {
            caches.delete(name);
          }
        }).catch(function(err) {
          console.error('Error clearing caches:', err);
        });
      }
    })();
  </script>
</head>
<body>
  <DottedBackground />
  <a href="#main-content" class="skip-to-content">
    {lang === 'ar' ? 'تخطي إلى المحتوى' : 'Skip to content'}
  </a>

  <div class="page">
    <Header lang={lang} currentPath={currentPath} />
    <MobileNav lang={lang} currentPath={currentPath} />

    <main id="main-content" class="page__main">
      <slot />
    </main>

    <Footer lang={lang} currentPath={currentPath} languageCounterpart={languageCounterpart} />
  </div>

  <WhatsAppCTA lang={lang} />
  <CookieConsent />
</body>
</html>
