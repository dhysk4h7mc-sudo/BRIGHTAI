---
/**
 * BaseLayout — Root layout for all pages.
 * Props: lang, dir, title, description, canonical, hreflang, ogImage, jsonLd
 * Injects: Google tag G-8LLESL207Q, fonts preconnect, all CSS.
 */
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import type { SEOProps } from '../data/site';

interface Props extends SEOProps {
  lang?: 'ar' | 'en';
  dir?: 'rtl' | 'ltr';
  currentPath?: string;
  languageCounterpart?: string;
}

const {
  lang = 'ar',
  dir = 'rtl',
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  jsonLd,
  currentPath = '/',
  languageCounterpart,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Font preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- SEO -->
  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    hreflang={hreflang}
    ogImage={ogImage}
    jsonLd={jsonLd}
    locale={lang}
  />

  <!-- Styles -->
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/layout.css';
    @import '../styles/components.css';
    @import '../styles/animations.css';
    @import '../styles/mobile.css';
  </style>
</head>
<body>
  <a href="#main-content" class="skip-to-content">
    {lang === 'ar' ? 'تخطي إلى المحتوى' : 'Skip to content'}
  </a>

  <div class="page">
    <Header lang={lang} currentPath={currentPath} />
    <MobileNav lang={lang} currentPath={currentPath} />

    <main id="main-content" class="page__main">
      <slot />
    </main>

    <Footer lang={lang} currentPath={currentPath} languageCounterpart={languageCounterpart} />
  </div>

  <WhatsAppCTA lang={lang} />
</body>
</html>
