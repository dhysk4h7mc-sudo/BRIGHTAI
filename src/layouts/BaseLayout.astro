---
/**
 * BaseLayout — Root layout for all pages.
 * Props: lang, dir, title, description, canonical, hreflang, ogImage, jsonLd
 * Injects: Google tag G-8LLESL207Q, fonts preconnect, all CSS.
 */
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import DottedBackground from '../components/DottedBackground.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE } from '../data/site';
import type { SEOProps } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props extends SEOProps {
  lang?: 'ar' | 'en';
  dir?: 'rtl' | 'ltr';
  currentPath?: string;
  languageCounterpart?: string;
  robots?: string;
}

const {
  lang = 'ar',
  dir = 'rtl',
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  ogImageAlt,
  jsonLd,
  currentPath = '/',
  languageCounterpart,
  robots,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Font preconnect (REPORTS-20: trimmed to body 400 + heading 600 only). -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Google Fonts CSS loaded non-blocking via print media trick — does not block render. -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600&family=Inter:wght@400;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600&family=Inter:wght@400;600&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600&family=Inter:wght@400;600&display=swap" /></noscript>

  <!-- Preload custom brand font -->
  <link rel="preload" href="/assets/fonts/TheYearofTheCamel-Medium.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- Brand logo preload — webp ~17KB instead of 406KB PNG (REPORTS-20). -->
  <link rel="preload" as="image" href="/logo-192.webp" type="image/webp" fetchpriority="high" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- SEO -->
  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    hreflang={hreflang}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    jsonLd={jsonLd}
    locale={lang}
    robots={robots}
  />

  <ClientRouter />

  <!-- Service Worker registration (REPORTS-20: deferred via setTimeout to not block initial load) -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        setTimeout(function() {
          navigator.serviceWorker.register('/sw.js');
        }, 100);
      });
    }
  </script>

  <!-- Additional production meta tags -->
  <meta name="theme-color" content="#060914" />
  <meta name="format-detection" content="telephone=no" />

  {/* Verification meta — only emit when a real verified value exists */}
  {SITE.bingVerification && (
    <meta name="msvalidate.01" content={SITE.bingVerification} />
  )}
  {SITE.yandexVerification && (
    <meta name="yandex-verification" content={SITE.yandexVerification} />
  )}
  {SITE.googleVerification && (
    <meta name="google-site-verification" content={SITE.googleVerification} />
  )}

  {/* Google tag (gtag.js) — REPORTS-20: deferred via requestIdleCallback-equivalent
       so 182KB gtag.js doesn't compete with the LCP element. Initial pageview fires
       after first paint via setTimeout(0) instead of blocking. */}
  <script is:inline set:html={`
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '${SITE.googleTagId}', { anonymize_ip: true, send_page_view: false });
    function loadGtag() {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=${SITE.googleTagId}';
      s.onload = function() {
        gtag('event', 'page_view', {
          page_path: window.location.pathname,
          page_title: document.title,
          page_location: window.location.href
        });
      };
      document.head.appendChild(s);
    }
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadGtag, { timeout: 4000 });
    } else {
      setTimeout(loadGtag, 1500);
    }
  `}></script>

  {/* Microsoft Clarity — only when valid ID exists (not placeholder) */}
  {SITE.clarityId && (
    <script is:inline define:vars={{ clarityId: SITE.clarityId }}>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", clarityId);
    </script>
  )}

  {/* SPA transition pageview — fires page_view on view-transition navigations.
       REPORTS-20: gtag.js itself is loaded lazily via requestIdleCallback above,
       so this listener waits for gtag to exist before firing. */}
  <script>
    (function() {
      document.addEventListener('astro:after-swap', () => {
        const w = window as any;
        if (w.gtag) {
          w.gtag('event', 'page_view', {
            page_path: window.location.pathname,
            page_title: document.title,
            page_location: window.location.href
          });
        }
      });
    })();
  </script>

  {/* Global centralized scroll-reveal observer — activates the unified motion system
      (DEC-2026-Motion-001) across every page. Replaces 7 per-page duplicate
      IntersectionObservers with a single observer that handles every reveal-able element.
      SSR-safe (script is bundled by Astro and only runs in the browser). Respects
      prefers-reduced-motion + degrades gracefully without IntersectionObserver support.

      The actual implementation lives in src/scripts/scroll-reveal.js so it can be
      unit-tested, versioned, and audited independently of this layout file. */}
  <script>
    import '../scripts/scroll-reveal.js';
  </script>

  <!-- Critical inline CSS: brand font-face + heading overrides -->
  <style is:inline>
    @font-face {
      font-family: 'BrightAI Official';
      src: url('/assets/fonts/TheYearofTheCamel-Medium.woff2') format('woff2');
      font-weight: 400 900;
      font-display: swap;
    }
    [dir=rtl] h1, [dir=rtl] h2, [dir=rtl] h3,
    [dir=rtl] h4, [dir=rtl] h5, [dir=rtl] h6,
    html[lang=ar] h1, html[lang=ar] h2, html[lang=ar] h3,
    html[lang=ar] h4, html[lang=ar] h5, html[lang=ar] h6,
    .gradient-text, .chip, .badge, .font-black, .font-bold,
    .feature-title, .section-title, .metric-label, .brand-text {
      font-family: 'BrightAI Official', 'IBM Plex Sans Arabic', Arial, sans-serif;
      font-weight: 700;
    }
    /* Production body baseline */
    body { background: var(--bg-base); color: var(--text-primary); overflow-x: hidden; }
  </style>

  <!-- Styles — V3 Unified Design System -->
  <!-- REPORTS-20: Wrapped in CSS layers so the cascade is predictable.
       Lower layers win when specificity is equal (override-by-layer).
       Order (low → high priority): tokens < base < components < pages < animations < kernel < utilities -->
  <style is:global>
    @layer tokens, base, components, pages, animations, kernel, utilities;

    @import '../styles/tokens.css' layer(tokens);
    @import '../styles/base.css' layer(base);
    @import '../styles/components.css' layer(components);
    @import '../styles/pages.css' layer(pages);
    @import '../styles/utilities.css' layer(utilities);
    @import '../styles/color-usage.css' layer(components);
    @import '../styles/animations.css' layer(animations);
    @import '../styles/kernel.css' layer(kernel);
  </style>
</head>
<body>
  <DottedBackground />
  <a href="#main-content" class="skip-to-content">
    {lang === 'ar' ? 'تخطي إلى المحتوى' : 'Skip to content'}
  </a>

  <div class="page">
    <Header lang={lang} currentPath={currentPath} />
    <MobileNav lang={lang} currentPath={currentPath} />

    <main id="main-content" class="page__main">
      <slot />
    </main>

    <Footer lang={lang} currentPath={currentPath} languageCounterpart={languageCounterpart} />
  </div>

  <aside class="whatsapp-cta-landmark" aria-label={lang === 'ar' ? 'تواصل سريع' : 'Quick contact'}>
    <WhatsAppCTA lang={lang} />
  </aside>
  <CookieConsent />
</body>
</html>
