---
/**
 * BaseLayout — Root layout for all pages.
 * Props: lang, dir, title, description, canonical, hreflang, ogImage, jsonLd
 * Injects: Google tag G-8LLESL207Q, fonts preconnect, all CSS.
 */
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { SITE } from '../data/site';
import type { SEOProps } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props extends SEOProps {
  lang?: 'ar' | 'en';
  dir?: 'rtl' | 'ltr';
  currentPath?: string;
  languageCounterpart?: string;
  robots?: string;
}

const {
  lang = 'ar',
  dir = 'rtl',
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  ogImageAlt,
  jsonLd,
  currentPath = '/',
  languageCounterpart,
  robots,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Font preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" />

  <!-- Preload custom brand font -->
  <link rel="preload" href="/frontend/assets/fonts/TheYearofTheCamel-Medium.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- SEO -->
  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    hreflang={hreflang}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    jsonLd={jsonLd}
    locale={lang}
    robots={robots}
  />

  <ClientRouter />

  <!-- Additional production meta tags -->
  <meta name="theme-color" content="#060914" />
  <meta name="format-detection" content="telephone=no" />

  <!-- Bing Webmaster Verification -->
  <meta name="msvalidate.01" content={SITE.bingVerification} />

  <!-- Yandex Webmaster Verification -->
  <meta name="yandex-verification" content={SITE.yandexVerification} />

  <!-- Google tag (gtag.js) — loaded directly in head for production parity -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8LLESL207Q"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-8LLESL207Q');
  </script>

  <!-- Microsoft Clarity — important for Saudi market (Edge ~30% share) -->
  <script is:inline define:vars={{ clarityId: SITE.clarityId }}>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityId);
  </script>

  <!-- SPA transition pageview trigger -->
  <script>
    document.addEventListener('astro:page-load', () => {
      const w = window as any;
      if (w.gtag) {
        w.gtag('config', 'G-8LLESL207Q', {
          page_path: window.location.pathname,
          page_title: document.title
        });
      }
    });
  </script>

  <!-- Critical inline CSS: brand font-face + heading overrides -->
  <style is:inline>
    @font-face {
      font-family: 'BrightAI Official';
      src: url('/frontend/assets/fonts/TheYearofTheCamel-Medium.woff2') format('woff2'),
           url('/frontend/assets/fonts/TheYearofTheCamel-Medium.otf') format('opentype');
      font-weight: 400 900;
      font-display: swap;
    }
    [dir=rtl] h1, [dir=rtl] h2, [dir=rtl] h3,
    [dir=rtl] h4, [dir=rtl] h5, [dir=rtl] h6,
    html[lang=ar] h1, html[lang=ar] h2, html[lang=ar] h3,
    html[lang=ar] h4, html[lang=ar] h5, html[lang=ar] h6,
    .gradient-text, .chip, .badge, .font-black, .font-bold,
    .feature-title, .section-title, .stat-value, .metric-label,
    .brand-text {
      font-family: 'BrightAI Official', 'IBM Plex Sans Arabic', Arial, sans-serif !important;
      font-weight: 700 !important;
    }
    /* Production body baseline */
    body { background: #060914; color: #f8fafc; overflow-x: hidden; }
  </style>

  <!-- Styles -->
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/layout.css';
    @import '../styles/components.css';
    @import '../styles/animations.css';
    @import '../styles/mobile.css';
    @import '../styles/design-system.css';
  </style>
</head>
<body>
  <a href="#main-content" class="skip-to-content">
    {lang === 'ar' ? 'تخطي إلى المحتوى' : 'Skip to content'}
  </a>

  <div class="page">
    <Header lang={lang} currentPath={currentPath} />
    <MobileNav lang={lang} currentPath={currentPath} />

    <main id="main-content" class="page__main">
      <slot />
    </main>

    <Footer lang={lang} currentPath={currentPath} languageCounterpart={languageCounterpart} />
  </div>

  <WhatsAppCTA lang={lang} />

  <!-- Global Cleanup Script for GSAP & ScrollTrigger -->
  <script>
    document.addEventListener('astro:before-swap', () => {
      const w = window as any;
      if (w.gsap) {
        w.gsap.killTweensOf('*');
        if (w.gsap.globalTimeline) {
          w.gsap.globalTimeline.clear();
        }
      }
      if (w.ScrollTrigger) {
        try {
          w.ScrollTrigger.getAll().forEach((trigger: any) => {
            trigger.kill(true);
          });
        } catch (e) {
          console.error('Error cleaning ScrollTrigger:', e);
        }
      }
    });
  </script>
</body>
</html>
