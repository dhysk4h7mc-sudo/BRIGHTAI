---
/**
 * ActivityStream — Audit trail events for /kernel/audit/.
 * Visible without JS. CSS-only subtle animation with reduced-motion fallback.
 */
import { activityEvents, riskLevelClass, riskLevelLabel } from '../data/kernel';
import type { ActivityEvent } from '../data/kernel';

interface Props { events?: ActivityEvent[] }
const { events = activityEvents } = Astro.props;
---

<style>
  .k-timeline { list-style: none; padding: 0; margin: 0; }
  .k-timeline__item {
    position: relative;
    padding-block: var(--space-4);
    padding-inline: var(--space-5) var(--space-8);
    border-bottom: 1px solid var(--border);
  }
  .k-timeline__item::before {
    content: '';
    position: absolute;
    inset-inline-start: 1rem;
    top: 1.35rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }
  .k-timeline__item.k-risk--minimal::before { background: #22c55e; }
  .k-timeline__item.k-risk--low::before { background: #3b82f6; }
  .k-timeline__item.k-risk--medium::before { background: #f59e0b; }
  .k-timeline__item.k-risk--high::before { background: #ef4444; }
  .k-timeline__item.k-risk--critical::before { background: #dc2626; }
  .k-timeline__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }
  .k-timeline__type {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }
  .k-timeline__risk {
    font-size: 0.6875rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-weight: 500;
  }
  .k-risk--minimal .k-timeline__risk { background: rgba(34,197,94,0.15); color: #22c55e; }
  .k-risk--low .k-timeline__risk { background: rgba(59,130,246,0.15); color: #3b82f6; }
  .k-risk--medium .k-timeline__risk { background: rgba(245,158,11,0.15); color: #f59e0b; }
  .k-risk--high .k-timeline__risk { background: rgba(239,68,68,0.15); color: #ef4444; }
  .k-risk--critical .k-timeline__risk { background: rgba(220,38,38,0.15); color: #dc2626; }
  .k-timeline__desc {
    font-size: var(--text-xs);
    color: var(--text-soft);
    line-height: var(--leading-normal);
  }
  .k-timeline__time {
    font-size: 0.6875rem;
    color: var(--text-faint);
    margin-top: var(--space-1);
  }
  .k-timeline__demo {
    display: inline-block;
    font-size: 0.625rem;
    color: var(--text-faint);
    background: var(--glass);
    border-radius: var(--radius-xs);
    padding: var(--space-0-5) var(--space-1-5);
    margin-top: var(--space-1-5);
  }
</style>

<ol class="k-timeline" aria-label="سجل الأنشطة">
  {events.map(ev => (
    <li class={`k-timeline__item ${riskLevelClass(ev.riskLevel)}`}>
      <div class="k-timeline__header">
        <span class="k-timeline__type">{ev.label}</span>
        <span class="k-timeline__risk">{riskLevelLabel(ev.riskLevel)}</span>
      </div>
      <p class="k-timeline__desc">{ev.description}</p>
      <time class="k-timeline__time">{ev.timestamp}</time>
      {ev.demo && <span class="k-timeline__demo">بيانات توضيحية</span>}
    </li>
  ))}
</ol>
