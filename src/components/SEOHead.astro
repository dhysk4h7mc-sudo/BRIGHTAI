---
/**
 * SEOHead — Complete SEO meta tags for every page.
 * Props: title, description, canonical, hreflang, ogImage, jsonLd
 * Always: robots no noindex, Google tag G-8LLESL207Q, canonical self-reference.
 */
import { SITE } from '../data/site';
import type { SEOProps } from '../data/site';

interface HreflangLink {
  lang: string;
  href: string;
}

interface Props extends SEOProps {
  locale?: 'ar' | 'en';
  robots?: string;
  hreflang?: HreflangLink[];
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  ogImage = SITE.ogImage,
  ogImageAlt = 'BrightAI - Saudi AI Safety OS',
  jsonLd,
  locale = 'ar',
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
} = Astro.props as Props;

const fullOgImage = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;
const siteName = SITE.name;
const hasXDefault = hreflang.some((link) => link.lang === 'x-default');
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === 'en' ? 'en_SA' : 'ar_SA'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Hreflang -->
{hreflang.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
{!hasXDefault && hreflang.length > 0 && !robots.includes('noindex') && (
  <link rel="alternate" hreflang="x-default" href={canonical} />
)}

<!-- JSON-LD Structured Data -->
{jsonLd && (
  <script id="brightai-production-schema" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<!-- Note: Google Analytics (gtag.js) is injected once in BaseLayout.astro to prevent duplicate pageview tracking. -->
