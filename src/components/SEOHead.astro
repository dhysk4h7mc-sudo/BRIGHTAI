---
/**
 * SEOHead — Complete SEO meta tags for every page.
 * Props: title, description, canonical, hreflang, ogImage, jsonLd
 * Always: robots no noindex, Google tag G-8LLESL207Q, canonical self-reference.
 */
import { SITE } from '../data/site';
import type { SEOProps } from '../data/site';
import { LEGAL_I18N_PAIRS } from '../data/i18n-pairs';

interface HreflangLink {
  lang: string;
  href: string;
}

interface Props extends SEOProps {
  locale?: 'ar' | 'en';
  robots?: string;
  hreflang?: HreflangLink[];
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  ogImage = SITE.ogImage,
  ogImageAlt = 'BrightAI - Saudi AI Safety OS',
  jsonLd,
  locale = 'ar',
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
} = Astro.props as Props;

const fullOgImage = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;
const siteName = SITE.name;

const isArabic = locale === 'ar';
const hasEnSA = hreflang.some((link) => link.lang === 'en-SA');
const enrichedHreflang = [...hreflang];

let currentPathname = '';
try {
  currentPathname = canonical ? new URL(canonical).pathname : Astro.url.pathname;
} catch (e) {
  currentPathname = Astro.url.pathname;
}
const normalizedPath = currentPathname.endsWith('/') ? currentPathname : `${currentPathname}/`;

// التحقق من أن المسار الحالي يحتوي على ترجمة إنجليزية معتمدة في LEGAL_I18N_PAIRS
const hasEnglishCounterpart = LEGAL_I18N_PAIRS.some(
  (pair) => pair.arabic === normalizedPath || pair.english === normalizedPath
);

if (isArabic && !hasEnSA && canonical && hasEnglishCounterpart) {
  const enHref = canonical.replace(`${SITE.url}/`, `${SITE.url}/en/`);
  enrichedHreflang.push({ lang: 'en-SA', href: enHref });
}
const finalHasXDefault = enrichedHreflang.some((link) => link.lang === 'x-default');
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === 'en' ? 'en_SA' : 'ar_SA'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Hreflang -->
{enrichedHreflang.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
{!finalHasXDefault && enrichedHreflang.length > 0 && !robots.includes('noindex') && (
  <link rel="alternate" hreflang="x-default" href={canonical} />
)}

<!-- JSON-LD Structured Data -->
{jsonLd && (
  <script id="brightai-production-schema" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<!-- Note: Google Analytics (gtag.js) is injected once in BaseLayout.astro to prevent duplicate pageview tracking. -->
