---
interface Column { key:string; label:string; }
interface Props { title?:string; columns?:Column[]; rows?:Record<string,string>[]; }
const { title='نماذج الذكاء الاصطناعي',columns=[{key:'name',label:'اسم النموذج'},{key:'sector',label:'القطاع'},{key:'risk',label:'درجة المخاطر'},{key:'status',label:'الحالة'},{key:'updated',label:'آخر تحديث'}],rows=[{name:'محلل المخاطر v2.1',sector:'المصرفي',risk:'متوسط',status:'● مُفعّل',updated:'10 يونيو 2026'},{name:'كاشف الاحتيال AI',sector:'المصرفي',risk:'عالي',status:'● مراجعة',updated:'8 يونيو 2026'},{name:'مساعد التشخيص',sector:'الصحي',risk:'منخفض',status:'● معلّق',updated:'5 يونيو 2026'},{name:'محلل الوثائق',sector:'الحكومي',risk:'متوسط',status:'● مُفعّل',updated:'3 يونيو 2026'},{name:'نموذج التقييم الائتماني',sector:'المصرفي',risk:'عالي',status:'● مرفوض',updated:'1 يونيو 2026'}] }=Astro.props;
---
<div class="legacy-table"><header><h3>{title}</h3><button>إضافة نموذج</button></header><div class="scroll"><table><thead><tr>{columns.map(column=><th>{column.label}</th>)}</tr></thead><tbody>{rows.map(row=><tr>{columns.map(column=><td>{row[column.key]}</td>)}</tr>)}</tbody></table></div><footer>عرض 1–{rows.length} من 24 نموذج</footer></div>
<style>.legacy-table{overflow:hidden;border:1px solid #ffffff1f;border-radius:8px;background:#0f172bb8}.legacy-table header,.legacy-table footer{display:flex;justify-content:space-between;padding:1rem 1.5rem;color:#94a3b8}.legacy-table h3{color:#fff}.legacy-table button{padding:.5rem 1rem;border:0;border-radius:8px;background:#6366f1;color:#fff}.scroll{overflow-x:auto}.legacy-table table{width:100%;border-collapse:collapse}.legacy-table th,.legacy-table td{padding:.8rem 1rem;border-top:1px solid #ffffff12;text-align:start;color:#cbd5e1;white-space:nowrap}</style>
