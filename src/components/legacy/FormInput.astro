---
interface Props { id:string; label:string; type?:string; placeholder?:string; required?:boolean; helper?:string; error?:string; value?:string; disabled?:boolean; textarea?:boolean; options?:{value:string;label:string}[]; }
const { id,label,type='text',placeholder,required=false,helper,error,value,disabled=false,textarea=false,options }=Astro.props;
---
<div class="legacy-form-group"><label for={id}>{label}{required&&<span>*</span>}</label>{options?<select id={id} required={required} disabled={disabled}><option value="" disabled selected>{placeholder??'اختر القطاع'}</option>{options.map(option=><option value={option.value}>{option.label}</option>)}</select>:textarea?<textarea id={id} placeholder={placeholder} required={required} disabled={disabled} rows="4">{value}</textarea>:<input id={id} type={type} placeholder={placeholder} required={required} value={value} disabled={disabled}/>} {helper&&<small>{helper}</small>}{error&&<small class="error">{error}</small>}</div>
<style>.legacy-form-group{display:flex;flex-direction:column;gap:.5rem}.legacy-form-group label{color:#fff;font-weight:600}.legacy-form-group label span,.error{color:#ef4444}.legacy-form-group input,.legacy-form-group textarea,.legacy-form-group select{min-height:44px;padding:.7rem 1rem;border:1px solid #ffffff1f;border-radius:8px;background:#ffffff0d;color:#fff;font:inherit}.legacy-form-group small{color:#94a3b8}</style>
