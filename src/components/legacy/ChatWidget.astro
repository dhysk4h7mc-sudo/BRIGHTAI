---
interface Props { assistantName?:string; }
const { assistantName='BRIGHTAI مساعد' }=Astro.props;
---
<div class="legacy-chat" data-chat-widget><button class="fab" aria-label="فتح المحادثة" data-chat-toggle><iconify-icon icon="lucide:message-circle" width="26"></iconify-icon></button><section class="box" aria-label="المحادثة"><header><div><strong>{assistantName}</strong><small>متصل الآن</small></div><button aria-label="إغلاق" data-chat-toggle>×</button></header><div class="messages"><p class="bot">مرحباً! أنا مساعد BRIGHTAI الذكي. كيف يمكنني مساعدتك في حوكمة الذكاء الاصطناعي اليوم؟</p><p class="user">أريد معرفة المزيد عن خدمات فحص الامتثال</p><p class="bot">بالتأكيد! نقدم خدمات فحص الامتثال التنظيمي للذكاء الاصطناعي التي تشمل: فحص تلقائي لأكثر من 500 معيار، تقارير مفصلة بالامتثال، وتوصيات عملية للتحسين. هل ترغب في تجربة مجانية؟</p></div><footer><textarea placeholder="اكتب رسالتك..." rows="1"></textarea><button aria-label="إرسال"><iconify-icon icon="lucide:send" width="18"></iconify-icon></button></footer></section></div>
<style>.legacy-chat .fab{position:fixed;inset-inline-start:1rem;inset-block-end:1rem;width:58px;height:58px;border:0;border-radius:50%;background:#6366f1;color:#fff}.legacy-chat .box{position:fixed;inset-inline-start:1rem;inset-block-end:5.5rem;width:min(400px,calc(100vw - 2rem));height:min(620px,calc(100vh - 7rem));display:none;flex-direction:column;border:1px solid #6366f14d;border-radius:8px;background:#0a0f1e;color:#fff}.legacy-chat.is-open .box{display:flex}.legacy-chat header,.legacy-chat footer{display:flex;align-items:center;justify-content:space-between;padding:1rem;border-bottom:1px solid #ffffff12}.legacy-chat header small{display:block;color:#22c55e}.legacy-chat header button{border:0;background:transparent;color:#fff}.messages{flex:1;overflow:auto;padding:1rem}.messages p{max-width:85%;padding:.75rem 1rem;border-radius:8px}.bot{background:#ffffff0d;color:#cbd5e1}.user{margin-inline-start:auto;background:#6366f1}.legacy-chat footer{gap:.5rem;border-top:1px solid #ffffff12;border-bottom:0}.legacy-chat textarea{flex:1;padding:.65rem;border:1px solid #ffffff1f;border-radius:8px;background:#ffffff0d;color:#fff}</style>
<script>document.querySelectorAll('[data-chat-widget]').forEach(widget=>widget.querySelectorAll('[data-chat-toggle]').forEach(button=>button.addEventListener('click',()=>widget.classList.toggle('is-open'))));</script>
