---
/**
 * LiveDashboardMockup — Static demo metrics for /kernel/ index.
 * All data visible without JS. Numbers are demo labels.
 */
import KernelMetric from './kernel/KernelMetric.astro';
import { dashboardMetrics, type DashboardMetric } from '../data/kernel';

interface Props {
  metrics?: DashboardMetric[];
}
const { metrics = dashboardMetrics } = Astro.props;
---

<style>
  .k-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }
</style>

<section aria-label="مؤشرات لوحة التشغيل">
  <div class="k-metrics">
    {metrics.map(m => (
      <KernelMetric label={m.label} value={m.value} trend={m.trend} demo={m.demo} />
    ))}
  </div>
</section>