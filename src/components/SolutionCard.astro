---
/**
 * SolutionCard — Card for a single solution on the index page
 */
import type { SolutionData } from '../data/solutions';
interface Props { solution: SolutionData; }
const { solution } = Astro.props;
---
<a href={solution.href} class="inner-card solution-index-card" style="display:block;text-decoration:none;color:inherit;height:100%;">
  <div class="solution-icon-wrap">
    <iconify-icon icon={solution.icon}></iconify-icon>
  </div>
  <span class="inner-hero__badge mb-3" style="font-size:0.7rem;">{solution.chip}</span>
  <h3 class="inner-card__title text-lg">{solution.h1.split(' ').length > 4 ? solution.h1 : solution.title.split(' | ')[0]}</h3>
  <p class="inner-card__text mb-3">{solution.shortDesc}</p>
  <p class="text-xs text-cyan-300 mt-auto">متى تحتاجه؟ {solution.whenNeeded}</p>
</a>
<style>
  .solution-icon-wrap {
    width: 56px; height: 56px; border-radius: 1rem;
    background: linear-gradient(135deg, rgba(34,211,238,.15), rgba(124,92,255,.15));
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; color: #67e8f9; margin-bottom: 1rem;
  }
  .solution-index-card {
    display: flex; flex-direction: column; transition: all .3s ease;
  }
  .solution-index-card:hover {
    transform: translateY(-4px);
  }
</style>