---
/**
 * SolutionCard — Card for a single solution on the index page.
 * Uses V4 unified card system (REPORT-07, DEC-2026-034).
 *
 * Anatomy:
 *   - .card__icon      — brand-glow icon (top)
 *   - .card__eyebrow   — uppercase category tag
 *   - .card__title     — h3-style headline
 *   - .card__desc      — lead paragraph
 *   - .card__meta      — bottom row (stats / badges / arrow)
 *   - .card__action    — cta link with arrow
 */
import type { SolutionData } from '../data/solutions';
import Icon from '../components/Icon.astro';

interface Props { solution: SolutionData; }
const { solution } = Astro.props;

const cardTitle =
  solution.cardTitle ??
  (solution.h1.split(' ').length > 4 ? solution.h1 : solution.title.split(' | ')[0]);
---

<a
  href={solution.href}
  class="card card--feature card--interactive solution-card"
  aria-label={solution.h1}
>
  <span class="card__icon" aria-hidden="true">
    <Icon name={solution.icon} />
  </span>

  {solution.chip && <span class="card__eyebrow">{solution.chip}</span>}

  <h3 class="card__title">{cardTitle}</h3>

  <p class="card__desc">{solution.shortDesc}</p>

  <p class="card__meta">
    <span class="card__meta-label">
      {solution.whenLabel ?? 'متى تحتاجه؟'}
    </span>
    <span class="card__meta-value">{solution.whenNeeded}</span>
  </p>

  <span class="card__action">اعرف المزيد</span>
</a>

<style>
  .solution-card {
    /* Override the inline default; the .card + .card--feature base already covers layout */
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  /* Meta label uses eyebrow tone for visual hierarchy */
  .solution-card .card__meta-label {
    font-weight: var(--font-medium);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    opacity: 0.78;
  }

  .solution-card .card__meta-value {
    color: var(--brand-300);
    font-weight: var(--font-semibold);
  }
</style>