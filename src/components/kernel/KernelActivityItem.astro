---
/**
 * KernelActivityItem — Single activity entry for KernelActivityList.
 * tone: default | success | warning | danger
 */
interface Props {
  title: string;
  tone?: 'default' | 'success' | 'warning' | 'danger';
  iconSvg?: string;
  traceId?: string;
  meta?: string;
  time?: string;
}

const { title, tone = 'default', iconSvg = '', traceId = '', meta = '', time = '' } = Astro.props;

const iconClass = tone === 'success' ? 'kernel-activity-item__icon--success'
                 : tone === 'warning' ? 'kernel-activity-item__icon--warning'
                 : tone === 'danger' ? 'kernel-activity-item__icon--danger'
                 : '';
---

<li class="kernel-activity-item">
  <span class:list={['kernel-activity-item__icon', iconClass]} aria-hidden="true">
    <Fragment set:html={iconSvg} />
  </span>
  <div class="kernel-activity-item__body">
    <span class="kernel-activity-item__title">{title}</span>
    {(traceId || meta) && (
      <div class="kernel-activity-item__meta">
        {traceId && <span class="kernel-activity-item__trace-id">{traceId}</span>}
        {meta && <span>{meta}</span>}
      </div>
    )}
  </div>
  {time && <span class="kernel-activity-item__time">{time}</span>}
</li>