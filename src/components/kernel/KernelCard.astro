---
/**
 * KernelCard — Generic card surface (white-on-dark glass).
 * Anatomy: header (icon + title + actions) + body slot + footer slot.
 * Use accent variant for featured/primary content.
 */
interface Props {
  title: string;
  subtitle?: string;
  iconSvg?: string;
  accent?: boolean;
  /** ARIA: full card landmark. Default: false (treat as <article>). */
  labelledBy?: string;
}

const { title, subtitle = '', iconSvg = '', accent = false, labelledBy } = Astro.props;

const headingId = labelledBy ?? `kc-${Math.random().toString(36).slice(2, 9)}`;
---

<article class:list={['kernel-card', accent && 'kernel-card--accent']} aria-labelledby={headingId}>
  {(title || iconSvg) && (
    <header class="kernel-card__header">
      <div class="kernel-card__lead">
        {iconSvg && <span class="kernel-card__icon" aria-hidden="true"><Fragment set:html={iconSvg} /></span>}
        <div class="kernel-card__title-block">
          {title && <h3 class="kernel-card__title" id={headingId}>{title}</h3>}
          {subtitle && <span class="kernel-card__subtitle">{subtitle}</span>}
        </div>
      </div>
      <div class="kernel-card__actions">
        <slot name="actions" />
      </div>
    </header>
  )}
  <div class:list={['kernel-card__body']}>
    <slot />
  </div>
  <slot name="footer" />
</article>