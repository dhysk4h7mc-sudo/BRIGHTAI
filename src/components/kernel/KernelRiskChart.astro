---
/**
 * KernelRiskChart — Risk distribution bar chart.
 * Renders rows with label + progress bar + value.
 */
interface RiskRow {
  label: string;
  level: 'minimal' | 'low' | 'medium' | 'high' | 'critical';
  /** Percentage 0-100 */
  value: number;
}

interface Props {
  rows: RiskRow[];
}

const { rows = [] } = Astro.props;
---

<div class="kernel-risk-chart">
  {rows.map(row => (
    <div class="kernel-risk-row">
      <span class:list={['kernel-risk-row__label', `kernel-risk-row__label--${row.level}`]}>{row.label}</span>
      <span
        class="kernel-risk-row__bar"
        role="progressbar"
        aria-label={`${row.label} ${row.value}%`}
        aria-valuenow={row.value}
        aria-valuemin="0"
        aria-valuemax="100"
      >
        <span
          class:list={['kernel-risk-row__fill', `kernel-risk-row__fill--${row.level}`]}
          style={`inline-size: ${row.value}%`}
        ></span>
      </span>
      <span class="kernel-risk-row__value">{row.value}<small>%</small></span>
    </div>
  ))}
</div>