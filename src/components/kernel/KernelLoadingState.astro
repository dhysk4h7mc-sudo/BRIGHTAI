---
/**
 * KernelLoadingState — Skeleton loading state for Kernel data sections.
 * Shows animated placeholder blocks while data is loading.
 * Uses V2 design tokens. CSS-only, no JS.
 */
interface Props {
  label?: string;
  rows?: number;
}
const { label = 'جاري التحميل...', rows = 3 } = Astro.props;
---

<style>
  .k-loading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) 0;
  }
  .k-loading__label {
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin-bottom: var(--space-1);
  }
  .k-loading__row {
    height: 1rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, var(--surface-soft) 25%, var(--surface) 50%, var(--surface-soft) 75%);
    background-size: 200% 100%;
    animation: k-loading-shimmer 1.5s ease-in-out infinite;
  }
  .k-loading__row:last-child {
    width: 60%;
  }
  @keyframes k-loading-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .k-loading__row {
      animation: none;
      background: var(--surface-soft);
    }
  }
</style>

<div class="k-loading" role="status" aria-label={label}>
  <span class="k-loading__label">{label}</span>
  {Array.from({ length: rows }, (_, i) => (
    <div class="k-loading__row" style={`width: ${85 - i * 10}%`} />
  ))}
</div>