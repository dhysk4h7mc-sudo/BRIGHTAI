---
/**
 * KernelMetricCard — KPI tile used on dashboard + sub-pages.
 * Variants: brand (gradient text) | gold (copper) | plain
 * Trend: up | down | flat | null
 */
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  trend?: 'up' | 'down' | 'flat' | null;
  trendLabel?: string;
  variant?: 'brand' | 'gold' | 'plain';
  iconSvg?: string;
  footer?: string;
}

const {
  label,
  value,
  unit = '',
  trend = null,
  trendLabel = '',
  variant = 'plain',
  iconSvg = '',
  footer = '',
} = Astro.props;

const valueClass = variant === 'brand' ? 'kernel-metric-card__value--brand'
                  : variant === 'gold' ? 'kernel-metric-card__value--gold'
                  : '';

const trendClass = trend === 'up' ? 'kernel-metric-card__trend--up'
                  : trend === 'down' ? 'kernel-metric-card__trend--down'
                  : trend === 'flat' ? 'kernel-metric-card__trend--flat'
                  : '';

const trendArrow = trend === 'up' ? '▲'
                  : trend === 'down' ? '▼'
                  : '—';
---

<article class="kernel-metric-card">
  <header class="kernel-metric-card__header">
    <span class="kernel-metric-card__label">
      {iconSvg && <span class="kernel-metric-card__label-icon" aria-hidden="true"><Fragment set:html={iconSvg} /></span>}
      {label}
    </span>
    {trend && (
      <span class:list={['kernel-metric-card__trend', trendClass]} aria-label={trendLabel}>
        {trendArrow} {trendLabel}
      </span>
    )}
  </header>
  <div>
    <span class:list={['kernel-metric-card__value', valueClass]}>{value}</span>
    {unit && <span class="kernel-metric-card__unit">{unit}</span>}
  </div>
  {footer && <footer class="kernel-metric-card__footer">{footer}</footer>}
</article>