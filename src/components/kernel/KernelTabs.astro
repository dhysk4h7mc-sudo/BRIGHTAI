---
/**
 * KernelTabs — Pill tabs with optional count badges.
 * Pure CSS. ARIA: role="tablist" on container, role="tab" on items.
 * Selection is rendered server-side via Astro; switching is the page's job
 * (we don't auto-wire click handlers — different pages need different behavior).
 */
interface TabItem {
  id: string;
  label: string;
  count?: number | null;
  selected?: boolean;
}

interface Props {
  tabs: TabItem[];
  ariaLabel?: string;
}

const { tabs, ariaLabel = 'tabs' } = Astro.props;
---

<div class="kernel-tabs" role="tablist" aria-label={ariaLabel}>
  {tabs.map(tab => (
    <button
      class="kernel-tabs__item"
      role="tab"
      type="button"
      data-tab-id={tab.id}
      aria-selected={tab.selected ? 'true' : 'false'}
      aria-controls={`tabpanel-${tab.id}`}
    >
      {tab.label}
      {tab.count != null && <span class="kernel-tabs__count">{tab.count}</span>}
    </button>
  ))}
</div>