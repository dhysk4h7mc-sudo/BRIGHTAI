---
/**
 * KernelPageHeader — Unified page header for all Kernel sub-pages.
 * Shows h1, optional badge, and optional short description.
 * Uses V2 design tokens. CSS-only, no JS.
 */
import KernelBadge from './KernelBadge.astro';

interface Props {
  h1: string;
  badge?: { level: 'minimal' | 'low' | 'medium' | 'high' | 'critical'; label: string };
  description?: string;
}

const { h1, badge, description } = Astro.props;
---

<style>
  .k-page-header {
    margin-bottom: 1.5rem;
  }
  .k-page-header h1 {
    font-size: clamp(1.375rem, 3.5vw, 2rem);
    font-weight: var(--weight-extrabold);
    color: var(--text);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }
  .k-page-header__badge {
    margin-bottom: var(--space-2);
  }
  .k-page-header p {
    font-size: var(--text-sm);
    color: var(--text-soft);
    line-height: var(--leading-relaxed);
    max-width: 48rem;
  }
</style>

<div class="k-page-header">
  {badge && (
    <div class="k-page-header__badge">
      <KernelBadge level={badge.level} label={badge.label} size="md" />
    </div>
  )}
  <h1>{h1}</h1>
  {description && <p>{description}</p>}
</div>