---
/**
 * KernelStatCard — Unified statistics card for Kernel pages.
 * Shows a metric value, label, and optional trend.
 * Uses V2 design tokens. CSS-only, no JS.
 */
interface Props {
  value: string;
  label: string;
  trend?: string;
  accent?: 'brand' | 'success' | 'warning' | 'error' | 'info';
}

const { value, label, trend, accent = 'brand' } = Astro.props;
---

<style>
  .k-stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .k-stat-card--brand { border-top: 3px solid var(--brand); }
  .k-stat-card--success { border-top: 3px solid var(--success); }
  .k-stat-card--warning { border-top: 3px solid var(--warning); }
  .k-stat-card--error { border-top: 3px solid var(--error); }
  .k-stat-card--info { border-top: 3px solid var(--info); }

  .k-stat-card__value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    color: var(--text);
    line-height: 1;
  }
  .k-stat-card__label {
    font-size: var(--text-xs);
    color: var(--text-soft);
    font-weight: var(--weight-medium);
  }
  .k-stat-card__trend {
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin-top: var(--space-1);
  }
</style>

<div class={`k-stat-card k-stat-card--${accent}`}>
  <span class="k-stat-card__value">{value}</span>
  <span class="k-stat-card__label">{label}</span>
  {trend && <span class="k-stat-card__trend">{trend}</span>}
</div>