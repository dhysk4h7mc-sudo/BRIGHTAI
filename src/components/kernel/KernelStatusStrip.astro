---
/**
 * KernelStatusStrip — Provider/DB/mode status bar at top of dashboard.
 * - Visually emphasizes the connection state.
 * - Items array: [{ label, value, dot? }]
 */
interface StatusItem {
  label: string;
  value: string;
}

interface Props {
  kicker: string;
  title: string;
  dot?: 'ok' | 'warn' | 'err' | null;
  items: StatusItem[];
}

const { kicker, title, dot = 'ok', items = [] } = Astro.props;
---

<section class="kernel-status-strip" role="status" aria-live="polite">
  <div class="kernel-status-strip__lead">
    <span class:list={['kernel-status-strip__dot', dot === 'ok' && 'kernel-status-strip__dot--ok', dot === 'warn' && 'kernel-status-strip__dot--warn', dot === 'err' && 'kernel-status-strip__dot--err']} aria-hidden="true"></span>
    <div class="kernel-status-strip__lead-text">
      <span class="kernel-status-strip__kicker">{kicker}</span>
      <h2 class="kernel-status-strip__title">{title}</h2>
    </div>
  </div>
  <div class="kernel-status-strip__meta">
    {items.map(item => (
      <div class="kernel-status-strip__meta-item">
        <span class="kernel-status-strip__meta-label">{item.label}</span>
        <strong class="kernel-status-strip__meta-value">{item.value}</strong>
      </div>
    ))}
  </div>
</section>