---
/**
 * KernelTable — Unified data table for Kernel pages.
 * Renders a responsive table with headers and rows.
 * Uses V2 design tokens. CSS-only, no JS.
 */
interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
  compact?: boolean;
}

const { headers, rows, caption, compact = false } = Astro.props;
---

<style>
  .k-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .k-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .k-table--compact .k-table {
    font-size: var(--text-xs);
  }
  .k-table caption {
    font-size: var(--text-xs);
    color: var(--text-faint);
    padding: var(--space-2) var(--space-3);
    text-align: start;
  }
  .k-table th {
    background: var(--surface-soft);
    color: var(--text-soft);
    font-weight: var(--weight-semibold);
    font-size: var(--text-xs);
    text-align: start;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .k-table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border-soft);
    color: var(--text);
    vertical-align: top;
  }
  .k-table tbody tr:last-child td {
    border-bottom: none;
  }
  .k-table tbody tr:hover {
    background: var(--surface-soft);
  }
</style>

<div class={`k-table-wrap ${compact ? 'k-table--compact' : ''}`}>
  <table class="k-table">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {headers.map(h => <th scope="col">{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>
          {row.map(cell => <td set:html={cell} />)}
        </tr>
      ))}
    </tbody>
  </table>
</div>