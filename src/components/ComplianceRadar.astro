---
/**
 * ComplianceRadar — Framework compliance bars for /kernel/compliance/.
 * CSS-only, no JS. "يدعم مواءمة الضوابط" phrasing only.
 */
import KernelBadge from './kernel/KernelBadge.astro';
import { complianceFrameworks } from '../data/kernel';
import type { ComplianceFramework } from '../data/kernel';

interface Props { frameworks?: ComplianceFramework[] }
const { frameworks = complianceFrameworks } = Astro.props;

function statusLabel(s: string): string {
  const m: Record<string, string> = { active: 'نشط', partial: 'جزئي', 'not-started': 'لم يبدأ' };
  return m[s] || s;
}
function statusLevel(s: string): 'minimal' | 'low' | 'medium' | 'high' | 'critical' {
  const m: Record<string, 'minimal' | 'low' | 'medium' | 'high' | 'critical'> = {
    active: 'minimal',
    partial: 'medium',
    'not-started': 'high',
  };
  return m[s] || 'medium';
}
---

<style>
  .k-radar { display: grid; gap: var(--space-6); }
  .k-radar__item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
  }
  .k-radar__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .k-radar__name {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }
  .k-radar__name small {
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--text-soft);
    display: block;
    margin-top: var(--space-0-5);
  }
  .k-radar__bar-track {
    width: 100%;
    height: 8px;
    background: var(--surface-soft);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .k-radar__bar-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width var(--duration-slow) var(--ease-out);
  }
  .k-radar__score {
    font-size: var(--text-xs);
    color: var(--text-soft);
    margin-top: var(--space-1-5);
  }
  .k-radar__desc {
    font-size: var(--text-xs);
    color: var(--text-soft);
    margin-top: var(--space-2);
    line-height: var(--leading-relaxed);
  }
  .k-radar__demo {
    display: inline-block;
    font-size: 0.625rem;
    color: var(--text-faint);
    background: var(--glass);
    border-radius: var(--radius-xs);
    padding: var(--space-0-5) var(--space-1-5);
    margin-top: var(--space-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .k-radar__bar-fill { transition: none; }
  }
</style>

<div class="k-radar" aria-label="أطر الامتثال">
  {frameworks.map(fw => (
    <article class="k-radar__item">
      <div class="k-radar__header">
        <div class="k-radar__name">
          {fw.name}
          <small>{fw.nameAr}</small>
        </div>
        <KernelBadge level={statusLevel(fw.status)} label={statusLabel(fw.status)} size="md" />
      </div>
      <div class="k-radar__bar-track">
        <div
          class="k-radar__bar-fill"
          style={`width:${fw.score}%;background:${fw.status === 'active' ? 'var(--success)' : fw.status === 'partial' ? 'var(--warning)' : 'var(--text-faint)'}`}
        ></div>
      </div>
      <div class="k-radar__score">{fw.score} من {fw.maxScore}</div>
      <p class="k-radar__desc">{fw.description}</p>
      {fw.demo && <span class="k-radar__demo">بيانات توضيحية</span>}
    </article>
  ))}
</div>