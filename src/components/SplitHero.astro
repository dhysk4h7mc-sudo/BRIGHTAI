<script>
  // Spotlight effect — desktop only, ~20 lines vanilla JS
  (function setupSpotlight() {
    let raf = 0;
    let targetX = 0, targetY = 0, currentX = 0, currentY = 0;

    function update() {
      currentX += (targetX - currentX) * 0.15;
      currentY += (targetY - currentY) * 0.15;
      if (spotlight) {
        spotlight.style.background = `radial-gradient(300px circle at ${currentX}px ${currentY}px, rgba(34,211,238,0.08), transparent 70%)`;
      }
      if (Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
        raf = requestAnimationFrame(update);
      } else {
        raf = 0;
      }
    }

    let hero: HTMLElement | null = null;
    let spotlight: HTMLElement | null = null;

    function init() {
      hero = document.querySelector('.split-hero');
      spotlight = document.querySelector('.split-hero__spotlight');
      if (!hero || !spotlight || !window.matchMedia('(min-width: 768px)').matches) return;

      const heroEl = hero;
      const spotlightEl = spotlight;
      heroEl.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = heroEl.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        if (!raf) raf = requestAnimationFrame(update);
      });
      heroEl.addEventListener('mouseleave', () => {
        spotlightEl.style.background = 'transparent';
      });
    }

    function destroy() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      hero = null;
      spotlight = null;
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', destroy);
  })();
</script>

<script>
  // Kernel panel 3D tilt — vanilla JS, max 6deg, respects prefers-reduced-motion.
  // ~0.4KB minified. Skipped entirely on touch devices.
  (function setupTilt() {
    let panel: HTMLElement | null = null;
    let raf = 0;
    let tx = 0, ty = 0;

    function apply() {
      if (panel) {
        panel.style.setProperty('--tilt-x', tx.toFixed(3));
        panel.style.setProperty('--tilt-y', ty.toFixed(3));
      }
      raf = 0;
    }
    function onMove(e: MouseEvent) {
      if (!panel) return;
      const r = panel.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      // clamp to [-1, 1], multiply by 6deg in CSS
      tx = Math.max(-1, Math.min(1, (x - 0.5) * 2));
      ty = Math.max(-1, Math.min(1, (y - 0.5) * 2));
      if (!raf) raf = requestAnimationFrame(apply);
    }
    function reset() {
      tx = 0; ty = 0;
      if (!raf) raf = requestAnimationFrame(apply);
    }

    function init() {
      // Gate 1 — reduced motion: no tilt at all
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Gate 2 — coarse pointer (touch): no hover, skip
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      // Gate 3 — narrow viewports: skip (mobile CSS already disables via transform)
      if (!window.matchMedia('(min-width: 768px)').matches) return;

      panel = document.querySelector('.home-kernel-panel');
      if (!panel) return;
      const el = panel;
      el.addEventListener('mousemove', onMove, { passive: true });
      el.addEventListener('mouseleave', reset, { passive: true });
    }

    function destroy() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      if (panel) {
        panel.removeEventListener('mousemove', onMove);
        panel.removeEventListener('mouseleave', reset);
        panel.style.removeProperty('--tilt-x');
        panel.style.removeProperty('--tilt-y');
      }
      panel = null;
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', destroy);
  })();
</script>