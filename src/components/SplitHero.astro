---
/**
 * SplitHero.astro — Premium split-layout hero.
 *
 * Design intent: Faithful production-safe adaptation of the
 * 21st.dev "serafim/splite" split/Spline-inspired hero pattern.
 *
 * Architecture:
 *   - Left column: Server-rendered hero text, CTAs, trust chip (SSR, SEO-safe)
 *   - Right column: Kernel showcase panel (SSR, interactive links)
 *   - Background layer: DottedSurface React island (canvas-based interactive
 *     dotted grid, 21st.dev inspired) hydrated lazily via client:visible
 *
 * Content Preservation Rule:
 *   This component preserves EXACTLY the same hero text, CTAs, links,
 *   trust chip, and semantic structure as the original SparklesHero.
 *   Only the visual/technical implementation changed.
 *
 * Performance:
 *   - Hero text is 100% server-rendered — no hydration needed for LCP
 *   - HeroVisual uses client:visible (lazy hydration)
 *   - Respects prefers-reduced-motion (static poster)
 *   - Mobile: reduced particle count, no connection lines
 *   - DPR capped at 2, fps throttled on low-power devices
 *   - Pauses when off-screen or tab hidden
 *
 * RTL: Layout flows naturally with logical properties (inset-inline, etc.)
 */

import DottedSurface from './hero/DottedSurface.tsx';
---

<section class="split-hero" aria-label="BrightAI الرئيسية">
  {/* ─── Interactive Dotted-Surface (React island, client:visible) ─── */}
  <div class="split-hero__visual" aria-hidden="true">
    <DottedSurface client:visible />
  </div>

  {/* ─── Gradient beam accents (pure CSS, enhanced) ─── */}
  <div class="split-hero__beams" aria-hidden="true">
    <div class="split-hero__beam split-hero__beam--wide-blur"></div>
    <div class="split-hero__beam split-hero__beam--wide"></div>
    <div class="split-hero__beam split-hero__beam--narrow-blur"></div>
    <div class="split-hero__beam split-hero__beam--narrow"></div>
  </div>

  {/* ─── Mouse-following spotlight (desktop only, CSS-driven) ─── */}
  <div class="split-hero__spotlight" aria-hidden="true"></div>

  {/* ─── Vignette overlay for text legibility ─── */}
  <div class="split-hero__vignette" aria-hidden="true"></div>

  {/* ─── Hero Content Grid ─── */}
  <div class="split-hero__grid">

    {/* Left Column — Main Hero Content */}
    <div class="split-hero__main">
      <span class="chip split-hero__chip">
        <span class="split-hero__dot pulse-dot"></span>
        🇸🇦 صنع في السعودية
      </span>

      <div class="split-hero__title-wrap">
        <h1 id="hero-title" class="split-hero__h1" transition:animate="fade">
          منصة أمان وحوكمة
          <span class="gradient-text">الذكاء الاصطناعي</span>
          للشركات
          <span class="gradient-text">السعودية</span>
        </h1>
      </div>

      <p class="split-hero__lead">
        <strong>BrightAI</strong> تقدم <strong class="text-white">Saudi AI Safety OS</strong>:
        <strong class="text-white">نواة أمان وتشغيل</strong> تدخل بين الموظف والـ AI وبيانات الشركة،
        وتضمن إن كل طلب ذكاء اصطناعي يكون
        <span class="text-white">آمن، موثّق، وقابل للمراجعة</span>.
      </p>

      <div class="home-hero-actions">
        <a href="https://wa.me/966538229013" target="_blank" rel="noopener noreferrer" class="wa-btn">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg> واتساب
        </a>
        <a href="/contact/" class="home-cta-primary">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg>
          <span>احجز ديمو</span>
        </a>
        <a href="/solutions/ai-governance-platform/" class="home-cta-secondary">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-scale-balance"></use></svg>
          <span>منصة الحوكمة</span>
        </a>
        <a href="/kernel/" class="home-cta-secondary">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-gauge"></use></svg>
          <span>BrightAI Kernel</span>
        </a>
      </div>
    </div>

    {/* Right Column — Kernel Showcase */}
    <aside class="home-kernel-showcase" aria-labelledby="kernel-demo-title">
      <div class="home-kernel-panel">
        <div class="home-kernel-bar">
          <div class="home-kernel-dots"><span style="--dot:#ef4444"></span><span style="--dot:#f59e0b"></span><span style="--dot:#22c55e"></span></div>
          <span class="home-kernel-path">brightai.site/kernel</span>
        </div>
        <div class="home-kernel-body">
          <span class="home-kernel-badge">
            <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-lock-open-variant"></use></svg>
            نموذج تجريبي مجاني للشركات
          </span>
          <h2 class="home-kernel-title" id="kernel-demo-title">جرّب BrightAI Kernel كأنك داخل غرفة تشغيل شركتك</h2>
          <p class="home-kernel-copy">
            تدخل التجربة، ترسل طلبات عمل واقعية، وتشوف كيف الـ Kernel يحمي البيانات الحساسة، يطبق السياسات،
            يوقف القرارات العالية المخاطر للموافقة، ويوثق كل خطوة بدليل واضح يصلح لفريق الأمن والامتثال.
          </p>
          <div class="home-kernel-actions">
            <a href="/kernel/" class="home-kernel-action home-kernel-action--primary">
              <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-gauge"></use></svg>
              <span>ابدأ التجربة المجانية</span>
            </a>
            <a href="/kernel/chat/" class="home-kernel-action home-kernel-action--secondary">
              <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-message-text"></use></svg>
              <span>اختبر المحادثة الآمنة</span>
            </a>
          </div>
        </div>
      </div>

      <div class="home-kernel-features" aria-labelledby="kernel-features-title">
        <div class="home-kernel-feature-header">
          <h2 id="kernel-features-title">وش تقدر تجرّب؟</h2>
          <p>كل مسار هنا يوريك جزء من اللي نقدمه للشركات قبل ربطه بأنظمتها الفعلية.</p>
          <span class="home-kernel-feature-count">10 مزايا</span>
        </div>
        <div class="home-kernel-feature-grid">
          <a href="/kernel/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-gauge"></use></svg></span><span><span class="home-kernel-feature-title">لوحة تشغيل واحدة</span><span class="home-kernel-feature-copy">حالة النواة، الطلبات، المخاطر، وآخر الأحداث من مكان واحد.</span></span></a>
          <a href="/kernel/chat/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-message-text"></use></svg></span><span><span class="home-kernel-feature-title">محادثة آمنة</span><span class="home-kernel-feature-copy">اسأل النموذج، والـ Kernel يفحص البيانات والسياسات قبل الرد.</span></span></a>
          <a href="/kernel/audit/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-file-lock"></use></svg></span><span><span class="home-kernel-feature-title">سجل تدقيق كامل</span><span class="home-kernel-feature-copy">كل طلب وقرار محفوظ بتوقيت، درجة مخاطر، وهاش قابل للمراجعة.</span></span></a>
          <a href="/kernel/evidence/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-folder-open"></use></svg></span><span><span class="home-kernel-feature-title">ملف أدلة</span><span class="home-kernel-feature-copy">اجمع المدخلات والردود وسلسلة التدقيق كدليل واضح للمدقق.</span></span></a>
          <a href="/kernel/approvals/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-account-check"></use></svg></span><span><span class="home-kernel-feature-title">موافقات بشرية</span><span class="home-kernel-feature-copy">أي قرار حساس يتوقف لين يراجعه الشخص المخول داخل الشركة.</span></span></a>
          <a href="/kernel/compliance/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-scale-balance"></use></svg></span><span><span class="home-kernel-feature-title">متابعة الامتثال</span><span class="home-kernel-feature-copy">اربط استخدامات AI بضوابط PDPL وNCA وحزم الحوكمة السعودية.</span></span></a>
          <a href="/kernel/policies/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-tune"></use></svg></span><span><span class="home-kernel-feature-title">محرر السياسات</span><span class="home-kernel-feature-copy">اضبط قواعد الاستخدام، الحساسية، والتصعيد بدون تعقيد تقني.</span></span></a>
          <a href="/kernel/connectors/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-power-plug"></use></svg></span><span><span class="home-kernel-feature-title">موصلات الأنظمة</span><span class="home-kernel-feature-copy">شوف تصور ربط ERP وCRM وHIS وSharePoint بطريقة مضبوطة.</span></span></a>
          <a href="/kernel/reports/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-chart-bar"></use></svg></span><span><span class="home-kernel-feature-title">تقارير تنفيذية</span><span class="home-kernel-feature-copy">حوّل نشاط الذكاء الاصطناعي إلى تقرير يفهمه الأمن والإدارة.</span></span></a>
          <a href="/kernel/scenarios/" class="home-kernel-feature-link"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#material-symbols-account-tree"></use></svg></span><span><span class="home-kernel-feature-title">سيناريوهات واقعية</span><span class="home-kernel-feature-copy">اختبر حالات مالية، موارد بشرية، قانونية، صحية، وأمن كود.</span></span></a>
        </div>
        <p class="home-kernel-footnote">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-information"></use></svg>
          التجربة تستخدم بيانات صناعية، وإذا ناسبتكم نركب نفس الفكرة على بياناتكم وأنظمتكم الفعلية.
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  /* ─── SplitHero Container ─── */
  .split-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: transparent; /* DottedBackground shows through */
  }

  /* ─── Premium Canvas Visual Scene ─── */
  .split-hero__visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .dotted-surface-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    will-change: transform;
    transform: translateZ(0);
    opacity: 0.9;
  }

  /* ─── Gradient Beams (pure CSS, enhanced) ─── */
  .split-hero__beams {
    position: absolute;
    top: 15%;
    inset-inline: 0;
    height: 4px;
    pointer-events: none;
    z-index: 1;
  }
  .split-hero__beam {
    position: absolute;
    top: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
  }
  .split-hero__beam--wide-blur {
    width: 75%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--interactive-primary), transparent);
    filter: blur(4px);
  }
  .split-hero__beam--wide {
    width: 75%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--interactive-primary), transparent);
  }
  .split-hero__beam--narrow-blur {
    width: 25%;
    height: 5px;
    background: linear-gradient(90deg, transparent, #0ea5e9, transparent);
    filter: blur(4px);
  }
  .split-hero__beam--narrow {
    width: 25%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #0ea5e9, transparent);
  }

  /* ─── Spotlight (mouse-follow, desktop only) ─── */
  .split-hero__spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: transparent;
    transition: background 0.3s ease;
  }

  /* ─── Vignette overlay for text legibility ─── */
  .split-hero__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      radial-gradient(ellipse 100% 80% at 30% 50%, rgba(4,7,17,0.5), transparent 70%),
      linear-gradient(180deg, transparent 0%, rgba(4,7,17,0.2) 100%);
  }
  [dir="rtl"] .split-hero__vignette {
    background:
      radial-gradient(ellipse 100% 80% at 70% 50%, rgba(4,7,17,0.5), transparent 70%),
      linear-gradient(180deg, transparent 0%, rgba(4,7,17,0.2) 100%);
  }

  /* ─── Grid Layout (7fr 5fr split) ─── */
  .split-hero__grid {
    position: relative;
    z-index: 20;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 3.5rem 1.25rem 5rem;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .split-hero__grid {
      grid-template-columns: 7fr 5fr;
      padding-top: 6rem;
      padding-bottom: 7rem;
    }
  }

  /* ─── Main Column ─── */
  .split-hero__main {
    text-align: center;
    position: relative;
    z-index: 21;
  }
  @media (min-width: 1024px) {
    .split-hero__main {
      text-align: right;
    }
  }

  /* Chip — refined for SaaS polish */
  .split-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: relative;
    z-index: 21;
  }
  .split-hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #34d399;
    display: inline-block;
  }

  /* Title */
  .split-hero__title-wrap {
    position: relative;
    width: 100%;
    margin-top: 1.25rem;
    z-index: 21;
  }
  .split-hero__h1 {
    font-size: 1.875rem;
    line-height: 1.18;             /* bumped 1.1 → 1.18 for Arabic diacritics baseline */
    font-weight: 900;
    letter-spacing: -0.012em;       /* optical tightening for Arabic display sizes */
    text-wrap: balance;             /* prevents orphaned trailing word */
    text-shadow: 0 2px 24px rgba(4,7,17,0.6);
  }
  @media (min-width: 640px) { .split-hero__h1 { font-size: 3rem; line-height: 1.15; } }
  @media (min-width: 1024px) {
    .split-hero__h1 { font-size: 3.5rem; line-height: 1.12; letter-spacing: -0.018em; }
  }

  /* Lead */
  .split-hero__lead {
    margin-top: 1.5rem;
    font-size: 1.0625rem;            /* slightly lighter weight felt */
    line-height: 1.85;
    max-width: 42rem;
    color: rgba(241, 245, 249, 0.82);
    font-weight: 400;                /* explicit regular weight vs headline 900 */
    text-wrap: pretty;               /* avoid orphans on multi-line Arabic */
    position: relative;
    z-index: 21;
    text-shadow: 0 1px 12px rgba(4,7,17,0.4);
  }
  .split-hero__lead strong { font-weight: 700; }
  @media (max-width: 1023px) {
    .split-hero__lead {
      margin-inline: auto;
      text-align: center;
    }
  }

  .text-white { color: #fff; }

  /* ─── Hero CTA Actions Row (was previously unstyled) ─── */
  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    margin-top: 2rem;
    position: relative;
    z-index: 21;
  }
  @media (min-width: 1024px) {
    .home-hero-actions {
      justify-content: flex-start;   /* RTL-aware: starts from reading-start edge */
      gap: var(--space-3);
      margin-top: 2.5rem;
    }
  }

  /* ─── CTA micro-interactions (hero-scoped polish on canonical buttons) ─── */
  .home-hero-actions .wa-btn,
  .home-hero-actions .home-cta-primary,
  .home-hero-actions .home-cta-secondary {
    position: relative;
    transform: translateZ(0);           /* isolate compositing layer */
    will-change: transform;
  }
  /* Brief pulse halo on the primary CTA — subtle, doesn't harm LCP */
  .home-hero-actions .home-cta-primary::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--brand-400), var(--indigo-400));
    opacity: 0;
    z-index: -1;
    filter: blur(12px);
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .home-hero-actions .home-cta-primary:hover::before { opacity: 0.55; }
  .home-hero-actions .home-cta-primary:active::before { opacity: 0.2; }

  /* ─── Kernel Showcase Panel (was unstyled) ─── */
  .home-kernel-showcase {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    perspective: 1100px;               /* enables 3D tilt of children */
    perspective-origin: 50% 30%;
    position: relative;
  }

  /* The showcase panel — browser-mockup card with 3D transform host */
  .home-kernel-panel {
    position: relative;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border-default);
    background:
      linear-gradient(180deg, rgba(34, 211, 238, 0.04), transparent 40%),
      linear-gradient(180deg, var(--bg-elevated), var(--bg-surface));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.02) inset,
      var(--shadow-2xl);
    overflow: hidden;
    transform-style: preserve-3d;       /* tilt target */
    transform:
      perspective(1100px)
      rotateX(calc(var(--tilt-y, 0) * 6deg))
      rotateY(calc(var(--tilt-x, 0) * -6deg));
    transition: transform 0.6s var(--ease-out);
    will-change: transform;
  }
  /* Subtle inner sheen on the panel */
  .home-kernel-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      120% 80% at 50% -10%,
      rgba(34, 211, 238, 0.08),
      transparent 55%
    );
    z-index: 0;
  }
  .home-kernel-panel > * { position: relative; z-index: 1; }

  /* Browser-chrome bar */
  .home-kernel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: rgba(4, 7, 17, 0.55);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .home-kernel-dots {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .home-kernel-dots span {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--dot, #888);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3);
  }
  .home-kernel-path {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    direction: ltr;                    /* path reads left-to-right regardless of page */
  }

  /* Body of the showcase */
  .home-kernel-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .home-kernel-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.375rem 0.75rem;
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.28);
    color: var(--brand-300);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .home-kernel-title {
    margin-top: var(--space-4);
    font-size: 1.125rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  @media (min-width: 640px) { .home-kernel-title { font-size: 1.25rem; } }

  .home-kernel-copy {
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* Kernel CTAs (separate from hero actions — distinct visual rhythm) */
  .home-kernel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .home-kernel-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.125rem;
    border-radius: var(--radius-lg);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out),
                background var(--duration-base) var(--ease-out);
    will-change: transform;
  }
  .home-kernel-action--primary {
    background: linear-gradient(135deg, var(--brand-500), var(--brand-600));
    color: white;
    box-shadow: 0 0 20px rgba(6, 182, 212, 0.25);
  }
  .home-kernel-action--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 32px rgba(6, 182, 212, 0.5);
    color: white;
    text-decoration: none;
  }
  .home-kernel-action--primary:active { transform: translateY(0); }

  .home-kernel-action--secondary {
