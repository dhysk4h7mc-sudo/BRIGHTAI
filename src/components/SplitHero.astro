<style>
  /* ─── SplitHero ─── */
  .split-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: transparent; /* DottedBackground shows through */
  }

  /* ─── Gradient Beams (pure CSS) ─── */
  .split-hero__beams {
    position: absolute;
    top: 15%;
    inset-inline: 0;
    height: 4px;
    pointer-events: none;
    z-index: 0;
  }
  .split-hero__beam {
    position: absolute;
    top: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
  }
  .split-hero__beam--wide-blur {
    width: 75%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--brand-strong, #14b8a6), transparent);
    filter: blur(4px);
  }
  .split-hero__beam--wide {
    width: 75%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brand-strong, #14b8a6), transparent);
  }
  .split-hero__beam--narrow-blur {
    width: 25%;
    height: 5px;
    background: linear-gradient(90deg, transparent, #0ea5e9, transparent);
    filter: blur(4px);
  }
  .split-hero__beam--narrow {
    width: 25%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #0ea5e9, transparent);
  }

  /* ─── Grid ─── */
  .split-hero__grid {
    position: relative;
    z-index: 20;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .split-hero__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ─── Main Column ─── */
  .split-hero__main {
    text-align: center;
  }
  @media (min-width: 1024px) {
    .split-hero__main {
      text-align: right;
    }
  }

  /* Chip */
  .split-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .split-hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #34d399;
    display: inline-block;
  }

  /* Title */
  .split-hero__title-wrap {
    position: relative;
    width: 100%;
    margin-top: 1.25rem;
  }
  .split-hero__h1 {
    font-size: 1.875rem;
    line-height: 1.1;
    font-weight: 900;
  }
  @media (min-width: 640px) { .split-hero__h1 { font-size: 3rem; } }
  @media (min-width: 1024px) { .split-hero__h1 { font-size: 3.75rem; } }

  /* Lead */
  .split-hero__lead {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    line-height: 2;
    max-width: 42rem;
    color: rgba(255, 255, 255, 0.75);
  }
  @media (max-width: 1023px) {
    .split-hero__lead {
      margin-inline: auto;
      text-align: center;
    }
  }

  .text-white { color: #fff; }

  /* ─── Spotlight (mouse-follow, desktop only) ─── */
  .split-hero__spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: transparent;
    transition: background 0.3s ease;
  }

  /* ─── 3D Geometric Scene ─── */
  .hero-3d-scene {
    position: absolute;
    top: 50%;
    inset-inline-start: 50%;
    width: 240px;
    height: 240px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
    opacity: 0.55;
  }
  [dir="rtl"] .hero-3d-scene {
    inset-inline-start: 25%;
  }
  @media (min-width: 1024px) {
    [dir="rtl"] .hero-3d-scene {
      inset-inline-start: 75%;
    }
  }

  .hero-octa-core {
    position: absolute;
    top: 50%;
    inset-inline-start: 50%;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(34,211,238,0.9), rgba(34,211,238,0.2));
    border-radius: 50%;
    box-shadow: 0 0 40px 8px rgba(34,211,238,0.4);
    animation: heroPulse 3s ease-in-out infinite;
  }
  @keyframes heroPulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    50% { transform: translate(-50%, -50%) scale(1.3); opacity: 0.7; }
  }

  .hero-octa-ring {
    position: absolute;
    top: 50%;
    inset-inline-start: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%) rotateX(60deg);
  }
  .hero-octa-ring--1 {
    width: 120px;
    height: 120px;
    border: 1px solid rgba(34,211,238,0.25);
    animation: heroRingSpin 8s linear infinite;
  }
  .hero-octa-ring--2 {
    width: 160px;
    height: 160px;
    border: 1px solid rgba(129,140,248,0.2);
    animation: heroRingSpin 12s linear infinite reverse;
  }
  .hero-octa-ring--3 {
    width: 200px;
    height: 200px;
    border: 1px dashed rgba(34,211,238,0.12);
    animation: heroRingSpin 20s linear infinite;
  }
  @keyframes heroRingSpin {
    from { transform: translate(-50%, -50%) rotateX(60deg) rotateZ(0deg); }
    to { transform: translate(-50%, -50%) rotateX(60deg) rotateZ(360deg); }
  }

  .hero-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(34,211,238,0.6);
    box-shadow: 0 0 6px rgba(34,211,238,0.4);
  }
  .hero-particle--1 { top: 20%; inset-inline-start: 30%; animation: heroParticleFloat 4s ease-in-out infinite; }
  .hero-particle--2 { top: 70%; inset-inline-start: 20%; animation: heroParticleFloat 5s ease-in-out infinite 0.5s; }
  .hero-particle--3 { top: 30%; inset-inline-start: 70%; animation: heroParticleFloat 6s ease-in-out infinite 1s; }
  .hero-particle--4 { top: 80%; inset-inline-start: 60%; animation: heroParticleFloat 4.5s ease-in-out infinite 1.5s; }
  .hero-particle--5 { top: 50%; inset-inline-start: 85%; animation: heroParticleFloat 5.5s ease-in-out infinite 2s; }
  @keyframes heroParticleFloat {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(-20px); opacity: 1; }
  }

  /* ─── Mobile ─── */
  @media (max-width: 768px) {
    .split-hero {
      min-height: auto;
      padding-top: 6rem;
      padding-bottom: 3rem;
    }
    .split-hero__visual { display: none; }
    .hero-octa-ring--3,
    .hero-particle { display: none; }
    .hero-3d-scene { opacity: 0.35; transform: translate(-50%, -50%) scale(0.7); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-octa-core,
    .hero-octa-ring,
    .hero-particle { animation: none; }
  }
</style>

<script>
  // Spotlight effect — desktop only, ~20 lines vanilla JS
  (function setupSpotlight() {
    let raf = 0;
    let targetX = 0, targetY = 0, currentX = 0, currentY = 0;

    function update() {
      currentX += (targetX - currentX) * 0.15;
      currentY += (targetY - currentY) * 0.15;
      if (spotlight) {
        spotlight.style.background = `radial-gradient(300px circle at ${currentX}px ${currentY}px, rgba(34,211,238,0.08), transparent 70%)`;
      }
      if (Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
        raf = requestAnimationFrame(update);
      } else {
        raf = 0;
      }
    }

    let hero: HTMLElement | null = null;
    let spotlight: HTMLElement | null = null;

    function init() {
      hero = document.querySelector('.split-hero');
      spotlight = document.querySelector('.split-hero__spotlight');
      if (!hero || !spotlight || !window.matchMedia('(min-width: 768px)').matches) return;

      const heroEl = hero;
      const spotlightEl = spotlight;
      heroEl.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = heroEl.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        if (!raf) raf = requestAnimationFrame(update);
      });
      heroEl.addEventListener('mouseleave', () => {
        spotlightEl.style.background = 'transparent';
      });
    }

    function destroy() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      hero = null;
      spotlight = null;
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', destroy);
  })();
</script>
