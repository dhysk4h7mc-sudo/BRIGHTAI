<style>
  /* ─── SplitHero Container ─── */
  .split-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: transparent; /* DottedBackground shows through */
  }

  /* ─── Premium Canvas Visual Scene ─── */
  .split-hero__visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .dotted-surface-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    will-change: transform;
    transform: translateZ(0);
    opacity: 0.9;
  }

  /* ─── Gradient Beams (pure CSS, enhanced) ─── */
  .split-hero__beams {
    position: absolute;
    top: 15%;
    inset-inline: 0;
    height: 4px;
    pointer-events: none;
    z-index: 1;
  }
  .split-hero__beam {
    position: absolute;
    top: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
  }
  .split-hero__beam--wide-blur {
    width: 75%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--brand-strong, #14b8a6), transparent);
    filter: blur(4px);
  }
  .split-hero__beam--wide {
    width: 75%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brand-strong, #14b8a6), transparent);
  }
  .split-hero__beam--narrow-blur {
    width: 25%;
    height: 5px;
    background: linear-gradient(90deg, transparent, #0ea5e9, transparent);
    filter: blur(4px);
  }
  .split-hero__beam--narrow {
    width: 25%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #0ea5e9, transparent);
  }

  /* ─── Spotlight (mouse-follow, desktop only) ─── */
  .split-hero__spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: transparent;
    transition: background 0.3s ease;
  }

  /* ─── Vignette overlay for text legibility ─── */
  .split-hero__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      radial-gradient(ellipse 100% 80% at 30% 50%, rgba(4,7,17,0.5), transparent 70%),
      linear-gradient(180deg, transparent 0%, rgba(4,7,17,0.2) 100%);
  }
  [dir="rtl"] .split-hero__vignette {
    background:
      radial-gradient(ellipse 100% 80% at 70% 50%, rgba(4,7,17,0.5), transparent 70%),
      linear-gradient(180deg, transparent 0%, rgba(4,7,17,0.2) 100%);
  }

  /* ─── Grid Layout (7fr 5fr split) ─── */
  .split-hero__grid {
    position: relative;
    z-index: 20;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 3.5rem 1.25rem 5rem;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .split-hero__grid {
      grid-template-columns: 7fr 5fr;
      padding-top: 6rem;
      padding-bottom: 7rem;
    }
  }

  /* ─── Main Column ─── */
  .split-hero__main {
    text-align: center;
    position: relative;
    z-index: 21;
  }
  @media (min-width: 1024px) {
    .split-hero__main {
      text-align: right;
    }
  }

  /* Chip */
  .split-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    position: relative;
    z-index: 21;
  }
  .split-hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #34d399;
    display: inline-block;
  }

  /* Title */
  .split-hero__title-wrap {
    position: relative;
    width: 100%;
    margin-top: 1.25rem;
    z-index: 21;
  }
  .split-hero__h1 {
    font-size: 1.875rem;
    line-height: 1.1;
    font-weight: 900;
    text-shadow: 0 2px 24px rgba(4,7,17,0.6);
  }
  @media (min-width: 640px) { .split-hero__h1 { font-size: 3rem; } }
  @media (min-width: 1024px) { .split-hero__h1 { font-size: 3.75rem; } }

  /* Lead */
  .split-hero__lead {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    line-height: 2;
    max-width: 42rem;
    color: rgba(255, 255, 255, 0.75);
    position: relative;
    z-index: 21;
    text-shadow: 0 1px 12px rgba(4,7,17,0.4);
  }
  @media (max-width: 1023px) {
    .split-hero__lead {
      margin-inline: auto;
      text-align: center;
    }
  }

  .text-white { color: #fff; }

  /* ─── Mobile ─── */
  @media (max-width: 768px) {
    .split-hero {
      min-height: auto;
      padding-top: 6rem;
      padding-bottom: 3rem;
    }
    /* Reduce visual complexity on mobile */
    .dotted-surface-canvas {
      opacity: 0.6;
    }
    .split-hero__vignette {
      background:
        radial-gradient(ellipse 100% 60% at 50% 30%, rgba(4,7,17,0.7), transparent 80%),
        linear-gradient(180deg, rgba(4,7,17,0.3) 0%, transparent 50%);
    }
  }

  /* ─── Reduced Motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .dotted-surface-canvas {
      opacity: 0.4;
    }
    /* Ensure static frame is visible */
    .split-hero__visual {
      opacity: 1;
    }
  }
</style>

<script>
  // Spotlight effect — desktop only, ~20 lines vanilla JS
  (function setupSpotlight() {
    let raf = 0;
    let targetX = 0, targetY = 0, currentX = 0, currentY = 0;

    function update() {
      currentX += (targetX - currentX) * 0.15;
      currentY += (targetY - currentY) * 0.15;
      if (spotlight) {
        spotlight.style.background = `radial-gradient(300px circle at ${currentX}px ${currentY}px, rgba(34,211,238,0.08), transparent 70%)`;
      }
      if (Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
        raf = requestAnimationFrame(update);
      } else {
        raf = 0;
      }
    }

    let hero: HTMLElement | null = null;
    let spotlight: HTMLElement | null = null;

    function init() {
      hero = document.querySelector('.split-hero');
      spotlight = document.querySelector('.split-hero__spotlight');
      if (!hero || !spotlight || !window.matchMedia('(min-width: 768px)').matches) return;

      const heroEl = hero;
      const spotlightEl = spotlight;
      heroEl.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = heroEl.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        if (!raf) raf = requestAnimationFrame(update);
      });
      heroEl.addEventListener('mouseleave', () => {
        spotlightEl.style.background = 'transparent';
      });
    }

    function destroy() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      hero = null;
      spotlight = null;
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', destroy);
  })();
</script>