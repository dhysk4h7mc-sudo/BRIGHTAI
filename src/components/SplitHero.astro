    <div class="hero-octa-ring hero-octa-ring--1"></div>
    <div class="hero-octa-ring hero-octa-ring--2"></div>
    <div class="hero-octa-ring hero-octa-ring--3"></div>
    <span class="hero-particle hero-particle--1"></span>
    <span class="hero-particle hero-particle--2"></span>
