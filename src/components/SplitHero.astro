    <div class="split-hero__beam split-hero__beam--narrow"></div>
  </div>

  {/* ─── Mouse-following spotlight (desktop only) ─── */}
  <div class="split-hero__spotlight" aria-hidden="true"></div>

  {/* ─── 3D geometric scene (CSS-only, decorative) ─── */}
  <div class="hero-3d-scene" aria-hidden="true">
