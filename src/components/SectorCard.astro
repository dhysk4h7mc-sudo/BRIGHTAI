---
/**
 * SectorCard — Card for a single sector on the solutions page.
 * Uses V3 unified design tokens instead of Tailwind.
 */
import type { SectorData } from '../data/solutions';
import Icon from '../components/Icon.astro';

interface Props { sector: SectorData; }
const { sector } = Astro.props;
---

<a href={sector.href} class="card card--feature solution-card" style="display:block;text-decoration:none;color:inherit;height:100%;">
  <div class="solution-card__icon">
    <Icon name={sector.icon} class="" />
  </div>
  <span class="badge badge--brand solution-card__chip">{sector.chip}</span>
  <h3 class="card__title solution-card__title">{sector.h1}</h3>
  <p class="card__description">{sector.shortDesc}</p>
  <p class="solution-card__when">متى تحتاجه؟ {sector.whenNeeded}</p>
</a>

<style>
  .solution-card {
    display: flex;
    flex-direction: column;
    transition: all var(--duration-base) var(--ease-out);
  }

  .solution-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .solution-card__icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, rgba(34,211,238,0.15), rgba(124,92,255,0.15));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--brand-300);
    margin-bottom: var(--space-4);
  }

  .solution-card__chip {
    margin-bottom: var(--space-3);
    align-self: flex-start;
  }

  .solution-card__title {
    margin-bottom: var(--space-3);
  }

  .solution-card__when {
    font-size: var(--text-xs);
    color: var(--interactive-primary);
    margin-top: auto;
    margin-bottom: 0;
  }
</style>