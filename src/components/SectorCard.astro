---
/**
 * SectorCard — Card for a single sector on /solutions/ hub.
 *
 * Uses the new `.sector-card` canonical pattern (REPORT-10):
 *   - sector-card__icon          — larger 64x64 brand-soft icon box
 *   - sector-card__title         — bold h3
 *   - sector-card__desc          — lead paragraph
 *   - sector-card__regulations   — bullet-style chip list (PDPL / NCA / SAMA / SFDA)
 *   - sector-card__action        — divider + arrow link, anchored bottom
 *
 * Sectors handled:
 *   - banking-ai-governance          → SAMA, NCA ECC, PDPL
 *   - government-ai-governance       → DGA, PDPL, NCA ECC
 *   - healthcare-ai-governance       → SFDA, ISO 13485, PDPL, NCA ECC
 *   - manufacturing-ai-governance    → NCA ECC, ISO 42001, PDPL
 *
 * NOTE: We intentionally keep this as a separate component from
 * SolutionCard.astro to preserve the typed API surface and the call sites
 * in /solutions/ and /solutions/[sector]/. The visual anatomy
 * (.card card--feature card--interactive) remains shared, but the markup
 * and CSS structure for regulations differs by use case.
 */
import type { SectorData } from '../data/solutions';
import Icon from '../components/Icon.astro';

interface Props { sector: SectorData; }
const { sector } = Astro.props;

const REGULATIONS_BY_SLUG: Record<string, string[]> = {
  'banking-ai-governance':       ['SAMA', 'NCA ECC', 'PDPL'],
  'government-ai-governance':    ['DGA',  'PDPL',    'NCA ECC'],
  'healthcare-ai-governance':    ['SFDA', 'ISO 13485', 'PDPL', 'NCA ECC'],
  'manufacturing-ai-governance': ['NCA ECC', 'ISO 42001', 'PDPL'],
};
const regulations = REGULATIONS_BY_SLUG[sector.slug] ?? ['PDPL', 'NCA ECC'];
---

<a
  href={sector.href}
  class="sector-card"
  aria-label={sector.h1}
>
  <span class="sector-card__icon" aria-hidden="true">
    <Icon name={sector.icon} />
  </span>

  <span class="chip chip--neutral">{sector.chip}</span>

  <h3 class="sector-card__title">{sector.h1}</h3>

  <p class="sector-card__desc">{sector.shortDesc}</p>

  <ul class="sector-card__regulations" aria-label="اللوائح المنطبقة على هذا القطاع">
    {regulations.map(r => <li>{r}</li>)}
  </ul>

  <span class="sector-card__action">
    اعرف المزيد
    <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-arrow-left"></use></svg>
  </span>
</a>
