---
/**
 * SectorCard — Card for a single sector on the solutions page.
 * Uses V4 unified card system (REPORT-07, DEC-2026-034).
 *
 * NOTE: SectorCard and SolutionCard share the same visual anatomy
 * (icon / eyebrow / title / desc / meta / action) but receive
 * different data shapes (SectorData vs SolutionData). We keep them
 * as separate components to preserve the typed API surface and to
 * avoid breaking the two call-sites in /solutions/ and /solutions/[sector]/.
 *
 * Anatomy:
 *   - .card__icon      — brand-glow icon (top)
 *   - .card__eyebrow   — uppercase category tag
 *   - .card__title     — h3-style headline
 *   - .card__desc      — lead paragraph
 *   - .card__meta      — bottom row
 *   - .card__action    — cta link with arrow
 */
import type { SectorData } from '../data/solutions';
import Icon from '../components/Icon.astro';

interface Props { sector: SectorData; }
const { sector } = Astro.props;
---

<a
  href={sector.href}
  class="card card--feature card--interactive solution-card"
  aria-label={sector.h1}
>
  <span class="card__icon" aria-hidden="true">
    <Icon name={sector.icon} />
  </span>

  {sector.chip && <span class="card__eyebrow">{sector.chip}</span>}

  <h3 class="card__title">{sector.h1}</h3>

  <p class="card__desc">{sector.shortDesc}</p>

  <p class="card__meta">
    <span class="card__meta-label">متى تحتاجه؟</span>
    <span class="card__meta-value">{sector.whenNeeded}</span>
  </p>

  <span class="card__action">اعرف المزيد</span>
</a>

<style>
  .solution-card {
    /* Override the inline default; the .card + .card--feature base already covers layout */
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .solution-card .card__meta-label {
    font-weight: var(--font-medium);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    opacity: 0.78;
  }

  .solution-card .card__meta-value {
    color: var(--brand-300);
    font-weight: var(--font-semibold);
  }
</style>