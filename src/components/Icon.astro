---
/**
 * Icon.astro — Lightweight SVG sprite icon component.
 * Replaces <iconify-icon icon="mdi:xxx"> with <svg><use href="/icons.svg#mdi-xxx"/></svg>.
 */
interface Props {
  name: string; // e.g. "mdi:shield" or "mdi-shield"
  class?: string;
  style?: string;
}

const { name, class: className = '', style = '' } = Astro.props;
// Normalize: "mdi:shield" → "mdi-shield"
const id = name.replace(':', '-');
---

<svg class:list={['icon', className]} style={style} aria-hidden="true" width="1em" height="1em">
  <use href={`/icons.svg#${id}`}></use>
</svg>

<style>
  .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.125em;
    fill: currentColor;
    flex-shrink: 0;
    line-height: 1;
  }
</style>
