---
/**
 * SectionReveal — Wrapper that reveals content on scroll.
 *
 * Adds the `.reveal` class to its children; the global IntersectionObserver
 * registered in BaseLayout.astro picks up any `.reveal` element (including
 * set:html injected content) and toggles `.is-visible` when it enters the viewport.
 *
 * CSS transitions are defined in animations.css. prefers-reduced-motion is
 * handled both in CSS (animations.css) and in the global observer script.
 */
interface Props {
  delay?: '1' | '2' | '3' | '4';
  class?: string;
}

const { delay, class: className = '' } = Astro.props;
const delayClass = delay ? `reveal--delay-${delay}` : '';
---

<section class:list={['reveal', delayClass, className]}>
  <slot />
</section>