---
/**
 * SectionReveal — Wrapper that reveals content on scroll.
 * Uses CSS transition + IntersectionObserver (progressive enhancement).
 */
interface Props {
  delay?: '1' | '2' | '3' | '4';
  class?: string;
}

const { delay, class: className = '' } = Astro.props;
const delayClass = delay ? `reveal--delay-${delay}` : '';
---

<section class:list={['reveal', delayClass, className]}>
  <slot />
</section>

<script>
  // Progressive enhancement: IntersectionObserver for scroll reveal
  document.addEventListener('astro:page-load', () => {
    const reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      reveals.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    reveals.forEach((el) => observer.observe(el));
  });
</script>