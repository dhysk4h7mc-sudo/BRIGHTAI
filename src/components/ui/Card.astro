---
/**
 * Card.astro — Canonical card component for BrightAI.
 *
 * Variants: feature | pricing | sector | solution | trust | stat
 * الـ variants موحدة عبر الموقع. كل variant يحترم canonical BEM
 * المستخدم في components.css (.card--feature / .card--pricing ...).
 *
 * السلوك:
 * - لا يحذف ولا يستبدل الـ Card الموجود في components.css.
 * - يستفيد من البنية الموجودة: .card, .card__icon, .card__title ...
 * - touch targets ≥ 44px للـ links.
 *
 * USAGE:
 *   <Card variant="feature" href="/solutions/..." icon="shield" eyebrow="حوكمة">
 *     <h3 slot="title">عنوان البطاقة</h3>
 *     <p slot="desc">الوصف</p>
 *   </Card>
 */
import '../../styles/global.css';

type Variant = 'feature' | 'pricing' | 'sector' | 'solution' | 'trust' | 'stat' | 'plain';

interface Props {
  variant?: Variant;
  /** Wrap in <a> when clickable */
  href?: string;
  /** Icon name (mdi-*) */
  icon?: string;
  /** Small uppercase tag above title (e.g. "حماية البيانات") */
  eyebrow?: string;
  /** Hover lift — only on links */
  interactive?: boolean;
  /** Pass-through class */
  class?: string;
}

const {
  variant = 'feature',
  href,
  icon,
  eyebrow,
  interactive,
  class: className = '',
} = Astro.props;

const isLink = !!href;
const Tag = isLink ? 'a' : 'div';

const classes = [
  'card',
  `card--${variant}`,
  (interactive ?? isLink) ? 'card--interactive' : '',
  className,
].filter(Boolean).join(' ');
---

<Tag class={classes} href={href}>
  {icon && (
    <span class="card__icon" aria-hidden="true">
      <svg width="1em" height="1em"><use href={`/icons.svg#mdi-${icon}`}></use></svg>
    </span>
  )}

  {eyebrow && <span class="card__eyebrow">{eyebrow}</span>}

  <slot name="title">
    {(Astro.slots.has('default')) && <slot />}
  </slot>

  <slot name="desc" />

  <slot name="meta" />

  <slot name="action" />

  <slot />
</Tag>

<style>
  /* ───────────────────────────────────────────
     BASE CARD
     يطابق canonical CSS في components.css،
     مع token-only (لا raw colors).
     ─────────────────────────────────────────── */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
    height: 100%;
    position: relative;
  }

  /* Internal heading继承 from components.css */
  .card :global(.card__title),
  .card :global(h3) {
    font-family: var(--font-arabic);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
  }

  .card :global(.card__desc),
  .card :global(p) {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ───────────────────────────────────────────
     VARIANTS
     ─────────────────────────────────────────── */
  .card--feature {
    background: var(--color-surface);
    border-color: var(--color-border-subtle);
  }

  .card--pricing {
    background: var(--color-surface-elevated);
    border-color: var(--color-border);
  }

  .card--sector,
  .card--solution {
    background: var(--color-surface);
    border-color: var(--color-border-subtle);
  }

  .card--trust {
    background: var(--color-surface);
    border-color: var(--color-border-subtle);
    text-align: center;
  }

  .card--stat {
    background: transparent;
    border: 1px solid var(--color-border);
    padding: var(--space-4);
  }

  .card--plain {
    background: transparent;
    border: none;
    padding: var(--space-3) 0;
  }

  /* ───────────────────────────────────────────
     INTERACTIVE (hover/active state for links)
     ─────────────────────────────────────────── */
  .card--interactive {
    cursor: pointer;
  }

  .card--interactive:hover {
    border-color: var(--color-primary);
    background: var(--color-surface-elevated);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  /* ───────────────────────────────────────────
     INNER PIECES
     ─────────────────────────────────────────── */
  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: var(--space-2);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    font-size: 1.5rem;
    border: 1px solid rgba(42, 138, 126, 0.2);
  }

  .card__icon :global(svg) {
    width: 1.25em;
    height: 1.25em;
    fill: currentColor;
  }

  .card__eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-primary-soft);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid rgba(42, 138, 126, 0.18);
    align-self: flex-start;
  }

  /* RTL eyebrow — Arabic: skip uppercase */
  [dir="rtl"] .card__eyebrow {
    text-transform: none;
    letter-spacing: 0;
  }

  /* RTL icon flip */
  [dir="rtl"] .card :global(.icon-arrow-left),
  [dir="rtl"] .card :global(svg[href$="arrow-left"]) {
    transform: scaleX(-1);
  }

  /* ───────────────────────────────────────────
     MOBILE — أقل padding على 375px
     ─────────────────────────────────────────── */
  @media (max-width: 479px) {
    .card {
      padding: var(--space-4);
      gap: var(--space-2);
    }

    .card__icon {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.25rem;
    }

    .card :global(h3) {
      font-size: var(--text-base);
    }
  }
</style>
