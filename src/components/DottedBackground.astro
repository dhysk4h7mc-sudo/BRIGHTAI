---
/**
 * DottedBackground.astro
 * Inspired by 21st.dev "efferd/dotted-surface" — a premium dotted surface
 * rendered with pure CSS radial-gradient mask. Zero JS, GPU-accelerated.
 *
 * Performance:
 *   - 0KB JavaScript
 *   - Respects prefers-reduced-motion
 *   - DPR-independent (CSS scales natively)
 *   - Does not trigger layout (position: fixed)
 */
interface Props {
  class?: string;
  dotSize?: number;
  dotColor?: string;
  dotOpacity?: number;
  dotSpacing?: number;
}

const {
  class: className = '',
  dotSize = 1.5,
  dotColor = 'rgba(34, 211, 238, 0.12)',
  dotOpacity = 1,
  dotSpacing = 28,
} = Astro.props;
---

<div class:list={['dotted-bg', className]} aria-hidden="true">
  <div
    class="dotted-bg__surface"
    style={`--dot-size: ${dotSize}px; --dot-color: ${dotColor}; --dot-opacity: ${dotOpacity}; --dot-spacing: ${dotSpacing}px;`}
  ></div>
  <div class="dotted-bg__radial-fade"></div>
</div>

<style>
  .dotted-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .dotted-bg__surface {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(
      var(--dot-color, rgba(34, 211, 238, 0.12)) calc(var(--dot-size, 1.5px) * 0.5),
      transparent calc(var(--dot-size, 1.5px) * 0.5)
    );
    background-size: var(--dot-spacing, 28px) var(--dot-spacing, 28px);
    opacity: var(--dot-opacity, 1);
  }

  /* Radial fade mask so dots are prominent in center, fade at edges */
  .dotted-bg__radial-fade {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 60% at center,
      transparent 0%,
      transparent 40%,
      var(--bg, #060914) 100%
    );
  }

  /* Mobile: increase spacing 1.3x for performance */
  @media (max-width: 768px) {
    .dotted-bg__surface {
      background-size: calc(var(--dot-spacing, 28px) * 1.3) calc(var(--dot-spacing, 28px) * 1.3);
    }
  }

  /* Very small screens: increase spacing 1.5x */
  @media (max-width: 480px) {
    .dotted-bg__surface {
      background-size: calc(var(--dot-spacing, 28px) * 1.5) calc(var(--dot-spacing, 28px) * 1.5);
    }
  }

  /* Disable animation on mobile and reduced-motion */
  @media (prefers-reduced-motion: reduce),
         (max-width: 768px) {
    .dotted-bg__surface {
      animation: none !important;
    }
  }

  /* Subtle drift animation for capable devices only */
  @media (prefers-reduced-motion: no-preference) and (min-width: 769px) {
    .dotted-bg__surface {
      animation: dotted-drift 60s linear infinite;
    }
  }

  @keyframes dotted-drift {
    0% { background-position: 0 0; }
    25% { background-position: 7px 14px; }
    50% { background-position: 28px 7px; }
    75% { background-position: 14px 0; }
    100% { background-position: 0 0; }
  }
</style>