---
  /**
   * DottedBackground.astro
   * ─────────────────────────────────────────────────────
   * Faithful production-safe adaptation of the
   * 21st.dev "efferd/dotted-surface" reference.
   *
   * Architecture: Pure CSS dual-layer dotted surface.
   *   - Layer 1: Fine dot grid (subtle texture, brand-tinted)
   *   - Layer 2: Coarse dot grid (depth, larger spacing)
   *   - Radial fade masks (top + bottom vignettes)
   *   - Ambient color wash (cyan/teal/indigo, very low alpha)
   *   - GPU-accelerated drift (desktop, no-preference only)
   *
   * Performance:
   *   - 0KB JavaScript
   *   - Respects prefers-reduced-motion (static)
   *   - Mobile: single layer + wider spacing (fewer repaints)
   *   - DPR-independent (CSS scales natively)
   *   - position: fixed → zero layout cost
   *   - content-visibility friendly
   *
   * Accessibility:
   *   - aria-hidden, purely decorative
   *   - Never impacts text contrast (stays behind content z-index)
   */
  interface Props {
    class?: string;
    /** Fine dot color */
    dotColor?: string;
    /** Coarse dot color (depth layer) */
    dotColorCoarse?: string;
    /** Overall opacity multiplier */
    intensity?: number;
  }

  const {
    class: className = '',
    dotColor = 'rgba(34, 211, 238, 0.14)',
    dotColorCoarse = 'rgba(129, 140, 248, 0.06)',
    intensity = 1,
  } = Astro.props;
---

<div class:list={['dotted-bg', className]} aria-hidden="true">
  {/* Ambient color wash — sets the mood without overpowering */}
  <div class="dotted-bg__ambient"></div>

  {/* Layer 1 — Fine dot grid (primary surface texture) */}
  <div
    class="dotted-bg__layer dotted-bg__layer--fine"
    style={`--dot-color: ${dotColor}; --dot-intensity: ${intensity};`}
  ></div>

  {/* Layer 2 — Coarse dot grid (depth, parallax-like offset) */}
  <div
    class="dotted-bg__layer dotted-bg__layer--coarse"
    style={`--dot-color: ${dotColorCoarse}; --dot-intensity: ${intensity};`}
  ></div>

  {/* Radial fade — dots prominent in vertical center, fade at edges */}
  <div class="dotted-bg__fade"></div>

  {/* Top + bottom anchor gradients — content legibility insurance */}
  <div class="dotted-bg__anchor dotted-bg__anchor--top"></div>
  <div class="dotted-bg__anchor dotted-bg__anchor--bottom"></div>
</div>

<style>
  .dotted-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  /* ─── Ambient color wash ─── */
  .dotted-bg__ambient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px 520px at 78% -8%, rgba(34, 211, 238, 0.10), transparent 62%),
      radial-gradient(760px 440px at 8% 22%, rgba(20, 184, 166, 0.06), transparent 58%),
      radial-gradient(620px 380px at 92% 88%, rgba(129, 140, 248, 0.05), transparent 60%);
    opacity: calc(0.9 * var(--dot-intensity, 1));
  }

  /* ─── Dot layers ─── */
  .dotted-bg__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: var(--dot-intensity, 1);
  }

  /* Fine layer — dense small dots */
  .dotted-bg__layer--fine {
    background-image: radial-gradient(
      var(--dot-color, rgba(34, 211, 238, 0.14)) 0.75px,
      transparent 0.75px
    );
    background-size: 26px 26px;
    background-position: 0 0;
  }

  /* Coarse layer — larger sparse dots for depth */
  .dotted-bg__layer--coarse {
    background-image: radial-gradient(
      var(--dot-color, rgba(129, 140, 248, 0.06)) 1.5px,
      transparent 1.5px
    );
    background-size: 72px 72px;
    background-position: 13px 13px;
    opacity: calc(0.7 * var(--dot-intensity, 1));
  }

  /* ─── Radial fade mask ─── */
  .dotted-bg__fade {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 85% 65% at 50% 45%,
      transparent 0%,
      transparent 38%,
      rgba(6, 9, 20, 0.4) 75%,
      rgba(6, 9, 20, 0.85) 100%
    );
  }

  /* ─── Anchor gradients (top/bottom legibility) ─── */
  .dotted-bg__anchor {
    position: absolute;
    inset-inline: 0;
    height: 280px;
    pointer-events: none;
  }
  .dotted-bg__anchor--top {
    top: 0;
    background: linear-gradient(180deg, rgba(4, 7, 17, 0.5), transparent);
  }
  .dotted-bg__anchor--bottom {
    bottom: 0;
    background: linear-gradient(0deg, rgba(4, 7, 17, 0.5), transparent);
  }

  /* ─── Mobile: single layer + wider spacing (perf) ─── */
  @media (max-width: 768px) {
    .dotted-bg__layer--fine {
      background-size: 34px 34px;
    }
    /* Hide coarse layer on mobile — fewer layers = smoother */
    .dotted-bg__layer--coarse {
      display: none;
    }
    .dotted-bg__ambient {
      opacity: calc(0.7 * var(--dot-intensity, 1));
    }
  }

  @media (max-width: 480px) {
    .dotted-bg__layer--fine {
      background-size: 42px 42px;
    }
  }

  /* ─── Drift animation (desktop, no-preference only) ─── */
  @media (prefers-reduced-motion: no-preference) and (min-width: 769px) {
    .dotted-bg__layer--fine {
      animation: dotted-drift-fine 80s linear infinite;
    }
    .dotted-bg__layer--coarse {
      animation: dotted-drift-coarse 120s linear infinite;
    }
  }

  @keyframes dotted-drift-fine {
    0%   { background-position: 0 0; }
    25%  { background-position: 6.5px 13px; }
    50%  { background-position: 26px 6.5px; }
    75%  { background-position: 13px 0; }
    100% { background-position: 0 0; }
  }

@keyframes dotted-drift-coarse {
    0%   { background-position: 13px 13px; }
    33%  { background-position: -18px 36px; }
    66%  { background-position: 36px -18px; }
    100% { background-position: 13px 13px; }
  }

  /* ─── Reduced motion: static, no animation ─── */
  @media (prefers-reduced-motion: reduce) {
    .dotted-bg__layer--fine,
    .dotted-bg__layer--coarse {
      animation: none !important;
    }
  }
</style>
