---
/**
 * DocsRelatedLinks — Related docs cards (canonical .docs-related style).
 *
 * Renders a grid of related-doc cards below the main content.
 * Wrapped in a section header to match the visual rhythm of other
 * content-page footers (related posts, internal links grid).
 */
interface RelatedDoc {
  slug: string;
  title: string;
  description: string;
}

interface Props {
  docs: RelatedDoc[];
}

const { docs } = Astro.props;
---

{docs.length > 0 && (
  <section class="docs-related">
    <p class="docs-related__label">ذات صلة</p>
    <h2 id="docs-related-title">وثائق مرتبطة</h2>
    <div class="docs-related__grid">
      {docs.map((doc) => (
        <a class="docs-related__card" href={`/docs/${doc.slug}/`}>
          <h3>{doc.title}</h3>
          <p>{doc.description}</p>
        </a>
      ))}
    </div>
  </section>
)}
