---
/**
 * EvidenceFileMockup — Evidence records table → cards on mobile.
 * Static HTML, no JS required. Demo data only.
 */
import { evidenceRecords, riskLevelClass, riskLevelLabel } from '../data/kernel';
import type { EvidenceRecord } from '../data/kernel';

interface Props { records?: EvidenceRecord[] }
const { records = evidenceRecords } = Astro.props;
---

<style>
  .k-evidence-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .k-evidence-table th {
    text-align: right;
    padding: 0.75rem 1rem;
    color: var(--fg-muted, #94a3b8);
    font-weight: 500;
    border-bottom: 1px solid var(--border, rgba(255,255,255,0.08));
    white-space: nowrap;
  }
  .k-evidence-table td {
    padding: 0.75rem 1rem;
    color: var(--fg, #e2e8f0);
    border-bottom: 1px solid var(--border, rgba(255,255,255,0.05));
    vertical-align: top;
  }
  .k-evidence-table .k-risk-badge {
    display: inline-block;
    font-size: 0.6875rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-weight: 500;
  }
  .k-risk--minimal .k-risk-badge { background: rgba(34,197,94,0.15); color: #22c55e; }
  .k-risk--low .k-risk-badge { background: rgba(59,130,246,0.15); color: #3b82f6; }
  .k-risk--medium .k-risk-badge { background: rgba(245,158,11,0.15); color: #f59e0b; }
  .k-risk--high .k-risk-badge { background: rgba(239,68,68,0.15); color: #ef4444; }
  .k-risk--critical .k-risk-badge { background: rgba(220,38,38,0.15); color: #dc2626; }

  /* Mobile cards */
  .k-evidence-cards { display: none; }
  .k-evidence-card {
    background: var(--card-bg, rgba(255,255,255,0.03));
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 0.75rem;
  }
  .k-evidence-card__row {
    display: flex;
    justify-content: space-between;
    padding: 0.25rem 0;
    font-size: 0.8125rem;
  }
  .k-evidence-card__label { color: var(--fg-muted, #94a3b8); }
  .k-evidence-card__value { color: var(--fg, #e2e8f0); font-weight: 500; }

  @media (max-width: 768px) {
    .k-evidence-table { display: none; }
    .k-evidence-cards { display: block; }
  }
</style>

<!-- Desktop table -->
<table class="k-evidence-table" aria-label="سجل الأدلة">
  <thead>
    <tr>
      <th scope="col">المعرّف</th>
      <th scope="col">الاستعلام</th>
      <th scope="col">الحالة</th>
      <th scope="col">المخاطر</th>
      <th scope="col">الدرجة</th>
      <th scope="col">التاريخ</th>
      <th scope="col">البصمة</th>
    </tr>
  </thead>
  <tbody>
    {records.map(r => (
      <tr class={riskLevelClass(r.riskLevel)}>
        <td>{r.id}</td>
        <td>{r.query}</td>
        <td>{r.status}</td>
        <td><span class="k-risk-badge">{riskLevelLabel(r.riskLevel)}</span></td>
        <td>{r.riskScore}/100</td>
        <td><time>{r.createdAt}</time></td>
        <td dir="ltr" style="font-size:0.6875rem;color:var(--fg-muted,#94a3b8)">{r.hash}</td>
      </tr>
    ))}
  </tbody>
</table>

<!-- Mobile cards -->
<div class="k-evidence-cards" aria-label="سجل الأدلة">
  {records.map(r => (
    <article class={`k-evidence-card ${riskLevelClass(r.riskLevel)}`}>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">المعرّف</span>
        <span class="k-evidence-card__value">{r.id}</span>
      </div>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">الاستعلام</span>
        <span class="k-evidence-card__value">{r.query}</span>
      </div>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">الحالة</span>
        <span class="k-evidence-card__value">{r.status}</span>
      </div>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">المخاطر</span>
        <span class="k-risk-badge">{riskLevelLabel(r.riskLevel)} ({r.riskScore}/100)</span>
      </div>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">التاريخ</span>
        <time class="k-evidence-card__value">{r.createdAt}</time>
      </div>
      {r.demo && <span style="font-size:0.625rem;color:var(--fg-muted,#94a3b8);background:rgba(255,255,255,0.05);border-radius:0.25rem;padding:0.125rem 0.375rem;display:inline-block;margin-top:0.5rem">بيانات توضيحية</span>}
    </article>
  ))}
</div>