/**
 * BrightAI — Astro Content Collections Configuration
 *
 * REPORT-BLOG-2026-07-07:
 *   Single source of truth for content collections (blog + docs).
 *
 *   The blog schema is intentionally permissive at the zod-layer (every
 *   new field is `.optional()`). Five-category enum + draft + tags
 *   validation lives in `entryToPost()` in src/data/blog.ts. This works
 *   around Astro 6.4.6 + zod v3.25 known parser crashes on stricter schemas
 *   during prerendering.
 *
 *   `BLOG_CATEGORIES` is re-exported as the canonical TS enum.
 */
import { defineCollection } from 'astro:content';
import { glob } from 'astro/loaders';
import { z } from 'astro/zod';

/** 5-category enum required by the brief. Order matches the prompt. */
export const BLOG_CATEGORIES: readonly string[] = [
  'ذكاء-اصطناعي',
  'رؤية-2030',
  'تحول-رقمي',
  'دراسات-حالة',
  'أمن-البيانات',
];
export type BlogCategory = 'ذكاء-اصطناعي' | 'رؤية-2030' | 'تحول-رقمي' | 'دراسات-حالة' | 'أمن-البيانات';

const blog = defineCollection({
  loader: glob({ pattern: '**/*.md', base: './src/content/blog' }),
  schema: z.object({
    title: z.string(),
    description: z.string(),
    canonical: z.string().url(),
    pubDate: z.string(),
    updatedDate: z.string().optional(),
    slug: z.string(),
    author: z.string().optional(),
    readingTime: z.number().optional(),
    category: z.string().optional(),
    tags: z.array(z.string()).optional(),
    image: z.string().optional(),
    draft: z.boolean().optional(),
  }),
});

export const collections = { blog };
