/**
 * BrightAI — Astro Content Collections Configuration
 *
 * Single source of truth for content collections (blog + docs).
 *
 * Why this file lives at `src/content.config.ts` (root, not inside `src/content/`):
 *   - Astro 6 enforces the import path `import { collections } from 'astro:content'`
 *     which resolves against `<project>/src/`. The recommended location for the
 *     schema is `src/content.config.ts` (sibling to `src/content/`).
 *   - `src/content/config.ts` is a tiny re-export shim kept only so existing
 *     imports (and grep-using tooling) continue to resolve to the same module.
 *
 * BLOG SCHEMA NOTES (REPORT-BLOG-2026-07-07):
 *   - 5-category enum (replaces the 6-category list previously stored in
 *     src/data/blog.ts). Migrated mapping:
 *       ذكاء-اصطناعي      ← حوكمة الذكاء الاصطناعي, منصات وأدوات (الحوكمة كمنتج)
 *       رؤية-2030          ← رؤية 2030 (1:1)
 *       تحول-رقمي          ← إطار تحوّل (ISO 42001, AI Audit Trail, AI Compliance Path)
 *       دراسات-حالة         ← قطاعات (Health, Banking)
 *       أمن-البيانات        ← الأمن والسلامة, الامتثال والأنظمة (PDPL/NCA/SDAIA/Customer Data)
 *   - `draft` defaults to `false` so absent flag = publish (matches `entries
 *     filtered in {@link getPublishedPosts}`).
 *   - `updatedDate` is optional. When absent, treat `pubDate` as the
 *     modification timestamp for JSON-LD `dateModified`.
 *   - `author` defaults to "فريق BrightAI" so future guest posts can omit it.
 *
 * PRESERVATION:
 *   - All existing `title`, `description`, `canonical`, `slug`, `pubDate`
 *     fields remain required. Existing frontmatter is migrated in-place —
 *     the canonical URL, title and meta description stay bit-identical to
 *     what is already indexed in Google.
 */
import { defineCollection } from 'astro:content';
import { glob } from 'astro/loaders';
import { z } from 'astro/zod';

const docs = defineCollection({
  loader: glob({ pattern: '**/*.{md,mdx}', base: './src/content/docs' }),
  schema: z.object({
    title: z.string(),
    metaTitle: z.string(),
    description: z.string(),
    canonical: z.string().url(),
    updated: z.coerce.date(),
    category: z.enum(['Kernel', 'PDPL', 'NCA', 'SDAIA', 'General']),
    tldr: z.string(),
    related: z.array(z.string()),
  }),
});

/**
 * BLOG — 5 categories required by the brief.
 *
 * Order matters for the in-page filter UI (left → right). Kept in the
 * same order as in the user prompt.
 */
export const BLOG_CATEGORIES = [
  'ذكاء-اصطناعي',
  'رؤية-2030',
  'تحول-رقمي',
  'دراسات-حالة',
  'أمن-البيانات',
] as const;
export type BlogCategory = typeof BLOG_CATEGORIES[number];

const blog = defineCollection({
  loader: glob({ pattern: '**/*.md', base: './src/content/blog' }),
  schema: z.object({
    title: z.string(),
    /** Optional override used by BlogLayout when SEO needs a shorter title. */
    metaTitle: z.string().optional(),
    description: z.string(),
    canonical: z.string().url(),
    /** ISO 8601 date (YYYY-MM-DD). Stored as string for migration compatibility. */
    pubDate: z.string(),
    /** ISO 8601 date. Optional — falls back to pubDate in the page template. */
    updatedDate: z.string().optional(),
    /** Slug used to build `/blog/<slug>/`. Independent from the filename. */
    slug: z.string(),
    /** Author key (currently only `nasser-alabdullah`). Defaults to the team. */
    author: z.string().default('فريق BrightAI'),
    /** One of the 5 categories required by the brief (enum above). */
    category: z.enum(BLOG_CATEGORIES),
    /** Free-form tags rendered as chip filters. Defaults to empty array. */
    tags: z.array(z.string()).default([]),
    /** Optional hero image. Falls back to og:image if absent. */
    image: z.string().optional(),
    /** When true the post is excluded from listings + RSS. */
    draft: z.boolean().default(false),
    /** Reading time in minutes (used by the article hero meta). */
    readingTime: z.number().int().positive().default(5),
  }),
});

export const collections = { docs, blog };
