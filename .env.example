# BrightAI server environment example. Keep real secrets in hosting/server env only.

NODE_ENV=development
PORT=3000

# AI provider keys. Leave blank here; never commit real keys.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# NVIDIA kernel proxy configuration.
NVIDIA_MODEL=minimaxai/minimax-m2.7
NVIDIA_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENDPOINT=
NVIDIA_REGION=global
NVIDIA_DATA_RESIDENCY=NVIDIA configured region
NVIDIA_KERNEL_TIMEOUT_MS=30000

# Optional gateway controls.
AI_GATEWAY_TIMEOUT_MS=30000
AI_GATEWAY_MOCK_MODE=0
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_BODY_BYTES=10240
OCR_MAX_BODY_BYTES=8388608
MAX_UPLOAD_BODY_BYTES=41943040

# Optional analytics.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
ANALYTICS_WEBHOOK_KEY=
